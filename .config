# curl -s "https://access.redhat.com/articles/3078" | w3m -T text/html -dump | grep RHEL

function failed {
  # Step 2: "failed" must never exit 0. $? is captured first, because any
  # other command (even a test) would overwrite it; callers normally run
  # "error" just before, so $? is usually 0 and ERROR_CODE is preferred.
  local LAST_STATUS=$?
  local EXIT_CODE="${ERROR_CODE:-}"
  if [[ ! ${EXIT_CODE} =~ ^[0-9]+$ ]] || [ "${EXIT_CODE}" -eq 0 ]
  then
    EXIT_CODE="${LAST_STATUS}"
  fi
  if [ "${EXIT_CODE}" -eq 0 ]
  then
    EXIT_CODE="1"
  fi
  set +o errtrace
  set +o xtrace
  error "EXIT code: ${YELLOW}${EXIT_CODE}${RED} in ${YELLOW}${BASH_SOURCE[1]}${RED} (function ${YELLOW}${FUNCNAME[1]:-main}${RED}) at about ${YELLOW}${BASH_LINENO[0]}${RED}"
  # log_tmp_maintenance 
  exit "${EXIT_CODE}"
}

# https://f-hauri.ch/vrac/hsvrgb/hsvRgb.html
# (C) 2018-2020 Felix Hauri - felix@f-hauri.ch
# Licensed under terms of GPL v3. www.gnu.org
# There are 2 functions:
#    hsv <red> <green> <blue> <varname>
#             to compute Hue, Saturation and Value from Red, Green and Blue,
#             then store result in Varname array
#    rgb <hue> <saturation> <value> <varname>
#             to compute Red, Green and Blue from Hue, Saturation and Value,
#             then store result in Varname array
# Values: Red, Green, Blue and Value are positive integer <256: [0..255]
# value Hue is a positive integer < 360 and
# value Saturation is a (pseudo) floating between 0.0 and 1.0.
hsv() {
    local -n _result=$4
    local -i _hsv_min _hsv_t
    local _hsv_s
    local -i _hsv_max=" $1 > $2 ?
                (_hsv_min=($2 > $3 ? $3:$2 ), ( $1 > $3 ? $1 : $3 )) :
                (_hsv_min=($1 > $3 ? $3:$1 ), $2) > $3 ? $2 : $3 "
    case $_hsv_max in 
        $_hsv_min) _hsv_t=0 ;;
        $1) _hsv_t=" ( 60 * ( $2 - $3 ) / ( _hsv_max-_hsv_min )+ 360 )%360";;
        $2) _hsv_t=" 60 * ( $3 - $1 ) / ( _hsv_max-_hsv_min )+ 120 " ;;
        $3) _hsv_t=" 60 * ( $1 - $2 ) / ( _hsv_max-_hsv_min )+ 240 " ;;
    esac
    _hsv_s=0000000$(( _hsv_max==0?0 : 100000000-100000000*_hsv_min / _hsv_max ))
    printf -v _hsv_s %.7f ${_hsv_s::-8}.${_hsv_s: -8}
    _result=($_hsv_t $_hsv_s $_hsv_max)
}

rgb() {
    local -n _result=$4
    local -i _rgb_i=" (($1%360)/60)%6 "
    local -i _rgb_f=" 100000000*($1%360)/60-_rgb_i*100000000 "
    local _rgb_s
    printf -v _rgb_s %.8f "$2"
    _rgb_s=$((10#${_rgb_s/.}))
    local -i _rgb_l=" $3*(100000000-_rgb_s)/100000000 "
    case $_rgb_i in
        0 )
            local -i _rgb_n="$3*(100000000-(100000000-_rgb_f)*_rgb_s/100000000)/
                                100000000 "
            _result=("$3" "$_rgb_n" "$_rgb_l") ;;
        1 )
            local -i _rgb_m=" $3*(100000000-_rgb_f*_rgb_s/100000000)/100000000 "
            _result=("$_rgb_m" "$3" "$_rgb_l") ;;
        2 )
            local -i _rgb_n="$3*(100000000-(100000000-_rgb_f)*_rgb_s/100000000)/
                                100000000 "
            _result=("$_rgb_l" "$3" "$_rgb_n") ;;
        3 )
            local -i _rgb_m=" $3*(100000000-_rgb_f*_rgb_s/100000000)/100000000 "
            _result=("$_rgb_l" "$_rgb_m" "$3") ;;
        4 )
            local -i _rgb_n="$3*(100000000-(100000000-_rgb_f)*_rgb_s/100000000)/
                                100000000 "
            _result=("$_rgb_n" "$_rgb_l" "$3") ;;
        * )
            local -i _rgb_m=" $3*(100000000-_rgb_f*_rgb_s/100000000)/100000000 "
            _result=("$3" "$_rgb_l" "$_rgb_m") ;;
    esac
  }

cursor_position()
{
  [[ -t 0 ]] || return
  >&0 IFS=';' read -rsdR -p $'\e[6n' zY zX
  printf '%s %s' "%zX" "${zY:2}"
  }

function ProgressBar()
{
  let PROGRESS=$(echo "((${1}*100)/(${2}*100))/100" | bc)
  let DONE=$(((PROGRESS*8)/10))
  let LEFT=$((80-DONE))
  FILL=$(printf "%${DONE}s")
  EMPTY=$(printf "%${LEFT}s")
  printf "\r${BLUE}${datestring} $(basename $0) [${HOSTNAME} ${ENV} $(git_branch)${BLUE}] PROGRS: [${LIME}${FILL// /▊}${EMPTY// /-}${BLUE}] ${WINE}${PROGRESS}%%"
  }

function waiting() 
{
  let PROGRESS=$(echo "((${1}*100)/(${2}*100))/100" | bc)
  let DONE=$(((PROGRESS*8)/10))
  let LEFT=$((80-DONE))
  FILL=$(printf "%${DONE}s")
  EMPTY=$(printf "%${LEFT}s")
  printf "\r${BLUE}${datestring} $(basename $0) [${HOSTNAME} ${ENV} $(git_branch)${BLUE}] PROGRS: [${ORANGE}${FILL// /▊}${EMPTY// /-}${BLUE}] ${WINE}${PROGRESS}sec  "
  }

tmpfs_creating()
{
  sudo mount -t tmpfs -o size=5G,noatime,nodiratime,inode64 tmpfs /mount-point
  }

ramdisk_creating()
{
  if [[ "${OSTYPE}" =~ "darwin" ]]
  then
    RAMDISK_SIZE_IN_MB=2048
    RAMDISK_NAME="pyenv"
    RAMDISK_DEV=$(diskutil list | grep ${RAMDISK_NAME} | awk '{print $NF}')
    if [ -z ${RAMDISK_DEV} ]
    then
      inf "  Creating RAMdisk (name: ${RAMDISK_NAME}, size: $((RAMDISK_SIZE_IN_MB*2048))[MB]) on macOS"
      diskutil partitionDisk $(hdiutil attach -nomount ram://$((2048*RAMDISK_SIZE_IN_MB))) 1 GPT APFS ${RAMDISK_NAME} '100%'
      ERROR_CODE="$?"
      RAMDISK_DEV=$(diskutil list | grep ${RAMDISK_NAME} | awk '{print $NF}')
    fi
    RAMDISK_MOUNTPOINT=$(df -hT | grep ${RAMDISK_NAME} | awk '{print $NF}')
    if [ ! -d "${HOME}/.${RAMDISK_NAME}" ]
    then
      mkdir -p "${HOME}/.${RAMDISK_NAME}"
    fi
    if [ -z ${RAMDISK_MOUNTPOINT} ]
    then
      diskutil mount -mountPoint "${HOME}/.${RAMDISK_NAME}" /dev/${RAMDISK_DEV}
    elif [[ "${RAMDISK_MOUNTPOINT}" != "${HOME}/.${RAMDISK_NAME}" ]]
    then
      umount "${RAMDISK_MOUNTPOINT}"
      ERROR_CODE="$?"
      diskutil mount -mountPoint "${HOME}/.${RAMDISK_NAME}" /dev/${RAMDISK_DEV}
    fi
  fi
  }

ramdisk_destroying()
{
  if [[ "${OSTYPE}" =~ "darwin" ]]
  then
    RAMDISK_NAME="pyenv"
    RAMDISK_DEV=$(diskutil list | grep ${RAMDISK_NAME} | awk '{print $NF}')
    RAMDISK_MOUNTPOINT=$(df -hT | grep ${RAMDISK_NAME} | awk '{print $NF}')
    if [ ! -z ${RAMDISK_MOUNTPOINT} ]
    then
      umount ${RAMDISK_MOUNTPOINT}
    fi
    if [ ! -z ${RAMDISK_DEV} ]
    then
      diskutil eject ${RAMDISK_DEV}
    fi
  fi
  }

variable_helper()
{
  if type pwgen > /dev/null 2>&1
  then
    pwgen --numerals --num-passwords=1 --capitalize 20 | awk '{print toupper($0)}'
  fi
  }

python_modules_venv()
{
  if [[ ${VERBOSE} == yes ]]
  then
    debug "          update module: ${LIGHT_MAGENTA}pip"
  fi
  pip3 --require-virtualenv install --upgrade pip > "${LOG}/installation_verv_pip_${CURRENT_TIMESTAMP}.log" 2>&1
  PYTHON_MODULES=(coloredlogs urllib3 netaddr colorama termcolor joblib git-changelog xlsxwriter numpy matplotlib seaborn fitter csvkit azure-cli sphinx atsphinx-color-text pygments config)
  for PYTHON_MODULE in "${PYTHON_MODULES[@]}"
  do
    if [[ ${VERBOSE} == yes ]]
    then
      debug "            installation module: ${LIGHT_MAGENTA}${PYTHON_MODULE}"
    fi
    pip3 --require-virtualenv install ${PYTHON_MODULE} > "${LOG}/installation_verv_${PYTHON_MODULE}_${CURRENT_TIMESTAMP}.log" 2>&1
    EXIT_CODE="$?"
    if [ ${EXIT_CODE} -ne 0 ]
    then
      warn "              installation of: ${LIGHT_MAGENTA}${PYTHON_MODULE}${WINE} failed, EXIT_CODE=${EXIT_CODE}, LOG_FILE=${BLUE}${LOG}/installation_verv_${PYTHON_MODULE}_${CURRENT_TIMESTAMP}.log"
    fi
  done
  }

python_virtenv()
{
  inf "preparation of python3 virtenv"
  # debug "  checking if GIL is emabled: ${WINE}$(python3 -c 'import sys; print(sys._is_gil_enabled())')"
  python3 -m venv "${HOME}/report_venv" > "${LOG}/venv_installation.log" 2>&1
  source "${HOME}/report_venv/bin/activate" >> "${LOG}/venv_installation.log" 2>&1
  python_modules_venv
  }

python_full_venv()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}[os/latest/pypy]"
    ERROR_CODE="1"
    failed
  else
    PVENV_DEPLOY="${1}"
  fi
  EXIT_CODE=""
  # ramdisk_creating
  start_time_collecting
  if [ -d "${HOME}/.pyenv" ] && [ -f "${HOME}/.pyenv/libexec/pyenv" ]
  then
    inf "Checking pyenv ..."
    "${HOME}/.pyenv/bin/pyenv" doctor > "${LOG}/pyenv_health_${CURRENT_TIMESTAMP}.log" 2>&1
    EXIT_CODE="$?"
    if [[ ${VERBOSE} == yes ]]
    then
      debug "  Updating pyenv..."
    fi
    "${HOME}/.pyenv/bin/pyenv" update > "${LOG}/pyenv_update_${CURRENT_TIMESTAMP}.log" 2>&1
    EXIT_CODE="$?"
  else
    inf "Installation pyenv:"
    if [ -f "${SCRIPTS_HOME}/pyenv-installer" ]
    then
      rm -rf "${SCRIPTS_HOME}/pyenv-installer"
    fi
    wget --quiet "https://raw.githubusercontent.com/pyenv/pyenv-installer/master/bin/pyenv-installer"
    sed -i.bak "0,/exit 1/{//d;}" "${SCRIPTS_HOME}/pyenv-installer"
    #sed -i.bak "29d" "${SCRIPTS_HOME}/pyenv-installer"
    source "${SCRIPTS_HOME}/pyenv-installer" > "${LOG}/installation_pyenv_${CURRENT_TIMESTAMP}.log" 2>&1
    EXIT_CODE="$?"
    if [ ${EXIT_CODE} -ne 0 ]
    then
      error "  Something wrong happened, log: ${BLUE}${LOG}/installation_pyenv_${CURRENT_TIMESTAMP}.log"
      exit ${EXIT_CODE}
    fi
  fi
  if [ -d "${HOME}/.pyenv/bin" ]
  then
    export PYENV_ROOT="${HOME}/.pyenv"
    export PATH="${PYENV_ROOT}/bin:${PATH}"
    if [[ ${VERBOSE} == yes ]]
    then
      debug "  Initialization pyenv"
    fi
    eval "$(pyenv init - bash)"
  else
    error "  Something wrong happened, log: ${BLUE}${LOG}/installation_pyenv_${CURRENT_TIMESTAMP}.log"
    failed
  fi

  if [ ! -d "$(pyenv root)/plugins/pyenv-virtualenv" ]
  then
    git clone https://github.com/pyenv/pyenv-virtualenv.git $(pyenv root)/plugins/pyenv-virtualenv >> "${LOG}/installation_pyenv_${CURRENT_TIMESTAMP}.log" 2>&1
  fi

  if [[ ${PVENV_DEPLOY} == os ]]
  then
    export PYTHON_GIL="1"
    export PYTHON_JIT="1"
    PYENV_VIRTENV_NAME="venv_os"
    if [ -d "${HOME}/.pyenv/versions/${PYENV_VIRTENV_NAME}" ]
    then
      if [[ ${DEBUG} == yes ]]
      then
        debug "    python venv: ${BROWN}${PYENV_VIRTENV_NAME}${BLUE} exists"
      fi
    else
      if [[ ${VERBOSE} == yes ]]
      then
        debug "    creating python venv: ${BROWN}${PYENV_VIRTENV_NAME}"
      fi
      pyenv virtualenv ${PYENV_VIRTENV_NAME} > "${LOG}/creating_venv_${CURRENT_TIMESTAMP}.log" 2>&1
    fi
    if [[ ${DEBUG} == yes ]]
    then
      debug "      listing existing python envs:"
      IFS=${NEWIFS}
      for PVENVS in $(pyenv virtualenvs)
      do
        debug "      ${YELLOW}${PVENVS}"
      done
      IFS=${ORIGIFS}
      debug "    Activation virtualenv ${YELLOW}${PYENV_VIRTENV_NAME}"
    fi
    pyenv activate ${PYENV_VIRTENV_NAME}
  elif [[ ${PVENV_DEPLOY} == pypy ]]
  then
    PYTHON_INSTALL_VER=$(pyenv install --list | grep "^[[:space:]]\+pypy" | tail -n1 | sed "s/^[[:space:]]\+//g")
    if [[ ${DEBUG} == yes ]]
    then
      debug "    latest pypy python version is: ${DARK_GREEN}${PYTHON_INSTALL_VER}"
    fi
    if [ -f "${HOME}/.pyenv/versions/${PYTHON_INSTALL_VER}/bin/python3" ]
    then
      if [[ ${VERBOSE} == yes ]]
      then
        debug "      installation of python-${DARK_GREEN}${PYTHON_INSTALL_VER}${BLUE} is not needed..."
      fi
    else
      if [[ ${VERBOSE} == yes ]]
      then
        debug "      installation of python-${DARK_GREEN}${PYTHON_INSTALL_VER}${BLUE}"
      fi
      # CXX="/usr/bin/g++"
      # --enable-experimental-jit
      CXXFLAGS='-s -O3 -march=native -mtune=native' CPPFLAGS='-s -O3 -march=native -mtune=native' CFLAGS='-s -O3 -march=native -mtune=native' LDFLAGS='-s -O3 -march=native -mtune=native' PYTHON_CONFIGURE_OPTS='--enable-optimizations --with-lto' PROFILE_TASK='-m test.regrtest --pgo -j8' pyenv install -v ${PYTHON_INSTALL_VER} > "${LOG}/building_venv_${CURRENT_TIMESTAMP}.log" 2>&1
    fi
    ERROR_CODE="$?"
    if [ ${ERROR_CODE} -ne 0 ]
    then
      python_virtenv
    fi
    PYENV_VIRTENV_NAME="venv_${PYTHON_INSTALL_VER}"
    if [ -d "${HOME}/.pyenv/versions/${PYTHON_INSTALL_VER}/envs/${PYENV_VIRTENV_NAME}" ]
    then
      if [[ ${DEBUG} == yes ]]
      then
        debug "        python venv: ${BROWN}${PYENV_VIRTENV_NAME}${BLUE} exists"
      fi
    else
      if [[ ${DEBUG} == yes ]]
      then
        debug "        creating python venv: ${BROWN}${PYENV_VIRTENV_NAME}"
      fi
      pyenv virtualenv ${PYTHON_INSTALL_VER} ${PYENV_VIRTENV_NAME} > "${LOG}/installation_pyenv_verv_${CURRENT_TIMESTAMP}.log" 2>&1
    fi
    if [[ ${VERBOSE} == yes ]]
    then
      debug "          activating python venv: ${BROWN}${PYENV_VIRTENV_NAME}"
    fi
    pyenv activate ${PYENV_VIRTENV_NAME}
  elif [[ ${PVENV_DEPLOY} == latest ]]
  then
    PYTHON_INSTALL_VER=$(pyenv install --list | grep "^[[:space:]]\+3\.[1-9]\+\.[0-9]\+*t" | tail -n1 | sed "s/^[[:space:]]\+//g")
    if [[ ${VERBOSE} == yes ]]
    then
      debug "    latest python version is: ${DARK_GREEN}${PYTHON_INSTALL_VER}"
    fi
    if [ -f "${HOME}/.pyenv/versions/${PYTHON_INSTALL_VER}/bin/python3" ]
    then
      if [[ ${DEBUG} == yes ]]
      then
        debug "      installation of python-${DARK_GREEN}${PYTHON_INSTALL_VER}${BLUE} is not needed..."
      fi
    else
      if [[ ${VERBOSE} == yes ]]
      then
        debug "      installation of python-${DARK_GREEN}${PYTHON_INSTALL_VER}${BLUE}"
      fi
      # CXX="/usr/bin/g++"
      # --enable-experimental-jit
      CXXFLAGS='-s -O3 -march=native -mtune=native' CPPFLAGS='-s -O3 -march=native -mtune=native' CFLAGS='-s -O3 -march=native -mtune=native' LDFLAGS='-s -O3 -march=native -mtune=native' PYTHON_CONFIGURE_OPTS='--enable-optimizations --with-lto' PROFILE_TASK='-m test.regrtest --pgo -j8' pyenv install -v ${PYTHON_INSTALL_VER} > "${LOG}/building_venv_${CURRENT_TIMESTAMP}.log" 2>&1
    fi
    ERROR_CODE="$?"
    if [ ${ERROR_CODE} -ne 0 ]
    then
      warn "  ISSUES exist related to installation/building of python..."
      python_virtenv
    fi
    PYENV_VIRTENV_NAME="venv_${PYTHON_INSTALL_VER}"
    if [ -d "${HOME}/.pyenv/versions/${PYTHON_INSTALL_VER}/envs/${PYENV_VIRTENV_NAME}" ]
    then
      if [[ ${DEBUG} == yes ]]
      then
        debug "        python venv: ${BROWN}${PYENV_VIRTENV_NAME}${BLUE} exists"
      fi
    else
      if [[ ${DEBUG} == yes ]]
      then
        debug "        creating python venv: ${BROWN}${PYENV_VIRTENV_NAME}"
      fi
      pyenv virtualenv ${PYTHON_INSTALL_VER} ${PYENV_VIRTENV_NAME} > "${LOG}/installation_pyenv_verv_${CURRENT_TIMESTAMP}.log" 2>&1
    fi
    if [[ ${VERBOSE} == yes ]]
    then
      debug "          activating python venv: ${BROWN}${PYENV_VIRTENV_NAME}"
    fi
    pyenv activate ${PYENV_VIRTENV_NAME}
  fi
  if [[ ${DEBUG} == yes ]]
  then
    debug "      checking:"
    debug "      type python:         ${LIGHT_BLUE}$(type python3)"
    debug "      pyenv which python:  ${LIGHT_BLUE}$(pyenv which python3)"
    debug "      file which python:   ${LIGHT_BLUE}$(file $(pyenv which python3))"
    debug "      file which python:   ${LIGHT_BLUE}$(readlink $(pyenv which python3))"
    debug "        python3 modules installed:"
    PYTHON_IN_USE=$(python3 -c "import platform; print('Python version: ' + str(platform.python_version()))")
    debug "        ${DARK_GREEN}${PYTHON_IN_USE}"
    debug "        ${DARK_GREEN}$(python3 -c "import sys; print('GIL enabled: ' + str(sys._is_gil_enabled()))")"
  fi
  python_modules_venv
  end_time_collecting
  PYTHON_ENV_PREPARATION_TIME=${RUNTIME}
}

excel_report_preparation()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}(1)EXPORT_FILE_NAME"
    ERROR_CODE="1"
    failed
  else
    EXPORT_FILE_F=${1}
  fi
  if [[ ${REPORT} == yes ]]
  then
    export EXTENSION=""
  elif [[ ${METRICS} == yes ]]
  then
    export EXTENSION="_metrics"
  fi
  if [ -s "${SCRIPTS_HOME}/report_conversion.py" ]
  then
    "${SCRIPTS_HOME}/report_conversion.py" "${EXPORT_FILE_F}"
  elif [ -s "${SCRIPTS_HOME}/txt2excel_conversion.py" ]
  then
    "${SCRIPTS_HOME}/txt2excel_conversion.py" "${EXPORT_FILE_F}"
  else
    error "  there is none python script for creating excel sheet..."
    failed
  fi
}

open_spreadsheet()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}(1)EXCEL_FILE"
    ERROR_CODE="1"
    failed
  else
    EXPORT_FILE_F=${1}
  fi

  inf "    Trying to open document: ${ORANGE}${EXPORT_FILE_F}${CYAN}, ${DARK_GREEN}${DOCUMENT_CHKSUM}"
  if [ -s "${TMP}/${EXPORT_FILE_F}" ]
  then
    if type wslview > /dev/null 2>&1
    then
      wslview "${TMP}/${EXPORT_FILE_F}"
    elif [[ "${OSTYPE}" =~ "darwin" ]]
    then
      open "${TMP}/${EXPORT_FILE_F}"
    elif [[ -s "/mnt/c/Program Files/Microsoft Office/root/Office16/EXCEL.EXE" ]]
    then
      "/mnt/c/Program Files/Microsoft Office/root/Office16/EXCEL.EXE" $(wslpath "${TMP}/${EXPORT_FILE_F}")
    else
      inf "      Report is ready here: ${WINE}$(hostname -s):${LIGHT_MAGENTA}${TMP}/${EXPORT_FILE_F}"
    fi
  else
    error "  Something wrong, ${EXPORT_FILE_F} is not present"
  fi
  }

chksum_document()
{
  DOCUMENT_CHKSUM=""
  DOCUMENT_NAME=""
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}(1)DOCUMENT_NAME"
    ERROR_CODE="1"
    failed
  else
    DOCUMENT_NAME=${1}
  fi
  if type sha224 > /dev/null 2>&1
  then
    DOCUMENT_CHKSUM=$(echo SHA224_SUM: "$(sha224 -q "${TMP}/${DOCUMENT_NAME}")")
    export DOCUMENT_CHKSUM
  elif sha1 > /dev/null 2>&1
  then
    DOCUMENT_CHKSUM=$(echo SHA1_SUM: "$(sha1 -q "${TMP}/${DOCUMENT_NAME}")")
    export DOCUMENT_CHKSUM
  fi
  if [[ ${VERBOSE} == yes ]]
  then
    debug "    document: ${DOCUMENT_NAME}, checksum: ${DOCUMENT_CHKSUM}"
  fi
  }

excel_sheet_building()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}(1)EXPORT_FILE"
    ERROR_CODE="1"
    failed
  else
    EXPORT_FILE=${1}
  fi
  python_full_venv latest
  inf "  Preparing excel sheet: ${YELLOW}${EXPORT_FILE}"
  excel_report_preparation ${EXPORT_FILE}
  EXIT_CODE="$?"
  if [ ${EXIT_CODE} -ne 0 ]
  then
    error "    excel sheet: ${YELLOW}${EXPORT_FILE}${RED} cannot be prepared"
    failed
  fi
  }

changelog_update()
{
  if type git-changelog > /dev/null 2>&1
  then
    git-changelog -i -o "${SCRIPTS_HOME}/CHANGELOG.md" -a
  fi
  }

open_pdf()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}(1)DOCUMENT_NAME"
    ERROR_CODE="1"
    failed
  else
    DOCUMENT_NAME=${1}
  fi

  inf "    Trying to open document: ${ORANGE}${DOCUMENT_NAME}${CYAN}, ${DARK_GREEN}${DOCUMENT_CHKSUM}"
  if [ -s "${TMP}/${PDF_FILENAME}.pdf" ]
  then
    if [ -s "/mnt/c/Program Files/Adobe/Acrobat DC/Acrobat/Acrobat.exe" ]
    then
      "/mnt/c/Program Files/Adobe/Acrobat DC/Acrobat/Acrobat.exe" /n /s /o /A "page=11=OpenActions" "$(wslpath -aw "${TMP}/${DOCUMENT_NAME}")" &
      disown
    elif [[ "${OSTYPE}" =~ "darwin" ]]
    then
      open "${TMP}/${DOCUMENT_NAME}" --args -g "page=11"
    else
      inf "      Document is ready here: ${WINE}$(hostname -s):${LIGHT_MAGENTA}${TMP}/${DOCUMENT_NAME}"
    fi
  else
    error "  Something wrong, ${DOCUMENT_NAME} is not present"
  fi
  }

splitting_file_for_parallel()
{
  if [ $# -ne 2 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs two parameters: ${YELLOW}(1)source filename, (2)extension"
    ERROR_CODE="1"
    failed
  else
    SOURCE_FILE="${1}"
    EXTENSION="${2}"
  fi
  SOURCE_FILE_LINES=$(wc -l "${TMP}/${SOURCE_FILE}" | awk '{print $1}')
  SPLIT_FILES=${CPU_COUNT}
  if [ ${SOURCE_FILE_LINES} -le ${SPLIT_FILES} ]
  then
    SPLIT_LINES=1
    SPLIT_FILES=${SOURCE_FILE_LINES}
  else
    SPLIT_LINES=$((SOURCE_FILE_LINES/SPLIT_FILES))
  fi
  if [[ ${VERBOSE} == yes ]]
  then
    debug "  Splitting input file into ${YELLOW}${SPLIT_FILES}${CYAN} chunks, for parallel running"
    debug "   There are ${YELLOW}${SOURCE_FILE_LINES}${BLUE} lines/entries in input file"
    debug "    Each with ${YELLOW}${SPLIT_LINES}${BLUE} lines/entries"
  fi
  split --numeric-suffixes=1 -l ${SPLIT_LINES} -d "${TMP}/${SOURCE_FILE}" --verbose "${TMP}/${SOURCE_FILE}_${EXTENSION}_" > "${LOG}/${SOURCE_FILE}_${EXTENSION}_split.out" 2>"${LOG}/${SOURCE_FILE}_${EXTENSION}_split.log"
}

show_time()
{
  NUM=${1}
  MIN=0
  HOUR=0
  DAY=0
  if((NUM>59))
  then
    ((SEC=NUM%60))
    ((NUM=NUM/60))
    if((NUM>59))
    then
      ((MIN=NUM%60))
      ((NUM=NUM/60))
       if((NUM>23))
       then
         ((HOUR=NUM%24))
         ((DAY=NUM/24))
       else
         ((HOUR=NUM))
       fi
    else
      ((MIN=NUM))
    fi
  else
    ((SEC=NUM))
  fi
  #echo "${DAY}"d "${HOUR}"h "${MIN}"m "${SEC}"s
  echo "${HOUR}:${MIN}:${SEC}"
}

slack_notification()
{
COLLECTEDIFS=${IFS}
IFS=${ORIGIFS}
FUNCTION_NAME=${FUNCNAME[0]}
  if [ $# -ne  7 ]
  then
    error "Function ${YELLOW}${FUNCTION_NAME}${RED} needs seven parameters: ${BLUE}(1)slack channel, (2) slack notification title, (3) slack notificatio text, (4)icon_emoji, (5) slack notification color, (6) footer url, (7) footer link"
    failed
  fi
  SLACK_CHANNEL="${1}"
  SLACK_NOTIFICATION_TITLE="${2}"
  SLACK_NOTIFICATION_TEXT="${3}"
  ICON_EMOJI="${4}"
  SLACK_NOTIFICATION_COLOR="${5}"
  FOOTER_URL="${6}"
  FOOTER_LINK="${7}"
  RANDOM_ID=$(head -n10 /dev/urandom | tr -dc '0-9a-zA-Z' | fold -w 4 | head -n1)
  SLACK_NOTIFICATION_MESSAGE="
    {\\\"channel\\\": \\\"${SLACK_CHANNEL}\\\"
      , \\\"username\\\": \\\"${USER}\\\"
      , \\\"icon_emoji\\\": \\\"${ICON_EMOJI}\\\"
      , \\\"color\\\": \\\"${SLACK_NOTIFICATION_COLOR}\\\"
      , \\\"attachments\\\":
        [
          {
            \\\"fallback\\\": \\\"${SLACK_NOTIFICATION_TEXT}\\\",
            \\\"title\\\": \\\"${SLACK_NOTIFICATION_TITLE}\\\",
            \\\"text\\\": \\\"${SLACK_NOTIFICATION_TEXT}\\\",
            \\\"title_link\\\": \\\"${FOOTER_URL}\\\",
            \\\"footer\\\": \\\"<${FOOTER_URL}|${FOOTER_LINK}>\\\"
          }
        ]
      , \\\"token\\\": \\\"${SLACK_TOKEN}\\\"
    }"
  echo "curl -v -X POST --data \"${SLACK_NOTIFICATION_MESSAGE}\" ${SLACK_WEB_HOOK}" > "${TMP}/slack_notification_${RANDOM_ID}.in"
  source "${TMP}/slack_notification_${RANDOM_ID}.in" > "${LOG}/slack_notification_${RANDOM_ID}.log" 2>&1
  ERROR_CODE=$?
  if [ ${ERROR_CODE} -ne 0 ]
  then
    error "  Status sent to slack channel: ${YELLOW}${SLACK_CHANNEL}${RED} failed"
  else
    inf "  Status sent properly to slack channel: ${YELLOW}${SLACK_CHANNEL}"
  fi
IFS=${COLLECTEDIFS}
sleep 3
}

function_error_handling()
{
  if [ ${ERROR_CODE} -eq 0 ]
  then
    inf "${SUCCESS_MESSAGE}"
  else
    error "${ERROR_INF_MESSAGE}"
    if [[ ${DEBUG} == yes ]]
    then
      debug "      LOG_FILE=${LOG}/${LOG_FILE}"
    fi
    exit ${ERROR_CODE}
  fi
}

log_tmp_maintenance()
{
  if [ $# -eq 1 ]
  then
    S3_BUCKET_NAME=${1}
  fi
  BACKUP_OUTPUT_FILE="${SCRIPT_NAME}_${CURRENT_TIMESTAMP}.tar.xz"
  if [[ ${VERBOSE} == no ]]
  then
    inf "Archiving all logs and tmp files into: ${BROWN}${VAR}/${BACKUP_OUTPUT_FILE}"
    tar -cJf "${VAR}/${BACKUP_OUTPUT_FILE}" -C "${VAR}" ${TMP} ${LOG} > "${VAR}/maintenance_log_tmp.log" 2>&1
    ERROR_CODE="$?"
    if [ ${ERROR_CODE} -eq 0 ]
    then
      rm -rf "${TMP}"
      rm -rf "${LOG}"
      inf "  All tmp and log files has just been archived in: ${YELLOW}${VAR}"
    else
      inf "  I couldn't archive tmp and log files"
    fi
  fi
}

kernel_versions()
{
  # rhel 7.9 -> yum --showduplicates list kernel | grep "3.10.0-1160.1[2-3][0-9]" | sed "s/\.x86_64[[:space:]] *3.10/\-3.10/g" | awk '{print $1}'
  # rhel 8.10 -> yum --showduplicates list kernel --repo="rhel-8-for-x86_64-baseos-rhui-rpms" | grep "el8_10" | sed "s/\.x86_64[[:space:]] *4.18/\-4.18/g;s/ rhel.*$//g"
  for RHEL_VERSION in 7.9 8.10 9.x
  do
    if [ -s "${SCRIPTS_HOME}/report_extra/rhel${RHEL_VERSION}_kernels.txt" ]
    then
      LINES=$(wc -l "${SCRIPTS_HOME}/report_extra/rhel${RHEL_VERSION}_kernels.txt" | awk '{print $1}')
      awk -v LINES="${LINES}" '{print $0"~"NR-LINES}' "${SCRIPTS_HOME}/report_extra/rhel${RHEL_VERSION}_kernels.txt" | sed "s/\~\-/\~/g" > "${TMP}/rhel${RHEL_VERSION}_kernels_report.txt"
    else
      if [[ ${RHEL_VERSION} == "8.10" ]]
      then
        KERNEL_PREFIX="kernel-4.18.0"
        curl -s https://raw.repo.almalinux.org/almalinux/${RHEL_VERSION}/BaseOS/x86_64/os/Packages/ | grep "${KERNEL_PREFIX}" | sed "s/^.*>${KERNEL_PREFIX}/${KERNEL_PREFIX}/g;s/<\/a>[[:space:]] */~/g;s/ .*$//g" | grep -vE "${KERNEL_PREFIX}-553.el8_10|${KERNEL_PREFIX}-553.8.1.el8_10|${KERNEL_PREFIX}-553.5.1.el8_10" | sort -h > "${TMP}/rhel${RHEL_VERSION}_kernels.txt"
      fi
    fi
  done
  for RHEL_VERSION in 7.9 8.10 9.x
  do
    cat "${TMP}/rhel${RHEL_VERSION}_kernels_report.txt" >> "${TMP}/rhel_kernels_report.txt"
  done
  if [ -s "${SCRIPTS_HOME}/report_extra/rhel8.10_kernels_changelog.txt" ] && [ -s "${SCRIPTS_HOME}/report_extra/rhel7.9_kernels_changelog.txt" ] && [ -s "${SCRIPTS_HOME}/report_extra/rhel9.x_kernels_changelog.txt" ]
  then
    paste -d "~" "${SCRIPTS_HOME}/report_extra/rhel7.9_kernels_changelog.txt" "${SCRIPTS_HOME}/report_extra/rhel8.10_kernels_changelog.txt" "${SCRIPTS_HOME}/report_extra/rhel9.x_kernels_changelog.txt" > "${TMP}/${REPORT_FILE6}"
    # cp "${SCRIPTS_HOME}/report_extra/rhel${RHEL_VERSION}_kernels_changelog.txt" "${TMP}/${REPORT_FILE6}"
  else
    RHEL_VERSION="8.10"
    for KERNEL in $(cat "${TMP}/rhel${RHEL_VERSION}_kernels_report.txt")
    do
      THIS_YEAR_KERNELS=$(wc -l "${SCRIPTS_HOME}/report_extra/rhel${RHEL_VERSION}_kernels.txt" | awk '{print $1}')
      COMPARISON_KERNELS=($(grep -A1 ${KERNEL} "${TMP}/rhel${RHEL_VERSION}_kernels_report.txt" | awk -F\~ '{print $1}'))
      COMPARISON_KERNELS_RELEASE=($(grep -A1 ${KERNEL} "${TMP}/rhel${RHEL_VERSION}_kernels_report.txt" | awk -F\~ '{print $2}'))
      COMPARISON_KERNELS_AMOUNT=${#COMPARISON_KERNELS[*]}
      if [ ${COMPARISON_KERNELS_AMOUNT} -eq 2 ]
      then
        NR_COMPARISON_KERNELS=$(grep -n ${COMPARISON_KERNELS[1]} "${TMP}/rhel${RHEL_VERSION}_kernels_report.txt" | awk -F\: '{print $1}')
        AMOUNT_RELEASES_SINCE=$((THIS_YEAR_KERNELS-NR_COMPARISON_KERNELS))
        echo "changelog: ${COMPARISON_KERNELS[1]} (${COMPARISON_KERNELS_RELEASE[1]})" >> "${TMP}/${REPORT_FILE6}"
        diff --strip-trailing-cr  -d <(rpm -q --changelog https://raw.repo.almalinux.org/almalinux/${RHEL_VERSION}/BaseOS/x86_64/os/Packages/${COMPARISON_KERNELS[1]} 2>/dev/null) <(rpm -q --changelog https://raw.repo.almalinux.org/almalinux/${RHEL_VERSION}/BaseOS/x86_64/os/Packages/${COMPARISON_KERNELS[0]} 2>/dev/null) | grep "< -" | sed "s/^< //g;s/ \[RHEL/~\[RHEL/g;s/ {CVE/~{CVE/g" | grep -v "\- s390" >> "${TMP}/${REPORT_FILE6}"
        echo >> "${TMP}/${REPORT_FILE6}"
      fi
    done
  fi
  }

start_time_collecting()
{
  START_TIME=$(date +%s.%4N)
}

end_time_collecting()
{
  END_TIME=$(date +%s.%4N)
  RUNTIME=$(echo "scale=4; x=(${END_TIME} - ${START_TIME}); if(x<1) print 0; x" | bc)
  RUNTIME=$(echo ${RUNTIME}[s])
}

debug "${YELLOW}[ ${LIME}$(echo $(caller | awk '{print $2}') | awk -F\/ '{print $NF}') ${YELLOW}calls (in line: ${LIME}$(caller | awk '{print $1}')${YELLOW}) ${LIME}$(echo "${BASH_SOURCE[0]}" | awk -F\/ '{print $NF}')${YELLOW} ]"

