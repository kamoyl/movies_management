#!/usr/bin/env bash

#Internal Field Separator
ORIGIFS=${IFS}
NEWIFS=$'\n'

# Decimal point for numbers: ffprobe, jq and bc print "60.64", but with
# e.g. nl_NL printf expects "60,64" ("invalid number"); C keeps it a dot
export LC_NUMERIC=C

LIME_YELLOW=$(tput setaf 190)
POWDER_BLUE=$(tput setaf 153)
BRIGHT=$(tput bold)
NORMAL=$(tput sgr0)
BLINK=$(tput blink)
REVERSE=$(tput smso)
UNDERLINE=$(tput smul)
RESET=$(tput sgr0)

WINE=$(echo -e "\x1b[38;2;191;000;000m")
DARK_GREEN=$(echo -e "\x1b[38;2;50;200;100m")
LIGHT_BLUE=$(echo -e "\x1b[38;2;50;250;240m")
LIGHT_YELLOW=$(echo -e "\x1b[38;2;250;250;0m")
LIGHT_MAGENTA=$(echo -e "\x1b[38;2;240;200;240m")
DARK_MAGENTA=$(echo -e "\x1b[38;2;75;66;144m")
DARK_CYAN=$(echo -e "\x1b[38;2;0;139;139m")

if [ -s "${SCRIPTS_HOME}/.config_colours" ]
then
  source "${SCRIPTS_HOME}/.config_colours"
fi

git_branch () { git branch --no-color 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/'; }
export -f git_branch

git_repository () { basename $(git remote -v | grep fetch | awk '{print $2}' | sed 's/\.git//g'); }
export -f git_repository

HOSTNAME="$(hostname -s)"
HOSTNAME_FQDN=$(hostname -f)
RESOLVED_HOST_IP=$(nslookup $(hostname -f) | grep -A2 $(hostname -f) | grep Address: | awk '{print $2}')

DATE=$(date +"done: %m-%d-%Y at time: %H:%M")
NOW=$(date +"%m-%d-%Y at time: %H:%M")
export EXCEL_NOW=$(date "+%Y-%m-%d %H:%M:%S")
NOW_SECONDS=$(date +%s)
CURRENT_YEAR=$(date +%Y)
CURRENT_MONTH=$(date +%m)
export DAY_TODAY=$(date '+%Y-%m-%d')
CURRENT_DAY=$(date +%d)
# a run started as a systemd service (interpolation_nncn -S) gets the launcher's timestamp, so
# the log directory and log file printed by the launcher are the ones the service writes to
export CURRENT_TIMESTAMP="${SERVICE_RUN_TIMESTAMP:-$(date "+%Y.%m.%d-%H.%M.%S")}"
export CURRENT_TIME=$(date '+%Y-%m-%d %H:%M:%S')
export ERROR_CODE_SUM="ERROR_CODE_SUM_${CURRENT_TIMESTAMP}.log"
HISTORY_DAYS="30"
MONTH_SECONDS="2592000"
WEEK_SECONDS="604800"
DAY_SECONDS="86400"
YEAR_QUARTER=$(echo H$(( ($(date +%-m)-1)/3+1))_$(date +%Y))

YESTERDAY=$(date -d "yesterday" '+%Y-%m-%d')
export YESTERDAY
DAY_BEFORE_YESTERDAY=$(date -d '-2 day' '+%Y-%m-%d')
export DAY_BEFORE_YESTERDAY
YESTERDAY_WEEK_NR=$(date -d "${YESTERDAY}" +%V)
export YESTERDAY_WEEK_NR
TODAY=$(date -d "today" '+%Y-%m-%d')
TODAY_WEEK_NR=$(date -d "${TODAY}" +%V)
PREVIOUS_WEEK_DAY=$(date +%Y-%m-%d -d "7 days ago")
PREVIOUS_WEEK_NR=$(date -d "${PREVIOUS_WEEK_DAY}" +%V)
REDHAT_RELEASES_PAGE="https://access.redhat.com/articles/3078"
EXCEL_CHART_MAX_WIDTH="169056"
export AZ_METRICS_EXCEL_CHART_DAY_WIDTH="1100" #1108

## Simple logging mechanism for Bash
##
## Author: Michael Wayne Goodman <goodman.m.w@gmail.com>
## Thanks: Jul for the idea to add a datestring. See:
## http://www.goodmami.org/2011/07/simple-logging-in-bash-scripts/#comment-5854
## Thanks: @gffhcks for noting that inf() and debug() should be swapped,
##         and that critical() used $2 instead of $1
##
## License: Public domain; do as you wish
##
exec 3>&2 # logging stream (file descriptor 3) defaults to STDERR
verbosity=5 # default to show warnings
silent_lvl=0
crt_lvl=1
err_lvl=2
wrn_lvl=3
inf_lvl=4
dbg_lvl=5

dry_run() { log ${silent_lvl} "${LIGHT_YELLOW}COMM: $1${BLUE}"; } # Always prints
notify() { log ${silent_lvl} "${WHITE}NOTE: $1${BLUE}"; } # Always prints
critical() { log ${crt_lvl} "${BRIGHT}${RED}CRIT: $1${NORMAL}${BLUE}"; }
error() { log ${err_lvl} "${RED}ERRO: $1${BLUE}"; }
warn() { log ${wrn_lvl} "${WINE}WARN: $1${BLUE}"; }
inf() { log ${inf_lvl} "${CYAN}INFO: $1${BLUE}"; } # "info" is already a command
debug() { log ${dbg_lvl} "DEBG: $1"; }
log() {
      if [ ${verbosity} -ge $1 ]
      then
        datestring=$(date +'%H:%M:%S')
        # Expand escaped characters, wrap at 300 chars, indent wrapped lines
        echo -e "${DODGERBLUE1}${datestring} $(basename $0) [${LIGHT_BLUE}${HOSTNAME}${DODGERBLUE1} $(git_branch)${DODGERBLUE1}] ${SHLVL} ${2}${RESET}" #| fold -w450
      fi
}

export -f inf
export -f debug
export -f warn
export -f critical
export -f notify
export -f error
export -f log
export verbosity

if [[ ${VERBOSE} == yes ]]
then
  debug "${YELLOW}[ ${LIME}$(echo $(caller | awk '{print $2}') | awk -F\/ '{print $NF}') ${YELLOW}calls (in line: ${LIME}$(caller | awk '{print $1}')${YELLOW}) ${LIME}$(echo "${BASH_SOURCE[0]}" | awk -F\/ '{print $NF}') ${PARAMETERS} ${YELLOW} ]"
fi

export PATH_PARENT_SCRIPTS=$(dirname ${SCRIPTS_HOME})
export PATH_GRANDPARENT_SCRIPTS=$(dirname ${PATH_PARENT_SCRIPTS})
SCRIPT_NAME=$(echo ${SCRIPT} | awk -F\/ '{print $NF}')
export LDAPTLS_REQCERT=never
export EXTERNAL_INET_IP=$(timeout --preserve-status -s 9 -k 3 2 curl -s https://ipinfo.io/ip 2>/dev/null)
if [ ! -z ${EXTERNAL_INET_IP} ]
then
  if [[ ${VERBOSE} == yes ]]
  then
    debug "  external IP is: ${LIME}${EXTERNAL_INET_IP}"
  fi
fi

if type nproc > /dev/null 2>&1
then
  CPU_COUNT=$(nproc)
elif [[ "${OSTYPE}" =~ ^darwin.* ]]
then
  CPU_COUNT=$(system_profiler SPHardwareDataType | grep "Total Number of Cores:" | awk -F\: '{print $2}' | sed 's/^ *//g;s/* $//g')
else
  CPU_COUNT="4"
fi

if type zstd > /dev/null 2>&1
then
  alias zstd='zstd -T0'
else
  if type xz > /dev/null 2>&1
  then
    alias xz='xz -T0'
  fi
fi

if type ip > /dev/null 2>&1
then
  if [[ ! ${OSTYPE} =~ ^darwin.* ]]
  then
    DEFAULT_INET_IP=$(ip route get $(ip route show 0.0.0.0/0 | grep -oP 'via \K\S+') | grep -oP 'src \K\S+')
    #local_ip="$(ip route get 1 | awk -F'src' '{print $2; exit}')"
    #local_ip="${local_ip/uid*}"
    #[[ -z "$local_ip" ]] && local_ip="$(ifconfig -a | awk '/broadcast/ {print $2; exit}')"
  else
    DEFAULT_INET_IP=$(ifconfig | grep -w inet | awk '{print $2}' | tail -n1)
  fi
elif type ifconfig > /dev/null 2>&1
then
  DEFAULT_INET_IP=$(ifconfig | grep -w inet | awk '{print $2}' | tail -n1)
else
  error "There is no \"ip\", nor \"ifconfig\" exiting"
fi

if ! type grepcidr > /dev/null 2>&1
then
  error "There is no \"grepcidr\" command"
fi
if ! type jq > /dev/null 2>&1 && ([[ $0 =~ aws_.* ]] || [[ $0 =~ az_.* ]])
then
  error "There is no \"jq\" command, exiting"
  failed
fi
if ! type zip > /dev/null 2>&1 && ! type 7z > /dev/null 2>&1
then
  error "There is no \"zip/7z\" command, exiting"
  failed
elif type zip > /dev/null 2>&1
then
  export ZIP_ON="yes"
elif type 7z > /dev/null 2>&1
then
  export SZ_ON="yes"
fi
if ! type bc > /dev/null 2>&1
then
  error "There is no \"bc\" command, exiting"
  failed
fi
if ! type w3m > /dev/null 2>&1
then
  error "There is no \"w3m\" command"
fi

