#!/usr/bin/env bash

FFMPEG_GLOBAL_OPTIONS=(ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -threads 0)

# Step 2: helpers turning silent failures into explicit errors.
# require_output FILE STEP [LOG] - stops the run when a step did not produce its (non-empty) result
require_output()
{
  local OUTPUT_FILE="${1}"
  local STEP_NAME="${2}"
  local STEP_LOG="${3:-}"
  if [ ! -s "${OUTPUT_FILE}" ]
  then
    error "  ${STEP_NAME} did not produce: ${YELLOW}${OUTPUT_FILE}"
    if [ -n "${STEP_LOG}" ]
    then
      error "  see log: ${YELLOW}${STEP_LOG}"
    fi
    ERROR_CODE="1"
    failed
  fi
  }

# mkvtoolnix_status STATUS STEP [LOG] - mkvmerge/mkvpropedit exit codes: 0 = ok, 1 = warnings, 2 = error
mkvtoolnix_status()
{
  local STATUS="${1}"
  local STEP_NAME="${2}"
  local STEP_LOG="${3:-}"
  if [ "${STATUS}" -eq 1 ]
  then
    warn "  ${STEP_NAME} finished with warnings${STEP_LOG:+ (see log: ${STEP_LOG})}"
  elif [ "${STATUS}" -ne 0 ]
  then
    error "  ${STEP_NAME} failed with exit code ${YELLOW}${STATUS}${RED}${STEP_LOG:+ (see log: ${STEP_LOG})}"
    # the tool's own code is shown in the message; the script exits with 1 (processing error)
    ERROR_CODE="1"
    failed
  fi
  }

# wait_for_step PID STEP [LOG] - waits for a background step and stops the run when it failed.
# It must run before any bare "wait": after that, bash may no longer know the exit code of PID.
# Each PID is checked once per chunk (WAITED_PIDS is reset in interpolation_video_file).
wait_for_step()
{
  local STEP_PID="${1}"
  local STEP_NAME="${2}"
  local STEP_LOG="${3:-}"
  local STEP_STATUS
  if [[ -z ${STEP_PID} ]] || [[ " ${WAITED_PIDS} " == *" ${STEP_PID} "* ]]
  then
    return 0
  fi
  wait "${STEP_PID}"
  STEP_STATUS=$?
  WAITED_PIDS="${WAITED_PIDS} ${STEP_PID}"
  if [ "${STEP_STATUS}" -ne 0 ]
  then
    error "  ${STEP_NAME} failed with exit code ${YELLOW}${STEP_STATUS}${RED}${STEP_LOG:+ (see log: ${STEP_LOG})}"
    ERROR_CODE="1"
    failed
  fi
  }

# tracks_by_language MKVMERGE_JSON TYPE - comma separated mkvmerge track IDs of TYPE (audio/subtitles)
# in pl, nl or en; both the newer language_ietf and the older ISO 639-2 language field are checked
tracks_by_language()
{
  jq -r --arg track_type "${2}" '.tracks[] | select(.type == $track_type) | select((.properties.language_ietf // "" | test("^(pl|nl|en)(-|$)")) or ((.properties.language // "") as $l | ["pol", "dut", "nld", "eng"] | index($l))).id' "${1}" | tr "\n" "," | sed "s/,$//g"
  }

# all_tracks MKVMERGE_JSON TYPE - comma separated mkvmerge track IDs of TYPE, any language
all_tracks()
{
  jq -r --arg track_type "${2}" '.tracks[] | select(.type == $track_type).id' "${1}" | tr "\n" "," | sed "s/,$//g"
  }

# Step 3: deleting without eval and without risking paths outside the work area.
# safe_remove_dir DIR - removes DIR only when it lies inside ${TMP} or ${TMP_OUT};
# an empty variable could otherwise turn "${TMP}/${IN_DIR}/${NAME}" into "//" or "/"
safe_remove_dir()
{
  local TARGET_DIR="${1}"
  local ALLOWED_ROOT
  if [[ -z ${TARGET_DIR} ]] || [[ ${TARGET_DIR} == *"/../"* ]] || [[ ${TARGET_DIR} == *"/.." ]]
  then
    error "  refusing to remove suspicious directory: '${YELLOW}${TARGET_DIR}${RED}'"
    ERROR_CODE="1"
    failed
  fi
  for ALLOWED_ROOT in "${TMP}" "${TMP_OUT}"
  do
    if [[ -n ${ALLOWED_ROOT} ]] && [[ ${ALLOWED_ROOT} != "/" ]] && [[ ${TARGET_DIR} == "${ALLOWED_ROOT}/"?* ]]
    then
      rm -rf -- "${TARGET_DIR}"
      return
    fi
  done
  error "  refusing to remove a directory outside the work area (TMP/TMP_OUT): '${YELLOW}${TARGET_DIR}${RED}'"
  ERROR_CODE="1"
  failed
  }

# remove_numbered_frames DIR FROM TO - deletes DIR/<FROM>.png ... DIR/<TO>.png (8-digit names);
# replaces "eval rm {N..1}.png": no code execution from file names, no "argument list too long"
remove_numbered_frames()
{
  local FRAMES_DIR="${1}"
  local FROM_FRAME="${2}"
  local TO_FRAME="${3}"
  local FRAME_NUMBER
  local FRAME_FILE
  if [[ -z ${FRAMES_DIR} ]] || [[ ! ${FROM_FRAME} =~ ^[0-9]+$ ]] || [[ ! ${TO_FRAME} =~ ^[0-9]+$ ]]
  then
    return 0
  fi
  for (( FRAME_NUMBER=10#${FROM_FRAME}; FRAME_NUMBER<=10#${TO_FRAME}; FRAME_NUMBER++ ))
  do
    printf -v FRAME_FILE '%s/%08d.png' "${FRAMES_DIR}" "${FRAME_NUMBER}"
    rm -f -- "${FRAME_FILE}"
  done
  }

ncnn-release-build()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}'username/github-repo'"
    ERROR_CODE="1"
    failed
  else
    USERREPOSITORY_NCNN=${1}
    GITHUBUSER="$(echo ${USERREPOSITORY_NCNN} | awk -F\/ '{print $1}')"
    GITHUBREPO="$(echo ${USERREPOSITORY_NCNN} | awk -F\/ '{print $2}')"
  fi

  # TMP is new for every run, so the clone target is always empty and a failed clone is a real error
  if ! git clone "https://github.com/${USERREPOSITORY_NCNN}" "${TMP}/${GITHUBREPO}" > "${LOG}/${GITHUBREPO}_cloning_building.log" 2>&1
  then
    error "  cloning ${YELLOW}${USERREPOSITORY_NCNN}${RED} failed (see log: ${LOG}/${GITHUBREPO}_cloning_building.log)"
    ERROR_CODE="1"
    failed
  fi
  if [ ! -s "${TMP}/${GITHUBREPO}/src/CMakeLists.txt" ]
  then
    error "  ${YELLOW}${USERREPOSITORY_NCNN}${RED} has no src/CMakeLists.txt, so it cannot be built by this function"
    ERROR_CODE="1"
    failed
  fi
  BUILD_RESULT=$(grep "project(" "${TMP}/${GITHUBREPO}/src/CMakeLists.txt" | sed "s/project(//g;s/)//g")
  inf " ${YELLOW}${BUILD_RESULT}${CYAN} is needed, thus it will be built first..."
  if ! type ${BUILD_RESULT} > /dev/null 2>&1
  then
    (
      mkdir -p "${TMP}/${GITHUBREPO}/build"
      if ! cd "${TMP}/${GITHUBREPO}"
      then
        error "  cannot enter ${TMP}/${GITHUBREPO}"
        exit 1
      fi
      if [ -s "${TMP}/${GITHUBREPO}/.gitmodules" ]
      then
        if grep -q "github.com:" "${TMP}/${GITHUBREPO}/.gitmodules"
        then
          sed -i "s/git@github.com:/https:\/\/github.com\//g" "${TMP}/${GITHUBREPO}/.gitmodules"
        fi
      fi

      if ! cd build
      then
        error "  cannot enter ${TMP}/${GITHUBREPO}/build"
        exit 1
      fi
      # every build step is checked where it runs; any failure falls back to listing the release downloads
      if git submodule update --init --recursive >> "${LOG}/${GITHUBREPO}_cloning_building.log" 2>&1 \
         && cmake "-DCMAKE_POLICY_VERSION_MINIMUM=$(cmake --version | grep version | awk '{print $NF}')" ../src/ >> "${LOG}/${GITHUBREPO}_cloning_building.log" 2>&1 \
         && cmake --build . -j "$(nproc)" >> "${LOG}/${GITHUBREPO}_cloning_building.log" 2>&1 \
         && [ -s "${TMP}/${GITHUBREPO}/build/${BUILD_RESULT}" ]
      then
        if ! strip "${TMP}/${GITHUBREPO}/build/${BUILD_RESULT}" >> "${LOG}/${GITHUBREPO}_cloning_building.log" 2>&1
        then
          warn "  strip of ${BUILD_RESULT} failed; installing it unstripped"
        fi
        if ! sudo cp "${TMP}/${GITHUBREPO}/build/${BUILD_RESULT}" /usr/local/bin/ >> "${LOG}/${GITHUBREPO}_cloning_building.log" 2>&1
        then
          error "  could not install ${YELLOW}${BUILD_RESULT}${RED} into /usr/local/bin (see log: ${LOG}/${GITHUBREPO}_cloning_building.log)"
          exit 1
        fi
      else
        inf "  ${YELLOW}${BUILD_RESULT}${CYAN} cannot be built (see log: ${LOG}/${GITHUBREPO}_cloning_building.log), so it needs to be downloaded - if possible"
        curl -s https://api.github.com/repos/${USERREPOSITORY_NCNN}/releases/latest | jq -r ".assets[].browser_download_url"
      fi
      )
    # "exit 1" above only leaves the ( ... ) subshell, so its status is checked here
    local BUILD_STATUS=$?
    if [ "${BUILD_STATUS}" -ne 0 ]
    then
      ERROR_CODE="1"
      failed
    fi
  else
    inf "  ${YELLOW}${BUILD_RESULT}${CYAN} looks like exists, continuing"
  fi
  }

checking_space_bg()
{
  if [ $# -ne 2 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs two parameters: ${YELLOW}[PID] of the process which is observed, ${ORANGE1}[DIR]"
    ERROR_CODE="1"
    failed
  else
    CHECK_PID=${1}
    CHECK_DIR="${2}"
  fi
  SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  (
    while ps -p ${CHECK_PID} > /dev/null 2>&1
    do
      SPACE_TAKEN_DIR=$(du -sk "${TMP}/${IN_DIR}/${MOVIE_NAME_ARRAY[*]}" 2>/dev/null | awk '{print $1}')
      SPACE_TAKEN_DIR="$(printf "%.0f\n" "$(echo "${SPACE_TAKEN_DIR}/1024" | bc -l)")"
      if [ ${SPACE_TAKEN_DIR} -gt ${MAX_SPACE_TAKEN_INPUT_DIR} ]
      then
        MAX_SPACE_TAKEN_INPUT_DIR=${SPACE_TAKEN_INPUT_DIR}
      fi
      if [[ ${VERBOSE} == no ]]
      then
        printf "\033[%d;0H\033[2K f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 18))" "in=${WINE}${MAX_SPACE_TAKEN_INPUT_DIR}${CYAN}/${LIGHT_YELLOW}${SPACE_TAKEN_INPUT_DIR}${WHITE} [GB]${RESET}" 2>/dev/null
      fi
      sleep 3
    done
    ) &
  }

checking_space_background()
{
  if [ $# -ne 3 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs three parameters: ${YELLOW}PID of the process which is observed, ${ORANGE1}VIDEO_IN_DIR, ${DEEPPINK1}VIDEO_OUT_DIR"
    ERROR_CODE="1"
    failed
  else
    local CHECK_PID=${1}
    local VIDEO_IN_DIR=${2}
    local VIDEO_OUT_DIR=${3}
  fi
  local SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  if [ -z ${MAX_SPACE_TAKEN_INPUT_DIR} ] || [[ ${MAX_SPACE_TAKEN_INPUT_DIR} == "" ]]
  then
    MAX_SPACE_TAKEN_INPUT_DIR=0
  elif [ -s "${TMP}/MAX_SPACE_TAKEN_INPUT_DIR" ]
  then
    MAX_SPACE_TAKEN_INPUT_DIR=$(cat "${TMP}/MAX_SPACE_TAKEN_INPUT_DIR")
  fi

  if [ -z ${MAX_SPACE_TAKEN_OUTPUT_DIR} ] || [[ ${MAX_SPACE_TAKEN_OUTPUT_DIR} == "" ]]
  then
    MAX_SPACE_TAKEN_OUTPUT_DIR=0
  elif [ -s "${TMP}/MAX_SPACE_TAKEN_OUTPUT_DIR" ]
  then
    MAX_SPACE_TAKEN_OUTPUT_DIR=$(cat "${TMP}/MAX_SPACE_TAKEN_OUTPUT_DIR")
  fi
  (
    while ps -p ${CHECK_PID} > /dev/null 2>&1
    do
      SPACE_TAKEN_INPUT_DIR=$(du -sm "${VIDEO_IN_DIR}/${IN_DIR}/${MOVIE_NAME_ARRAY[*]}" 2>/dev/null | awk '{print $1}')
      SPACE_TAKEN_INPUT_DIR="$(printf "%.0f\n" "$(echo "${SPACE_TAKEN_INPUT_DIR}/1000" | bc -l)")"
      if [ ${SPACE_TAKEN_INPUT_DIR} -gt ${MAX_SPACE_TAKEN_INPUT_DIR} ]
      then
        MAX_SPACE_TAKEN_INPUT_DIR=${SPACE_TAKEN_INPUT_DIR}
      fi
      SPACE_TAKEN_OUTPUT_DIR=$(du -sm "${VIDEO_OUT_DIR}/${OUT_DIR}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}" 2>/dev/null | awk '{print $1}')
      SPACE_TAKEN_OUTPUT_DIR="$(printf "%.0f\n" "$(echo "${SPACE_TAKEN_OUTPUT_DIR}/1000" | bc -l)")"
      if [ ${SPACE_TAKEN_OUTPUT_DIR} -gt ${MAX_SPACE_TAKEN_OUTPUT_DIR} ]
      then
        MAX_SPACE_TAKEN_OUTPUT_DIR=${SPACE_TAKEN_OUTPUT_DIR}
      fi
      SPACE_TAKEN_OVERALL=$((SPACE_TAKEN_INPUT_DIR + SPACE_TAKEN_OUTPUT_DIR))
      MAX_SPACE_TAKEN_OVERALL=$((MAX_SPACE_TAKEN_INPUT_DIR + MAX_SPACE_TAKEN_OUTPUT_DIR))
      PERCENT_TSPACE_INPUT=$(printf "%.0f\n" "$(echo "(${MAX_SPACE_TAKEN_INPUT_DIR}/${INPUT_FRAMES_MAX_TSPACE})*100" | bc -l)")
      PERCENT_TSPACE_OUTPUT=$(printf "%.0f\n" "$(echo "(${MAX_SPACE_TAKEN_OUTPUT_DIR}/${INTER_FRAMES_MAX_TSPACE})*100" | bc -l)")
      if [[ ${VERBOSE} == no ]]
      then
        printf "\033[%d;0H\033[2K ${WHITE}f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 18))" "      ${MAGENTA2}[...]/${IN_DIR}/${MOVIE_NAME_ARRAY[*]}=${WINE}${MAX_SPACE_TAKEN_INPUT_DIR} (${PERCENT_TSPACE_INPUT}[%])${CYAN}/${LIGHT_YELLOW}${SPACE_TAKEN_INPUT_DIR}${WHITE} [GB], ${MAGENTA2}[...]/${OUT_DIR}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}=${WINE}${MAX_SPACE_TAKEN_OUTPUT_DIR} (${PERCENT_TSPACE_OUTPUT}[%])${CYAN}/${BROWN}${SPACE_TAKEN_OUTPUT_DIR}${WHITE} [GB]; all=${LIME}${MAX_SPACE_TAKEN_OVERALL}${CYAN}/${DARK_GREEN}${SPACE_TAKEN_OVERALL}" 2>/dev/null
      fi
      sleep 3
    done
    echo "${MAX_SPACE_TAKEN_INPUT_DIR}" > "${TMP}/MAX_SPACE_TAKEN_INPUT_DIR"
    echo "${MAX_SPACE_TAKEN_OUTPUT_DIR}" > "${TMP}/MAX_SPACE_TAKEN_OUTPUT_DIR"
    echo "${MAX_SPACE_TAKEN_OVERALL}" > "${TMP}/MAX_SPACE_TAKEN_OVERALL"
    ) &
  }

mp4_to_mkv()
{
  start_time_collecting
  inf "  conversion of ${YELLOW}${FILE_NAME}${CYAN} from mp4 to mkv"
  # only the final ".mp4" is removed, so "Movie.Name.2024.mp4" keeps its dots
  FILE_NAME="${FILE_NAME%.mp4}"
  if ! ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -threads 0 -i "${FILE_NAME}.mp4" -vcodec copy -acodec copy "${FILE_NAME}.mkv" > "${LOG}/${FILE_NAME}_mp4-2-mkv.log" 2>&1
  then
    error "  conversion of ${YELLOW}${FILE_NAME}.mp4${RED} to mkv failed (see log: ${LOG}/${FILE_NAME}_mp4-2-mkv.log)"
    ERROR_CODE="1"
    failed
  fi
  FILE_NAME="${FILE_NAME}.mkv"
  require_output "${FILE_NAME}" "mp4 to mkv conversion" "${LOG}/${FILE_NAME%.mkv}_mp4-2-mkv.log"
  end_time_collecting
  inf "    conversion of ${YELLOW}${FILE_NAME}${CYAN} done successfully ${MAGENTA}${RUNTIME}"
  }

splitting_video()
{
  start_time_collecting
  mkvmerge -o "${TMP}/${MOVIE_NAME_ARRAY[*]}_%03d.mkv" --split 120s ${FILE_NAME}
  end_time_collecting
  inf "    splitting of ${YELLOW}${FILE_NAME}${CYAN} done successfully ${MAGENTA}${RUNTIME}"
  }

appending_mkvs()
{
  mkvmerge -o "${WHOLE_MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_merge_${SPLIT_PART_START}-${LAST_VIDEO_FRAGMENT_ID}.mkv" $(ls --color=never video_part_minute_*_merged.mkv | sed "s/^/+/g" | tr "\n" " " | sed "s/^+//g")
  }

extracting_mkv_streams()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}VIDEO_FILE_NAME which subtitles and audio should be extracted"
    ERROR_CODE="1"
    failed
  else
    local VIDEO_FILE_NAME="${1}"
  fi
  local SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  inf "  extracting streams (audio and subtitles)"
  start_time_collecting
  local TRACKS_JSON="${TMP}/${VIDEO_FILE_NAME}_mkvmerge_tracks.json"
  if ! mkvmerge -J "${VIDEO_FILE_NAME}.mkv" > "${TRACKS_JSON}" 2>"${LOG}/${VIDEO_FILE_NAME}_mkvmerge_tracks.log"
  then
    error "  reading tracks of ${YELLOW}${VIDEO_FILE_NAME}.mkv${RED} (mkvmerge -J) failed (see log: ${LOG}/${VIDEO_FILE_NAME}_mkvmerge_tracks.log)"
    ERROR_CODE="1"
    failed
  fi
  # audio is optional: without audio tracks nothing is extracted and nothing is merged later
  AUDIO_EXTRACT_PID=""
  AUDIO_EXTRACTED="no"
  SELECTED_AUDIO_IDS="$(tracks_by_language "${TRACKS_JSON}" audio)"
  if [ -z "${SELECTED_AUDIO_IDS}" ]
  then
    SELECTED_AUDIO_IDS="$(all_tracks "${TRACKS_JSON}" audio)"
    if [ -n "${SELECTED_AUDIO_IDS}" ]
    then
      warn "  no pl/nl/en audio track in ${VIDEO_FILE_NAME}.mkv, taking all audio tracks (${SELECTED_AUDIO_IDS})"
    else
      warn "  ${VIDEO_FILE_NAME}.mkv has no audio track, continuing without audio"
    fi
  fi
  if [ -n "${SELECTED_AUDIO_IDS}" ]
  then
    mkvmerge --output "${TMP}/${VIDEO_FILE_NAME}.mka" --no-video --no-subtitles --no-track-tags --no-global-tags --audio-tracks "${SELECTED_AUDIO_IDS}" "${VIDEO_FILE_NAME}.mkv" > "${LOG}/${VIDEO_FILE_NAME}_extract_sound.log" 2>&1 &
    AUDIO_EXTRACT_PID=$!
    AUDIO_EXTRACTED="yes"
    echo "${AUDIO_EXTRACT_PID}" > "${TMP}/${VIDEO_FILE_NAME}_extract_audio.pid"
  fi
  # subtitles are optional too, picked by the same languages
  SUBS_EXTRACT_PID=""
  SELECTED_SUBTITLES_IETF="$(tracks_by_language "${TRACKS_JSON}" subtitles)"
  if [ -n "${SELECTED_SUBTITLES_IETF}" ]
  then
    mkvmerge --output "${TMP}/${VIDEO_FILE_NAME}_subtitles.mkv" --no-audio --no-video --no-track-tags --no-global-tags --subtitle-tracks "${SELECTED_SUBTITLES_IETF}" "${VIDEO_FILE_NAME}.mkv" > "${LOG}/${VIDEO_FILE_NAME}_extract_subtitles.log" 2>&1 &
    SUBS_EXTRACT_PID=$!
    echo "${SUBS_EXTRACT_PID}" > "${TMP}/${VIDEO_FILE_NAME}_extract_subs.pid"
  fi
  (
    while [ -n "${AUDIO_EXTRACT_PID}" ] && ps -p "${AUDIO_EXTRACT_PID}" > /dev/null 2>&1
    do
      sleep 1
    done
    end_time_collecting
    EXTRACTING_STREAMS_RUNTIME=${RUNTIME}
    echo ${RUNTIME} > "${TMP}/EXTRACTING_STREAMS_RUNTIME"
    ) &
  }

converting_hdr2sdr()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}VIDEO_FILE_NAME which is checked if HDR (interpolating process is SDR only)"
    ERROR_CODE="1"
    failed
  else
    local VIDEO_FILE_NAME="${1}"
  fi
  COLOR_SPACE=$(jq -r '.frames[].color_space' "${TMP}/${MOVIE_NAME_ARRAY[*]}_mastering_display.json")
  COLOR_PRIMARIES=$(jq -r '.frames[].color_primaries' "${TMP}/${MOVIE_NAME_ARRAY[*]}_mastering_display.json")
  export COLOR_PRIMARIES
  COLOR_TRANSFER=$(jq -r '.frames[].color_transfer' "${TMP}/${MOVIE_NAME_ARRAY[*]}_mastering_display.json")
  if [[ ${VERBOSE} == yes ]]
  then
    debug "    COLOR_SPACE=${COLOR_SPACE}"
    debug "    COLOR_PRIMARIES=${COLOR_PRIMARIES}"
    debug "    COLOR_TRANSFER=${COLOR_TRANSFER}"
  fi
  # the tone mapping itself is done by the frames extraction (and by the VMAF check for its
  # reference) with this filter: no separate SDR copy of the chunk is encoded anymore, because
  # that lossless x265 encode took ~2/3 of the stage, while libplacebo itself is fast
  TONE_MAPPING_FILTER=""
  # TONE_MAPPING=no comes from interpolation_nncn -T
  if [[ ${COLOR_PRIMARIES} != "bt709" ]] && [[ ${TONE_MAPPING:-yes} == no ]]
  then
    warn "  HDR video (${COLOR_PRIMARIES}), but tone mapping is switched off (-T): frames are processed as HDR, colours may differ"
  elif [[ ${COLOR_PRIMARIES} != "bt709" ]]
  then
    inf "  tone mapping (HDR to SDR) is done during frames extraction"
    TONE_MAPPING_FILTER="libplacebo=tonemapping=bt.2390:colorspace=bt709:color_primaries=bt709:color_trc=bt709:format=yuv420p"
  fi
  }

extracting_mkv_frames()
{
  if [ $# -ne 3 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs three parameters: ${YELLOW}VIDEO_FILE_NAME which subtitles and audio should be extracted, ${ORANGE1}VIDEO_IN_DIR, ${DEEPPINK1}VIDEO_OUT_DIR"
    ERROR_CODE="1"
    failed
  else
    local VIDEO_FILE_NAME="${1}"
    local VIDEO_IN_DIR="${2}"
    local VIDEO_OUT_DIR="${3}"
  fi
  local SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  if [[ ${VERBOSE} == yes ]]
  then
    debug "  extracting frames"
  fi
  tput sc
  start_time_collecting
  # set by converting_hdr2sdr for HDR input (empty: frames are extracted as they are)
  local EXTRACTION_FILTER=()
  if [ -n "${TONE_MAPPING_FILTER}" ]
  then
    EXTRACTION_FILTER=(-vf "${TONE_MAPPING_FILTER}")
  fi
  # passthrough: one PNG per decoded frame (= INPUT_FRAMES_COUNT); the image2 default (cfr) would
  # duplicate frames at timestamp gaps, so NCNN, the placeholders and VMAF would not match anymore
  ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -threads 0 -i "${VIDEO_FILE_NAME}.mkv" "${EXTRACTION_FILTER[@]}" -fps_mode passthrough "${VIDEO_IN_DIR}/${IN_DIR}/${VIDEO_FILE_NAME}/"%08d.png > "${LOG}/${VIDEO_FILE_NAME}_inter_inframes.log" 2>&1 & echo "$!" > "${TMP}/${VIDEO_FILE_NAME}_inter_inframes.pid"
  FFMPEG_EX_BACKGROUND_PROCESS_PID=$(cat "${TMP}/${VIDEO_FILE_NAME}_inter_inframes.pid")
  if [[ ${VERBOSE} == yes ]]
  then
    debug "    ffmpeg isolation PID=${MAGENTA}${FFMPEG_EX_BACKGROUND_PROCESS_PID}"
  fi
  sleep 5
  (
    while ps -p ${FFMPEG_EX_BACKGROUND_PROCESS_PID} > /dev/null 2>&1
    do
      CURRENT_EXTRACTED_FRAME=$(tail -n$((TARGET_FRAME_COUNT*6)) "${LOG}/${VIDEO_FILE_NAME}_inter_inframes.log" | grep "frame=" | tail -n1 | sed "s/frame=//g")
      if [[ ${CURRENT_EXTRACTED_FRAME} != "" ]]
      then
        CURRENT_EXTRACTED_FRAME_PERCENT="$(echo "(${CURRENT_EXTRACTED_FRAME}/${INPUT_FRAMES_COUNT}) * 100" | bc -l | tee -a "${LOG}/${VIDEO_FILE_NAME}_percent_inter_inframes.log")"
        CURRENT_EXTRACTED_FRAME_PERCENT="$(printf "%.0f\n" "${CURRENT_EXTRACTED_FRAME_PERCENT}")"
        if [[ ${VERBOSE} == no ]]
        then
          printf "\033[%d;0H\033[2K ${WHITE}f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 17))" "          ${MAGENTA2}currently extracted frame ${BROWN}${CURRENT_EXTRACTED_FRAME} ${LIGHT_MAGENTA}${CURRENT_EXTRACTED_FRAME_PERCENT} [%]" 2>/dev/null
        fi
      fi
      sleep 2
    done
    end_time_collecting
    echo ${RUNTIME} > "${TMP}/EXTRACTING_FRAMES_RUNTIME"
    # frames may be removed meanwhile by the interpolation monitor, which is not an error
    find "${VIDEO_IN_DIR}/${IN_DIR}/${VIDEO_FILE_NAME}/" -ignore_readdir_race -iname '*.png' -type f -empty -delete
    ) &
  }

# NCNN gets the full frame count up front (empty split placeholders), so it must never read a frame
# ffmpeg has not written yet: such a frame fails to decode and NCNN may crash. When extraction is
# slower than NCNN (e.g. tone mapping on a GPU shared with NCNN), NCNN is paused (SIGSTOP) while it is
# closer than NCNN_EXTRACTION_MARGIN input frames to the extraction, and resumed (SIGCONT) when the
# extraction is twice the margin ahead (or finished); the gap covers NCNN's read-ahead queue (8 tasks).
# Pausing keeps both running in parallel, unlike starting NCNN only after the extraction.
NCNN_EXTRACTION_MARGIN="${NCNN_EXTRACTION_MARGIN:-50}"
# throttling_ncnn NCNN_PID EXTRACTION_LOG NCNN_LOG - one check; NCNN_PAUSED (yes/no) keeps the state
throttling_ncnn()
{
  local NCNN_PID="${1}"
  local EXTRACTION_LOG="${2}"
  local NCNN_LOG="${3}"
  local EXTRACTED_FRAME
  local NCNN_FRAME
  EXTRACTED_FRAME="$(grep "^frame=" "${EXTRACTION_LOG}" 2>/dev/null | tail -n1 | sed "s/frame=//g")"
  if [[ ! ${EXTRACTED_FRAME} =~ ^[0-9]+$ ]]
  then
    EXTRACTED_FRAME="0"
  fi
  # the last processed pair: "<in0>.png <in1>.png <time> -> <out>.png done"
  NCNN_FRAME="$(grep " done$" "${NCNN_LOG}" 2>/dev/null | tail -n1 | awk '{print $2}' | awk -F/ '{print $NF}' | sed "s/\.png//g")"
  if [[ ${NCNN_FRAME} =~ ^[0-9]+$ ]]
  then
    NCNN_FRAME="$((10#${NCNN_FRAME}))"
  else
    NCNN_FRAME="0"
  fi
  if [[ ${NCNN_PAUSED:-no} == no ]] && [ $((EXTRACTED_FRAME - NCNN_FRAME)) -lt "${NCNN_EXTRACTION_MARGIN}" ]
  then
    if kill -STOP "${NCNN_PID}" 2>/dev/null
    then
      NCNN_PAUSED="yes"
      # how often and how long NCNN waited for the extraction
      printf '%s paused  (NCNN frame %s, extracted %s)\n' "$(date +%T)" "${NCNN_FRAME}" "${EXTRACTED_FRAME}" >> "${NCNN_LOG%.log}_throttle.log"
    fi
  elif [[ ${NCNN_PAUSED:-no} == yes ]] && [ $((EXTRACTED_FRAME - NCNN_FRAME)) -ge $((NCNN_EXTRACTION_MARGIN * 2)) ]
  then
    resuming_ncnn "${NCNN_PID}"
    printf '%s resumed (NCNN frame %s, extracted %s)\n' "$(date +%T)" "${NCNN_FRAME}" "${EXTRACTED_FRAME}" >> "${NCNN_LOG%.log}_throttle.log"
  fi
  }

# resuming_ncnn NCNN_PID - lets a paused NCNN continue (also before it is waited for or stopped)
resuming_ncnn()
{
  kill -CONT "${1}" 2>/dev/null
  NCNN_PAUSED="no"
  }

# GPUs used by NCNN (-g) and its threads (-j load:proc,proc:save, one proc value per GPU) depend on
# the machine, so the defaults follow the OS: macOS (one GPU, 0) or the Linux rig (two AMD GPUs, 1 and 2,
# -j tuned in README); a machine with another GPU set can override both from the environment
if [[ $(uname -s) == Darwin ]]
then
  NCNN_GPUS_DEFAULT="0"
  NCNN_THREADS_DEFAULT="1:2:2"
else
  NCNN_GPUS_DEFAULT="1,2"
  NCNN_THREADS_DEFAULT="6:2,2:8"
fi
NCNN_GPUS="${NCNN_GPUS:-${NCNN_GPUS_DEFAULT}}"
NCNN_THREADS="${NCNN_THREADS:-${NCNN_THREADS_DEFAULT}}"

interpolating_extracted_frames()
{
  if [ $# -ne 3 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs three parameters: ${YELLOW}VIDEO_FILE_NAME which subtitles and audio should be extracted, ${ORANGE1}VIDEO_IN_DIR, ${DEEPPINK1}VIDEO_OUT_DIR"
    ERROR_CODE="1"
    failed
  else
    local VIDEO_FILE_NAME="${1}"
    local FRAMES_IN_DIR="${2}"
    local FRAMES_OUT_DIR="${3}"
  fi
  local SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  local LOG_FILE="${VIDEO_FILE_NAME}_ncnn_${NCNN_METHOD}"
  local NCNN_PARAMETERS=""
  inf "  interpolating, ${NCNN_METHOD} (${MAROON1}${INPUT_FPS} -> ${OUTPUT_FPS} [fps]${CYAN}) of ${YELLOW}${VIDEO_FILE_NAME}.${FILE_NAME_EXTENSION}"
  tput sc
  start_time_collecting
  # shellcheck disable=SC2054 # commas belong to NCNN values (e.g. -g 1,2), they are not array separators
  if [[ ${NCNN_METHOD} == rife ]]
  then
    NCNN_PARAMETERS=(-v -g "${NCNN_GPUS}" -j "${NCNN_THREADS}" -u -n ${INTER_FRAMES_COUNT} -m rife-v4.6)
  elif [[ ${NCNN_METHOD} == dain ]] || [[ ${NCNN_METHOD} == cain ]]
  then
    NCNN_PARAMETERS=(-v -t 256,256 -g "${NCNN_GPUS}" -j "${NCNN_THREADS}" -n ${INTER_FRAMES_COUNT})
  elif [[ ${NCNN_METHOD} == realsr ]]
  then
    NCNN_SCALE=4
    OUTPUT_FPS_ROUND="${NCNN_SCALE}"
    NCNN_PARAMETERS=(-v -g "${NCNN_GPUS}" -j "${NCNN_THREADS}" -s ${NCNN_SCALE} -t 0,0 -x -m models-DF2K)
  elif [[ ${NCNN_METHOD} == realesrgan ]]
  then
    NCNN_SCALE=2 # or 3 or 4
    OUTPUT_FPS_ROUND="${NCNN_SCALE}"
    NCNN_PARAMETERS=(-v -g "${NCNN_GPUS}" -j "${NCNN_THREADS}" -s ${NCNN_SCALE} -t 0,0 -n 4 -x)
  elif [[ ${NCNN_METHOD} == srmd ]]
  then
    NCNN_SCALE=2 # or 3 or 4
    OUTPUT_FPS_ROUND="${NCNN_SCALE}"
    NCNN_PARAMETERS=(-v -g "${NCNN_GPUS}" -j "${NCNN_THREADS}" -t 0,0 -n 4 -x)
  fi
  # NCNN looks for its models (e.g. rife-v4.6) next to the path it was started with; started through a
  # symlink (e.g. /usr/local/bin on macOS) it would not find them, so the real path is used
  local NCNN_BINARY
  NCNN_BINARY="$(readlink -f "$(command -v "${NCNN_METHOD}-ncnn-vulkan")")"
  (exec 2>/dev/null "${NCNN_BINARY}" "${NCNN_PARAMETERS[@]}" -i "${FRAMES_IN_DIR}/${IN_DIR}/${VIDEO_FILE_NAME}" -o "${FRAMES_OUT_DIR}/${OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}" > "${LOG}/${LOG_FILE}.log" 2>&1 ) & echo "$!" > "${TMP}/${LOG_FILE}.pid"
  NCNN_BACKGROUND_PROCESS_PID=$(cat "${TMP}/${LOG_FILE}.pid")
  export NCNN_BACKGROUND_PROCESS_PID
  LAST_MANAGED_FRAME=""
  LAST_GENERATED_FRAME=""
  LAST_MANAGED_FRAME_PERCENT=""
  LAST_MANAGED_FRAME_PERCENT=""
  MANAGED_FRAME_TO_REMOVE=""
  MANAGED_FILE_TO_REMOVE=""
  local REMOVED_INPUT_FRAMES_UP_TO="0"
  (
    while ps -p ${NCNN_BACKGROUND_PROCESS_PID} > /dev/null 2>&1
    do
      if [ -s "${LOG}/${LOG_FILE}.log" ]
      then
        LAST_MANAGED_FRAME=$(grep "${TMP_OUT}" "${LOG}/${LOG_FILE}.log" | grep -vE 'failed|decode|vkQueueSubmit' | awk '{print $1}' | tail -n1 | awk -F\/ '{print $NF}' | sed "s/\.png//g")
        if [[ ${LAST_MANAGED_FRAME} =~ ^[0-9]+$ ]]
        then
          LAST_GENERATED_FRAME=$(grep "${TMP_OUT}" "${LOG}/${LOG_FILE}.log" | grep -vE 'failed|decode' | awk '{print $5}' | tail -n1 | awk -F\/ '{print $NF}' | sed "s/\.png//g")
          # when ( - 200) is set with 2x ncnn interpolation - there are still and quite many over-removed frames
          # when ( - 300) is set with 2x ncnn interpolation - there are NONE over-removed frames
          LAST_MANAGED_FRAME_PERCENT="$(echo "(${LAST_MANAGED_FRAME}/${INPUT_FRAMES_COUNT}) * 100" | bc -l)"
          LAST_MANAGED_FRAME_PERCENT="$(printf "%.0f\n" "${LAST_MANAGED_FRAME_PERCENT}" 2>/dev/null | tee "${TMP}/LAST_MANAGED_FRAME_PERCENT")"
          MANAGED_FRAME_TO_REMOVE=$(echo "${LAST_MANAGED_FRAME} - (${TARGET_FRAME_COUNT}*150)" | bc -l )
          if [[ ${MANAGED_FRAME_TO_REMOVE} =~ ^[0-9]+$ ]]
          then
            MANAGED_FILE_TO_REMOVE="$(printf "%08d\n" "${MANAGED_FRAME_TO_REMOVE}")"
          else
            # still within the safety margin at the start of a chunk, nothing to remove yet
            MANAGED_FILE_TO_REMOVE="-"
          fi
          if [[ ${MANAGED_FRAME_TO_REMOVE} =~ ^[0-9]+$ ]] && [ ${MANAGED_FRAME_TO_REMOVE} -gt 50 ]
          then
            # MANAGED_FILE_TO_REMOVE="$(printf "%08d\n" "${MANAGED_FRAME_TO_REMOVE}")"
            #if [[ ${VERBOSE} == no ]]
            #then
            #  printf "\033[%d;0H\033[2K ${WHITE}f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 16))" " ${MAGENTA2}currently interpolated frame ${BROWN}${LAST_MANAGED_FRAME} ${LIGHT_MAGENTA}${LAST_MANAGED_FRAME_PERCENT} [%] (removing: ${MANAGED_FILE_TO_REMOVE})" 2>/dev/null
            #fi
            # only frames not removed in an earlier round are deleted
            remove_numbered_frames "${FRAMES_IN_DIR}/${IN_DIR}/${VIDEO_FILE_NAME}" "$((REMOVED_INPUT_FRAMES_UP_TO + 1))" "${MANAGED_FRAME_TO_REMOVE}"
            REMOVED_INPUT_FRAMES_UP_TO="${MANAGED_FRAME_TO_REMOVE}"
          fi
          if [[ ${VERBOSE} == no ]]
          then
            printf "\033[%d;0H\033[2K ${WHITE}f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 16))" " ${MAGENTA2}currently interpolated frame ${BROWN}${LAST_MANAGED_FRAME} ${LIGHT_MAGENTA}${LAST_MANAGED_FRAME_PERCENT} [%] (removing: ${MANAGED_FILE_TO_REMOVE})" 2>/dev/null
          fi
        fi
      fi
      sleep 2
    done
    rm -f -- "${FRAMES_IN_DIR}/${IN_DIR}/${VIDEO_FILE_NAME}/"*.png
    end_time_collecting
    echo ${RUNTIME} > "${TMP}/INTERPOLATING_FRAMES_RUNTIME"
    ) &
  if [[ ${VERBOSE} == yes ]]
  then
    debug "    ${NCNN_METHOD}-ncnn-vulkan isolation PID=${MAGENTA}${NCNN_BACKGROUND_PROCESS_PID}"
  fi
  }

# Codec of the intermediate video made from the processed frames (HandBrake encodes the final video later).
# Can be overridden from the environment, e.g. INTERMEDIATE_CODEC=ffv1 ./interpolation_nncn ...
# Size per 60 s chunk at 3840x1600, 50 fps (3000 frames); VMAF against the source frames
# (details: README, "Performance optimization"):
#   x264_lossless - libx264 -qp 0 -preset ultrafast: lossless, fastest, ~10.9 GB
#   ffv1          - lossless, slower, about 0.8x the size of x264_lossless
#   x264_crf10    - libx264 -crf 10 -preset veryfast: ~900 MB, VMAF 97.9
#   svtav1_crf10  - libsvtav1 -crf 10 -preset 8: ~330 MB, VMAF 93.3
INTERMEDIATE_CODEC="${INTERMEDIATE_CODEC:-x264_lossless}"

# intermediate_codec_options - sets INTERMEDIATE_CODEC_OPTIONS from INTERMEDIATE_CODEC and checks that
# ffmpeg has the encoder (unknown name: exit 2, missing encoder: exit 127)
intermediate_codec_options()
{
  local INTERMEDIATE_ENCODER
  case "${INTERMEDIATE_CODEC}" in
    x264_lossless)
      INTERMEDIATE_ENCODER="libx264"
      INTERMEDIATE_CODEC_OPTIONS=(-c:v libx264 -qp 0 -preset ultrafast)
      ;;
    ffv1)
      INTERMEDIATE_ENCODER="ffv1"
      INTERMEDIATE_CODEC_OPTIONS=(-c:v ffv1 -level 3 -slices 24 -slicecrc 1 -threads 0)
      ;;
    svtav1_crf10)
      # no rc=1 here: in SVT-AV1 rc=1 means VBR (default 2 Mbps), which overrides -crf
      INTERMEDIATE_ENCODER="libsvtav1"
      INTERMEDIATE_CODEC_OPTIONS=(-c:v libsvtav1 -crf 10 -preset 8 -svtav1-params tune=0)
      ;;
    x264_crf10)
      INTERMEDIATE_ENCODER="libx264"
      INTERMEDIATE_CODEC_OPTIONS=(-c:v libx264 -crf 10 -preset veryfast)
      ;;
    *)
      error "  unknown INTERMEDIATE_CODEC=${YELLOW}${INTERMEDIATE_CODEC}${RED} (supported: x264_lossless, ffv1, svtav1_crf10, x264_crf10)"
      ERROR_CODE="2"
      failed
      ;;
  esac
  if ! ffmpeg -hide_banner -encoders 2>/dev/null | grep -qw "${INTERMEDIATE_ENCODER}"
  then
    error "  ffmpeg has no ${YELLOW}${INTERMEDIATE_ENCODER}${RED} encoder, needed for INTERMEDIATE_CODEC=${INTERMEDIATE_CODEC}"
    ERROR_CODE="127"
    failed
  fi
  }

# ffmpeg_feature_checks VIDEO_FILE - checks ffmpeg filters this run will need, before any work:
# libplacebo for an HDR video (unless -T), libvmaf with -Q; a missing one exits 127
ffmpeg_feature_checks()
{
  local VIDEO_FILE="${1}"
  local FFMPEG_FILTERS
  local INPUT_COLOR_PRIMARIES
  FFMPEG_FILTERS="$(ffmpeg -hide_banner -filters 2>/dev/null | awk '{print $2}')"
  if [[ ${TONE_MAPPING:-yes} != no ]]
  then
    # the same rule as converting_hdr2sdr: everything not bt709 is tone-mapped
    INPUT_COLOR_PRIMARIES="$(ffprobe -v error -select_streams v:0 -show_entries stream=color_primaries -of default=nw=1:nk=1 "${VIDEO_FILE}" 2>/dev/null)"
    if [[ ${INPUT_COLOR_PRIMARIES} != "bt709" ]] && ! grep -qx libplacebo <<< "${FFMPEG_FILTERS}"
    then
      error "  ${YELLOW}${VIDEO_FILE}${RED} is HDR (${INPUT_COLOR_PRIMARIES:-unknown}), but ffmpeg has no ${YELLOW}libplacebo${RED} filter for tone mapping (use -T to process it as HDR)"
      ERROR_CODE="127"
      failed
    fi
  fi
  if [[ ${QUALITY_CHECK:-no} == yes ]] && ! grep -qx libvmaf <<< "${FFMPEG_FILTERS}"
  then
    error "  -Q needs the ffmpeg ${YELLOW}libvmaf${RED} filter, which this ffmpeg does not have"
    ERROR_CODE="127"
    failed
  fi
  }

merging_frames_mkv()
{
  if [ $# -ne 3 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs three parameters: ${YELLOW}VIDEO_FILE_NAME to which frames should be merged, ${ORANGE1}FRAMES_IN_DIR, ${DEEPPINK1}VIDEO_OUT_DIR"
    ERROR_CODE="1"
    failed
  else
    local VIDEO_FILE_NAME="${1}"
    local FRAMES_IN_DIR="${2}"
    local VIDEO_OUT_DIR="${3}"
  fi
  local SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  FFMPEG_LOCAL_LOG_FILENAME="${VIDEO_FILE_NAME}_ffmpeg_merging"
  export FFMPEG_LOCAL_LOG_FILENAME
  start_time_collecting
  # x265
  # ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -framerate ${OUTPUT_FPS} -i "${FRAMES_IN_DIR}/${OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}/"%08d.png -pix_fmt yuv420p10le -c:v libx265 -preset medium -crf 0 -x265-params no-open-gop=1:keyint=300:gop-lookahead=12:bframes=6:weightb=1:hme=1:strong-intra-smoothing=0:rect=0:aq-mode=4 "${VIDEO_OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}.mkv" > "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.log" 2>&1 & echo "$!" > "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.pid"

  rm -f -- "${TMP}/${OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}/00000000.png"
  ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -threads 0 -framerate ${OUTPUT_FPS} -i "${FRAMES_IN_DIR}/${OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}/"%08d.png "${INTERMEDIATE_CODEC_OPTIONS[@]}" -pix_fmt yuv420p10le "${VIDEO_OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}.mkv" > "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.log" 2>&1 & echo "$!" > "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.pid"
  # ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -framerate ${OUTPUT_FPS} -i "${FRAMES_IN_DIR}/${OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}/"%08d.png -pix_fmt yuv420p10le -c:v libsvtav1 -preset 5 -crf 0 -svtav1-params lossless=1 "${VIDEO_OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}.mkv" > "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.log" 2>&1 & echo "$!" > "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.pid"
  
  MERGING_INTERFRAMES_PROCESS_PID=$(cat "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.pid")
  export MERGING_INTERFRAMES_PROCESS_PID
  local REMOVED_MERGED_FRAMES_UP_TO="0"
  (
    while ps -p ${MERGING_INTERFRAMES_PROCESS_PID} > /dev/null 2>&1
    do
      LAST_MERGED_FFMPEG_FRAME=$(tail -n50 "${LOG}/${FFMPEG_LOCAL_LOG_FILENAME}.log" | grep "frame=" | tail -n1 | awk -F\= '{print $2}')
      BEFORE_LAST_MERGED_FFMPEG_FRAME=$((LAST_MERGED_FFMPEG_FRAME-1))
      BEFORE_LAST_MERGED_FFMPEG_FILE=$(printf "%08d\n" "${BEFORE_LAST_MERGED_FFMPEG_FRAME}")
      if [[ ${LAST_MERGED_FFMPEG_FRAME} =~ ^[0-9]+$ ]]
      then
        CURRENT_MERGED_FRAME_PERCENT="$(echo "(${LAST_MERGED_FFMPEG_FRAME}/${INTER_FRAMES_COUNT}) * 100" | bc -l)"
        CURRENT_MERGED_FRAME_PERCENT="$(printf "%.0f\n" "${CURRENT_MERGED_FRAME_PERCENT}")"
        if [[ ${VERBOSE} == no ]]
        then
          printf "\033[%d;0H\033[2K ${WHITE}f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 15))" "             ${MAGENTA2}currently merged frame ${BROWN}${LAST_MERGED_FFMPEG_FRAME} ${LIGHT_MAGENTA}${CURRENT_MERGED_FRAME_PERCENT} [%] (removed: ${BEFORE_LAST_MERGED_FFMPEG_FILE})" 2>/dev/null
        fi
        remove_numbered_frames "${FRAMES_IN_DIR}/${OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}" "$((REMOVED_MERGED_FRAMES_UP_TO + 1))" "${BEFORE_LAST_MERGED_FFMPEG_FRAME}"
        if [ "${BEFORE_LAST_MERGED_FFMPEG_FRAME}" -gt "${REMOVED_MERGED_FRAMES_UP_TO}" ]
        then
          REMOVED_MERGED_FRAMES_UP_TO="${BEFORE_LAST_MERGED_FFMPEG_FRAME}"
        fi
      fi
      sleep 2
    done
    end_time_collecting
    echo ${RUNTIME} > "${TMP}/MERGING_FRAMES_RUNTIME"
    rm -f -- "${FRAMES_IN_DIR}/${OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}/"*.png
    ) &
  if [[ ${VERBOSE} == yes ]]
  then
    debug "    ffmpeg merging frames into new video PID=${MAGENTA}${MERGING_INTERFRAMES_PROCESS_PID}"
  fi
  }

merging_streams_mkv()
{
  if [ $# -ne 3 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs three parameters: ${YELLOW}VIDEO_FILE_NAME to which subtitles and audio should be merged, ${ORANGE1}VIDEO_IN_DIR, ${DEEPPINK1}VIDEO_OUT_DIR"
    ERROR_CODE="1"
    failed
  else
    local VIDEO_FILE_NAME="${1}"
    local STREAMS_IN_DIR="${2}"
    local VIDEO_OUT_DIR="${3}"
  fi
  local SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  if [[ ${VERBOSE} == yes ]]
  then
    debug "  merging audio and subtitles into new video"
  fi
  start_time_collecting
  # audio and subtitles are optional, so each is added only when it was extracted
  local MERGE_INPUTS=(--language 0:und "${VIDEO_OUT_DIR}/${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}.mkv")
  local MERGE_STEP="merging video"
  if [[ ${AUDIO_EXTRACTED} == yes ]]
  then
    MERGE_INPUTS+=("${STREAMS_IN_DIR}/${VIDEO_FILE_NAME}.mka")
    MERGE_STEP="${MERGE_STEP}, audio"
  fi
  if [ -s "${STREAMS_IN_DIR}/${VIDEO_FILE_NAME}_subtitles.mkv" ]
  then
    MERGE_INPUTS+=("${STREAMS_IN_DIR}/${VIDEO_FILE_NAME}_subtitles.mkv")
    MERGE_STEP="${MERGE_STEP}, subtitles"
  fi
  if [[ ${VERBOSE} == yes ]]
  then
    debug "    mkvmerge --priority lower --output \"${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv\" ${MERGE_INPUTS[*]} --title \"${VIDEO_FILE_NAME}\""
  fi
  mkvmerge --priority lower --output "${VIDEO_FILE_NAME}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv" "${MERGE_INPUTS[@]}" --title "${VIDEO_FILE_NAME}" > "${LOG}/${VIDEO_FILE_NAME}_mkvmerge_merging.log" 2>&1
  mkvtoolnix_status "$?" "${MERGE_STEP}" "${LOG}/${VIDEO_FILE_NAME}_mkvmerge_merging.log"
  end_time_collecting
  echo ${RUNTIME} > "${TMP}/MERGING_STREAMS_RUNTIME"
  }

interpolation_video_file()
{
  if [ $# -ne 1 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs one parameter: ${YELLOW}VIDEO_FILE_NAME which will be managed"
    ERROR_CODE="1"
    failed
  else
    local VIDEO_FILE_NAME="${1}"
    local MOVIE_NAME_ARRAY=("${VIDEO_FILE_NAME%.mkv}")
    local FILE_NAME_EXTENSION=${VIDEO_FILE_NAME: (-3)}
  fi
  local SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  # PIDs already checked by wait_for_step - per chunk, so a reused PID is never skipped
  WAITED_PIDS=""
  inf "  preparation of ${YELLOW}${MOVIE_NAME_ARRAY[*]}${CYAN} (video data analysing)"
  inf "   counting frames of ${YELLOW}${MOVIE_NAME_ARRAY[*]}"
  ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -threads 0 -i "${MOVIE_NAME_ARRAY[*]}.mkv" -map 0:v:0 -c copy -f null - | grep "frame=" | sed "s/frame=//g" | tail -n1 > "${LOG}/${MOVIE_NAME_ARRAY[*]}_frames_count.log" 2>&1 & echo "$!" > "${TMP}/${MOVIE_NAME_ARRAY[*]}_frames_count.pid"
  inf "    analysing video metadata"
  if ! ffprobe -v quiet -print_format json -show_format -show_streams "${MOVIE_NAME_ARRAY[*]}.mkv" > "${TMP}/${MOVIE_NAME_ARRAY[*]}_ffprobe.json" 2>"${LOG}/${MOVIE_NAME_ARRAY[*]}_ffprobe.log"
  then
    error "  video metadata probe (ffprobe) of ${YELLOW}${MOVIE_NAME_ARRAY[*]}.mkv${RED} failed (see log: ${LOG}/${MOVIE_NAME_ARRAY[*]}_ffprobe.log)"
    ERROR_CODE="1"
    failed
  fi
  require_output "${TMP}/${MOVIE_NAME_ARRAY[*]}_ffprobe.json" "video metadata probe (ffprobe)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_ffprobe.log"
  if ! ffprobe -v quiet -print_format json -hide_banner -loglevel warning -select_streams v -show_frames -read_intervals "%+#1" -show_entries "frame=color_space,color_primaries,color_transfer,side_data_list,pix_fmt" -i "${MOVIE_NAME_ARRAY[*]}.mkv" > "${TMP}/${MOVIE_NAME_ARRAY[*]}_mastering_display.json" 2>"${LOG}/${MOVIE_NAME_ARRAY[*]}_mastering_display.log"
  then
    error "  HDR/SDR colour probe (ffprobe) of ${YELLOW}${MOVIE_NAME_ARRAY[*]}.mkv${RED} failed (see log: ${LOG}/${MOVIE_NAME_ARRAY[*]}_mastering_display.log)"
    ERROR_CODE="1"
    failed
  fi
  require_output "${TMP}/${MOVIE_NAME_ARRAY[*]}_mastering_display.json" "HDR/SDR colour probe (ffprobe)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_mastering_display.log"

  inf "    analysing video frame size/color depth"
  mkdir -p "${TMP}/frame_analysis"
  ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -threads 0 -i "${MOVIE_NAME_ARRAY[*]}.mkv" -vf "select=not(mod(n\,100))" -fps_mode vfr "${TMP}/frame_analysis/output%04d.png" > "${LOG}/frame_analysis.log" 2>&1 &
  local FRAME_ANALYSIS_PID=$!
  echo "${FRAME_ANALYSIS_PID}" > "${TMP}/${MOVIE_NAME_ARRAY[*]}_frame_analysis.pid"
  extracting_mkv_streams          "${MOVIE_NAME_ARRAY[*]}"
  # each background step is checked by its own exit code, before the bare "wait" below
  wait_for_step "${FRAME_ANALYSIS_PID}" "frame analysis (ffmpeg)" "${LOG}/frame_analysis.log"
  if [[ -n ${AUDIO_EXTRACT_PID} ]]
  then
    wait "${AUDIO_EXTRACT_PID}"
    # mkvmerge: 1 = warnings (continue), 2 = error (stop)
    mkvtoolnix_status "$?" "audio extraction (mkvmerge)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_extract_sound.log"
  fi
  # subtitles are optional: a failure only drops them from the result
  if [[ -n ${SUBS_EXTRACT_PID} ]]
  then
    wait "${SUBS_EXTRACT_PID}"
    local SUBS_EXTRACT_STATUS=$?
    # mkvmerge exit code 1 means "finished with warnings"
    if [ "${SUBS_EXTRACT_STATUS}" -gt 1 ]
    then
      warn "  subtitles extraction failed (exit code ${SUBS_EXTRACT_STATUS}), continuing without subtitles (see log: ${LOG}/${MOVIE_NAME_ARRAY[*]}_extract_subtitles.log)"
      rm -f -- "${TMP}/${MOVIE_NAME_ARRAY[*]}_subtitles.mkv"
    fi
  fi
  wait
  INPUT_FRAMES_COUNT=$(cat "${LOG}/${MOVIE_NAME_ARRAY[*]}_frames_count.log")
  if [[ ! ${INPUT_FRAMES_COUNT} =~ ^[0-9]+$ ]] || [ "${INPUT_FRAMES_COUNT}" -eq 0 ]
  then
    error "  could not count frames of ${YELLOW}${MOVIE_NAME_ARRAY[*]}.mkv${RED} (got: '${INPUT_FRAMES_COUNT}', see: ${LOG}/${MOVIE_NAME_ARRAY[*]}_frames_count.log)"
    ERROR_CODE="1"
    failed
  fi
  if [[ ${AUDIO_EXTRACTED} == yes ]]
  then
    require_output "${TMP}/${MOVIE_NAME_ARRAY[*]}.mka" "audio extraction" "${LOG}/${MOVIE_NAME_ARRAY[*]}_extract_sound.log"
  fi
  INPUT_FRAMES_LEADING=$(printf "%08d\n" ${INPUT_FRAMES_COUNT})
  INPUT_FPS=$(ffprobe -select_streams v -show_streams "${MOVIE_NAME_ARRAY[*]}.mkv" |& grep -i fps | awk -F"fps" '{print $1}' | awk -F\, '{print $NF}' | sed "s/[[:space:]]\+//g")
  if [[ ! ${INPUT_FPS} =~ ^[0-9]+(\.[0-9]+)?$ ]]
  then
    error "  could not read frame rate of ${YELLOW}${MOVIE_NAME_ARRAY[*]}.mkv${RED} (got: '${INPUT_FPS}')"
    ERROR_CODE="1"
    failed
  fi
  if [[ ${NCNN_METHOD} == dain ]] || [[ ${NCNN_METHOD} == cain ]] || [[ ${NCNN_METHOD} == rife ]]
  then
    TARGET_FRAME_COUNT="2"
    INTER_FRAMES_COUNT=$((INPUT_FRAMES_COUNT*TARGET_FRAME_COUNT))
    OUTPUT_FPS=$(echo "${INPUT_FPS}*${TARGET_FRAME_COUNT}" | bc)
    OUTPUT_FPS_ROUND=$(printf "%.0f\n" ${OUTPUT_FPS})
  elif [[ ${NCNN_METHOD} == realsr ]]
  then
    TARGET_FRAME_SCALE="4"
    INTER_FRAMES_COUNT=${INPUT_FRAMES_COUNT}
    OUTPUT_FPS=${INPUT_FPS}
    OUTPUT_FPS_ROUND="${TARGET_FRAME_SCALE}x"
  else
    error "  NCNN method ${YELLOW}${NCNN_METHOD}${RED} has no frame-count settings in ${FUNCNAME[0]} (supported: rife, dain, cain, realsr)"
    ERROR_CODE="2"
    failed
  fi

  INPUT_FRAMES_INTER_LEADING=$(printf "%08d\n" ${INTER_FRAMES_COUNT})

  local WORK_DIR
  for WORK_DIR in "${TMP}/${IN_DIR}/${MOVIE_NAME_ARRAY[*]}" \
                  "${TMP}/${OUT_DIR}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}" \
                  "${TMP_OUT}/${IN_DIR}/${MOVIE_NAME_ARRAY[*]}" \
                  "${TMP_OUT}/${OUT_DIR}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}"
  do
    if [ -d "${WORK_DIR}" ]
    then
      safe_remove_dir "${WORK_DIR}"
    fi
    mkdir -p "${WORK_DIR}"
  done

  FRAME_COLOR_SPACE="$(mediainfo --Output=JSON "${TMP}/frame_analysis/output0002.png" | jq -r '.media.track[] | select(."@type" != "General").BitDepth')"
  FRAME_BIT_DEPTH="$(mediainfo --Output=JSON "${TMP}/frame_analysis/output0002.png" | jq -r '.media.track[] | select(."@type" != "General").BitDepth')"
  if [[ ${FRAME_BIT_DEPTH} != 8 ]] && [[ ${FRAME_BIT_DEPTH} != 16 ]]
  then
    error "  could not read bit depth of analysed frames (got: '${FRAME_BIT_DEPTH}', expected 8 or 16, see log: ${LOG}/frame_analysis.log)"
    ERROR_CODE="1"
    failed
  fi
  FRAME_DIR_SIZE="$(du -sk "${TMP}/frame_analysis" | awk '{print $1}')"
  FRAME_DIR_AMOUNT="$(ls "${TMP}/frame_analysis" | wc -l)"
  AVERAGE_FRAME_SIZE="$(echo "(${FRAME_DIR_SIZE}/${FRAME_DIR_AMOUNT})/1024" | bc -l)"
  safe_remove_dir "${TMP}/frame_analysis"

  VIDEO_HEIGHT=$(jq '.streams[] | select(.index == 0).height' "${TMP}/${MOVIE_NAME_ARRAY[*]}_ffprobe.json")
  VIDEO_WIDTH=$(jq '.streams[] | select(.index == 0).width' "${TMP}/${MOVIE_NAME_ARRAY[*]}_ffprobe.json")
  VIDEO_DURATION=$(printf "%.0f\n" $(jq -r '.format.duration' "${TMP}/${MOVIE_NAME_ARRAY[*]}_ffprobe.json")) # [s]
  MOVIE_SIZE=$(du -sh "${MOVIE_NAME_ARRAY[*]}.mkv" | awk '{print $1}')
  INPUT_FRAMES_MAX_TSPACE=$(printf "%.0f\n" $(echo "(${AVERAGE_FRAME_SIZE}*${INPUT_FRAMES_COUNT})/1000" | bc -l)) # [MB]
  MAX_INPUT_FRAMES_VAR_OUT_FREE_SPACE=$(echo "((${VAR_OUT_FREE_SPACE}*1000)/${AVERAGE_FRAME_SIZE})" | bc -l)
  MAX_INPUT_SEC_VAR_OUT_FREE_SPACE=$(printf "%.0f\n" $(echo "${MAX_INPUT_FRAMES_VAR_OUT_FREE_SPACE}/${INPUT_FPS}" | bc -l))
  if [ ${FRAME_BIT_DEPTH} -eq 8 ]
  then
    INTER_FRAMES_MAX_TSPACE=$(printf "%.0f\n" $(echo "(${TARGET_FRAME_COUNT}*${AVERAGE_FRAME_SIZE}*${INTER_FRAMES_COUNT})/1000" | bc -l))
  elif [ ${FRAME_BIT_DEPTH} -eq 16 ]
  then
    INTER_FRAMES_MAX_TSPACE=$(printf "%.0f\n" $(echo "(${TARGET_FRAME_COUNT}*(${AVERAGE_FRAME_SIZE}/2)*${INTER_FRAMES_COUNT})/1000" | bc -l))
    AVERAGE_FRAME_SIZE=$(printf "%.0f\n" $(echo "${AVERAGE_FRAME_SIZE}/2" | bc -l))
  fi
  MAX_INTER_FRAMES_VAR_FREE_SPACE=$(echo "((${VAR_FREE_SPACE}*1000)/${AVERAGE_FRAME_SIZE})" | bc -l)
  MAX_INTER_SEC_VAR_FREE_SPACE=$(printf "%.0f\n" $(echo "${MAX_INTER_FRAMES_VAR_FREE_SPACE}/${OUTPUT_FPS}" | bc -l))
  MAX_TSPACE=$((INPUT_FRAMES_MAX_TSPACE+INTER_FRAMES_MAX_TSPACE))
  if [[ ${MAX_TSPACE} == "" ]] || [ ${MAX_TSPACE} -eq 0 ] || [ -z ${MAX_TSPACE} ]
  then
    MAX_TSPACE="1"
  fi

  # empty placeholders 00000001..N, so NCNN sees the full frame count from the start (ffmpeg
  # overwrites them, also numbering from 1); fast enough (~0.3 s per 3000) to run in the foreground
  split --numeric-suffixes=1 -a 8 -n "${INPUT_FRAMES_COUNT}" --additional-suffix=".png" /dev/null "${TMP_OUT}/${IN_DIR}/${MOVIE_NAME_ARRAY[*]}/"
  # split -d -a 8 -n$((INTER_FRAMES_COUNT-1)) --additional-suffix=".png"  /dev/null "${TMP}/${OUT_DIR}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}/" &
  # rm -rf "${TMP}/${OUT_DIR}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}/00000000.png"

  inf "  video details"
  debug "    FILE_NAME=${TEAL}${FILE_NAME}"
  debug "     MOVIE_NAME_ARRAY=${LIGHTGREEN}${MOVIE_NAME_ARRAY[*]}"
  debug "     FILE_NAME_EXTENSION=${PURPLE2}${FILE_NAME_EXTENSION}"
  debug "      VIDEO_SIZE=${CRIMSON}${VIDEO_WIDTH}x${VIDEO_HEIGHT}${DODGERBLUE1}, duration: ${OLIVE}${VIDEO_DURATION} [s]"
  debug "      INPUT_FRAMES_COUNT=${GOLD}${INPUT_FRAMES_COUNT}${DODGERBLUE1} (last file: ${MAROON1}${INPUT_FRAMES_LEADING}.png${DODGERBLUE1}), (max_space for extracted frames: ${MAROON1}${INPUT_FRAMES_MAX_TSPACE} [GB]${DODGERBLUE1}, bit depth ${MAGENTA1}${FRAME_BIT_DEPTH} [bit/channel]${DODGERBLUE1})"
  debug "      INTER_FRAMES_COUNT=${AQUAMARINE}${INTER_FRAMES_COUNT}${DODGERBLUE1} (last file: ${CORAL1}${INPUT_FRAMES_INTER_LEADING}.png${DODGERBLUE1}), (max_space for interpolated frames: ${CORAL1}${INTER_FRAMES_MAX_TSPACE} [GB]${DODGERBLUE1})"
  debug "        INPUT_FPS=${ROYALBLUE2}${INPUT_FPS}"
  debug "        OUTPUT_FPS=${SLATEBLUE1}${OUTPUT_FPS}${DODGERBLUE1} (OUTPUT_FPS_ROUND=${LIGHTSEAGREEN}${OUTPUT_FPS_ROUND})"
  debug "         TARGET_FRAME_COUNT=${LAWNGREEN}${TARGET_FRAME_COUNT}"
  debug "          MAX_TSPACE=${DEEPSKYBLUE2}${MAX_TSPACE} [GB]"
  inf "    preparation of ${YELLOW}${MOVIE_NAME_ARRAY[*]}${CYAN} done successfully ${MAGENTA}${RUNTIME}"
  inf "  directories:"
  inf "    extracting streams (audio/subtitles) -> ${GREENYELLOW}${TMP}"
  inf "    extracting frames                    -> ${LIGHTGREEN}${TMP_OUT} ${CYAN}(${DARKCYAN}${VAR_OUT_FREE_SPACE} [GB], ${MAX_INPUT_SEC_VAR_OUT_FREE_SPACE} [s]${CYAN})"
  inf "    interpolating frames                 -> ${GREENYELLOW}${TMP} ${CYAN}(${DARKCYAN}${VAR_FREE_SPACE} [GB] ${MAX_INTER_SEC_VAR_FREE_SPACE} [s]${CYAN})"

  inf "    merging frames                       from ${GREENYELLOW}${TMP}${CYAN} -> ${LIGHTGREEN}${TMP_OUT}"
  inf "    merging streams                      -> ${GREENYELLOW}./ "
  wait
  end_time_collecting
  VIDEO_ANALYSIS_RUNTIME=${RUNTIME}
  echo ${VIDEO_ANALYSIS_RUNTIME} > "${TMP}/VIDEO_ANALYSIS_RUNTIME"
  inf "    analysis, calculations and all other preparations of ${YELLOW}${MOVIE_NAME_ARRAY[*]}${CYAN} done successfully ${MAGENTA}${RUNTIME}"
  # preparation, analysis, all calculations and information - END

  # actual process
  tput civis
  # it will eliminate part of frame analysis as not needed anymore
  converting_hdr2sdr              "${MOVIE_NAME_ARRAY[*]}"
  extracting_mkv_frames           "${MOVIE_NAME_ARRAY[*]}"            "${TMP_OUT}"    "${TMP}"
  if [[ ${VERBOSE} == yes ]]
  then
    warn "      VERBOSE, so waiting till the end of extracting_mkv_frames function"
    wait_for_step "${FFMPEG_EX_BACKGROUND_PROCESS_PID}" "frames extraction (ffmpeg)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_inter_inframes.log"
    wait
  fi
  interpolating_extracted_frames  "${MOVIE_NAME_ARRAY[*]}"            "${TMP_OUT}"    "${TMP}"
  if [[ ${VERBOSE} == yes ]]
  then
    warn "      VERBOSE, so waiting till the end of interpolating_extracted_frames function"
  fi
  if [[ ${VERBOSE} == no ]]
  then
    checking_space_background       "${NCNN_BACKGROUND_PROCESS_PID}"    "${TMP_OUT}"    "${TMP}"
  fi
  # NCNN that stops early (e.g. invalid GPU) is reported at once, not only after the extraction;
  # meanwhile NCNN is kept behind the extraction (throttling_ncnn)
  NCNN_PAUSED="no"
  while ps -p "${FFMPEG_EX_BACKGROUND_PROCESS_PID}" > /dev/null 2>&1
  do
    if ! ps -p "${NCNN_BACKGROUND_PROCESS_PID}" > /dev/null 2>&1
    then
      wait_for_step "${NCNN_BACKGROUND_PROCESS_PID}" "interpolation (${NCNN_METHOD}-ncnn-vulkan)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_ncnn_${NCNN_METHOD}.log"
      break
    fi
    throttling_ncnn "${NCNN_BACKGROUND_PROCESS_PID}" "${LOG}/${MOVIE_NAME_ARRAY[*]}_inter_inframes.log" "${LOG}/${MOVIE_NAME_ARRAY[*]}_ncnn_${NCNN_METHOD}.log"
    sleep 1
  done
  resuming_ncnn "${NCNN_BACKGROUND_PROCESS_PID}"
  wait_for_step "${FFMPEG_EX_BACKGROUND_PROCESS_PID}" "frames extraction (ffmpeg)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_inter_inframes.log"
  wait_for_step "${NCNN_BACKGROUND_PROCESS_PID}" "interpolation (${NCNN_METHOD}-ncnn-vulkan)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_ncnn_${NCNN_METHOD}.log"
  wait
  # NCNN may exit 0 while single frames failed, so its log is checked as the result
  local INTERPOLATING_ERRORS
  INTERPOLATING_ERRORS="$(grep -c fail "${LOG}/${MOVIE_NAME_ARRAY[*]}_ncnn_${NCNN_METHOD}.log")"
  if [ "${INTERPOLATING_ERRORS}" -ne 0 ]
  then
    error "  NCNN reported ${INTERPOLATING_ERRORS} failure(s), log: ${BLUE}${LOG}/${MOVIE_NAME_ARRAY[*]}_ncnn_${NCNN_METHOD}.log"
    ERROR_CODE="1"
    failed
  fi
  merging_frames_mkv              "${MOVIE_NAME_ARRAY[*]}"               "${TMP}"          "${TMP_OUT}"
  if [[ ${VERBOSE} == yes ]]
  then
    warn "      VERBOSE, so waiting till the end of merging_frames_mkv function"
  fi
  if [[ ${VERBOSE} == no ]]
  then
    checking_space_background       "${MERGING_INTERFRAMES_PROCESS_PID}"   "${TMP_OUT}"      "${TMP}"
  fi
  wait_for_step "${MERGING_INTERFRAMES_PROCESS_PID}" "merging processed frames into video (ffmpeg)" "${LOG}/${MOVIE_NAME_ARRAY[*]}_ffmpeg_merging.log"
  wait
  require_output "${TMP_OUT}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}.mkv" "merging processed frames into video" "${LOG}/${MOVIE_NAME_ARRAY[*]}_ffmpeg_merging.log"
  merging_streams_mkv             "${MOVIE_NAME_ARRAY[*]}"               "${TMP}"          "${TMP_OUT}"
  wait
  require_output "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv" "merging streams into processed video" "${LOG}/${MOVIE_NAME_ARRAY[*]}_mkvmerge_merging.log"
}

movie_data_collecting()
{
  if [[ ${VERBOSE} == yes ]]
  then
    debug "  FILE_NAME          = ${FILE_NAME}"
  fi
  MOVIE_NAME="${MOVIE_NAME_ARRAY[*]##*/}"
  MOVIE_NAME_URL_ENC=$(jq -rn --arg movie_name_array "${MOVIE_NAME_ARRAY[*]}" '$movie_name_array|@uri')
  MOVIE_METADATA_FILENAME="${MOVIE_NAME_ARRAY[*]}_metadata"
  MOVIE_METADATA_FILENAME_LOCAL="${MOVIE_METADATA_FILENAME}_local"
  MOVIE_METADATA_FILENAME_OMDB="${MOVIE_METADATA_FILENAME}_omdb_api"
  MOVIE_METADATA_FILENAME_OMDB_SERIES="${MOVIE_METADATA_FILENAME}_omdb_api_series"
  MOVIE_METADATA_FILENAME_THEMOVIEDB="${MOVIE_METADATA_FILENAME}_themoviedb_api"
  mediainfo --Output=JSON "${MOVIE_NAME_ARRAY[*]}.mkv" | jq -r > "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mediainfo.json" 2>"${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mediainfo.log"
  require_output "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mediainfo.json" "reading local metadata (mediainfo)" "${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mediainfo.log"
  ffprobe -v quiet -print_format json -show_format -show_streams "${MOVIE_NAME_ARRAY[*]}.mkv" > "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_ffprobe.json" 2>"${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_ffprobe.log"
  require_output "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_ffprobe.json" "reading local metadata (ffprobe)" "${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_ffprobe.log"
  ln -sf "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_ffprobe.json" "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.json"
  mkvmerge -J "${MOVIE_NAME_ARRAY[*]}.mkv" > "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json" 2>"${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.log"
  mkvtoolnix_status "$?" "reading track list (mkvmerge -J)" "${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.log"
  MOVIE_SIZE=$(du -sh "${FILE_NAME}" | awk '{print $1}')
  MOVIE_METADATA_ENCODER_LOCAL=$(jq -r '.container.properties.writing_application' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json")
  IMDB_ID_LOCAL="$(jq -r '.format.tags.imdbID' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.json")"
  THEMOVIEDB_ID_LOCAL="$(jq -r '.format.tags.themoviedbID' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.json")"

  if [ ! -z ${IMDB_ID_LOCAL} ] && [[ ${IMDB_ID_LOCAL} != null ]]
  then
    IMDB_ID="${IMDB_ID_LOCAL}"
  elif [ ! -z ${IMDB_ID_PROVIDED} ]
  then
    IMDB_ID="${IMDB_ID_PROVIDED}"
  else
    error "  imdbID was neither in file metadata, nor provided"
    ERROR_CODE="2"
    failed
  fi
  if [ -z "${OMDB_API_KEY}" ]
  then
    if [[ ${UPDATE} == yes ]]
    then
      error "  OMDB_API_KEY is not set; refusing to update metadata (-u) without OMDb data"
      ERROR_CODE="2"
      failed
    fi
    warn "  OMDB_API_KEY is not set; OMDb details will be empty"
  fi
  if [ -z "${THEMOVIEDB_API3_KEY}" ]
  then
    warn "  THEMOVIEDB_API3_KEY is not set; TheMovieDB details and poster will be skipped"
  fi
  curl -s --request GET --url "http://www.omdbapi.com/?apikey=${OMDB_API_KEY}&i=${IMDB_ID}&plot=full" | jq -r > "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json" 2>"${LOG}/${MOVIE_METADATA_FILENAME_OMDB}.log"
  # OMDb answers HTTP 200 also for errors, with {"Response":"False","Error":"..."}
  OMDB_RESPONSE="$(jq -r '.Response // empty' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json" 2>/dev/null)"
  if [[ ${OMDB_RESPONSE} != "True" ]]
  then
    OMDB_ERROR="$(jq -r '.Error // empty' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json" 2>/dev/null)"
    if [[ ${UPDATE} == yes ]]
    then
      error "  OMDb lookup of ${YELLOW}${IMDB_ID}${RED} failed: ${OMDB_ERROR:-no valid response}; refusing to write empty metadata (-u)"
      ERROR_CODE="1"
      failed
    fi
    warn "  OMDb lookup of ${IMDB_ID} failed: ${OMDB_ERROR:-no valid response}"
  fi
  # TheMovieDB is optional: without a key or on a failed request its block below is skipped
  rm -f -- "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"
  if [ -n "${THEMOVIEDB_API3_KEY}" ]
  then
    if ! curl -sf --request GET --url "https://api.themoviedb.org/3/find/${IMDB_ID}?api_key=${THEMOVIEDB_API3_KEY}&external_source=imdb_id" > "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json" 2>"${LOG}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.log"
    then
      warn "  TheMovieDB lookup of ${IMDB_ID} failed (see log: ${LOG}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.log)"
      rm -f -- "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"
    fi
  fi
  # the same result that was checked above decides whether OMDb data is read
  if [[ ${OMDB_RESPONSE} == "True" ]]
  then
    OMDB_API_IMDB_ID="$(jq -r '.imdbID' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_API_TITLE="$(jq -r '.Title' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")" # -> "Type": "movie" -> movie title
    OMDB_API_TYPE="$(jq -r '.Type' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_API_YEAR="$(jq -r '.Year' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_RELEASED_API="$(jq -r '.Released' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    if [[ ${OMDB_API_TYPE} == "episode" ]]
    then
      # particular episode
      OMDB_API_IMDBSERIESID_API="$(jq -r '.seriesID' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
      curl -s --request GET --url "http://www.omdbapi.com/?apikey=${OMDB_API_KEY}&i=${OMDB_API_IMDBSERIESID_API}&plot=full" | jq -r > "${TMP}/${MOVIE_METADATA_FILENAME_OMDB_SERIES}.json" 2>"${LOG}/${MOVIE_METADATA_FILENAME_OMDB_SERIES}.log"
      if [[ "$(jq -r '.Response // empty' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB_SERIES}.json" 2>/dev/null)" != "True" ]]
      then
        warn "  OMDb series lookup of ${OMDB_API_IMDBSERIESID_API} failed: $(jq -r '.Error // "no valid response"' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB_SERIES}.json" 2>/dev/null)"
      fi
      OMDB_EPISODE_TITLE_API="${OMDB_API_TITLE}" # -> title of an episode, not the series itself
      OMDB_SEASON_API="$(jq -r '.Season' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
      OMDB_EPISODE_API="$(jq -r '.Episode' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
      # whole series
      OMDB_SERIES_TITLE_API="$(jq -r '.Title' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB_SERIES}.json")"
      OMDB_SERIES_TOTALSEASONS_API="$(jq -r '.totalSeasons' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB_SERIES}.json")"
      OMDB_SERIES_PLOT_API="$(jq -r '.Plot' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB_SERIES}.json")"
    elif [[ ${OMDB_API_TYPE} == "movie" ]]
    then
      OMDB_BOXOFFICE_API="$(jq -r '.BoxOffice' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
      OMDB_PRODUCTION_API="$(jq -r '.Production' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    fi
    OMDB_RUNTIME_API="$(jq -r '.Runtime' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_GENRE_API="$(jq -r '.Genre' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_DIRECTOR_API="$(jq -r '.Director' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_WRITER_API="$(jq -r '.Writer' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_ACTORS_API="$(jq -r '.Actors' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_API_PLOT="$(jq -r '.Plot' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_API_LANGUAGE="$(jq -r '.Language' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_API_COUNTRY="$(jq -r '.Country' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_AWARDS_API="$(jq -r '.Awards' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_API_METACRITIC="$(jq -r '.Metascore + "%"' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_IMDBRATING_API="$(jq -r '.imdbRating' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
    OMDB_IMDBVOTES_API="$(jq -r '.imdbVotes' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")"
  fi
  # OMDB

  # TheMovieDB
  if [ -s "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json" ]
  then
    THEMOVIEDB_ID_API=$(jq -r '.movie_results[].id' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
    if [ ! -z ${THEMOVIEDB_ID_API} ]
    then
      THEMOVIEDB_TYPE_API=$(jq -r '.movie_results[].media_type' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_TITLE_API="$(jq -r '.movie_results[].original_title' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)"
      THEMOVIEDB_POSTER_URL_API="$(jq -r '.movie_results[].poster_path' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)"
      THEMOVIEDB_POSTER_URL_API_FORMAT="$(echo ${THEMOVIEDB_POSTER_URL_API} | awk -F\. '{print $NF}')"
      THEMOVIEDB_RELEASE_DATE_API=$(jq -r '.movie_results[].release_date' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_RATING_API=$(jq -r '.movie_results[].vote_average' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_PLOT_API=$(jq -r '.movie_results[].overview' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null) 
      THEMOVIEDB_POSTER_URL_API="https://image.tmdb.org/t/p/original$(cat "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json" | jq -r '.movie_results[].poster_path')"
    else
      inf "It looks like it is not a \"movie\", rather episode of a series"
      THEMOVIEDB_ID_API=$(jq -r '.tv_episode_results[].id' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_TYPE_API=$(jq -r '.tv_episode_results[].media_type' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_TITLE_API="$(jq -r '.tv_episode_results[].name' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)"
      THEMOVIEDB_POSTER_URL_API="$(jq -r '.tv_episode_results[].poster_path' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)"
      THEMOVIEDB_POSTER_URL_API_FORMAT="$(echo ${THEMOVIEDB_POSTER_URL_API} | awk -F\. '{print $NF}')"
      THEMOVIEDB_RELEASE_DATE_API=$(jq -r '.tv_episode_results[].air_date' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_RATING_API=$(jq -r '.tv_episode_results[].vote_average' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_PLOT_API=$(jq -r '.tv_episode_results[].overview' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json"  2>/dev/null)
      THEMOVIEDB_POSTER_URL_API="https://image.tmdb.org/t/p/original$(jq -r '.tv_episode_results[].still_path' "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}.json")"
    fi
    if [ -z "${THEMOVIEDB_ID_API}" ]
    then
      warn "  TheMovieDB returned neither a movie nor an episode for ${IMDB_ID}; poster and TheMovieDB plot skipped"
    elif ! wget -q "${THEMOVIEDB_POSTER_URL_API}" -O "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg"
    then
      warn "  poster download failed: ${THEMOVIEDB_POSTER_URL_API}"
    fi
    if [ -s "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg" ]
    then
      THEMOVIEDB_POSTER_URL_API_FORMAT=$(mediainfo --Output=JSON "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg" | jq -r '.media.track[] | select(."@type" == "Image").Format')
      THEMOVIEDB_POSTER_URL_API_HEIGHT=$(mediainfo --Output=JSON "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg" | jq -r '.media.track[] | select(."@type" == "Image").Height')
      THEMOVIEDB_POSTER_URL_API_WIDTH=$(mediainfo --Output=JSON "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg" | jq -r '.media.track[] | select(."@type" == "Image").Width')
      THEMOVIEDB_POSTER_SIZE=$(du -sk "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg" | awk '{print $1}')
    fi
  fi
  # TheMovieDB
  if [ -s "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg" ]
  then
    POSTER_SIZE=${THEMOVIEDB_POSTER_SIZE}
    POSTER_HEIGHT=${THEMOVIEDB_POSTER_URL_API_HEIGHT}
    POSTER_WIDTH=${THEMOVIEDB_POSTER_URL_API_WIDTH}
    if ! sudo cp "${TMP}/${MOVIE_METADATA_FILENAME_THEMOVIEDB}_poster.jpg" "${MOVIE_NAME_ARRAY[*]}.mkv.cover.jpg"
    then
      warn "  could not save cover: ${MOVIE_NAME_ARRAY[*]}.mkv.cover.jpg"
    fi
  fi
  }

imdb_management()
{
  MOVIE_NAME="${MOVIE_NAME_ARRAY[*]##*/}"
  local PROPEDIT_LOG="${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvpropedit.log"
  inf "    adding/updating mkv file with OMDB ID to: ${BROWN}${IMDB_ID}"
  if ! mkvpropedit "${MOVIE_NAME_ARRAY[*]}.mkv" --tags all: >> "${PROPEDIT_LOG}" 2>&1
  then
    warn "  existing tags could not be cleared (see log: ${PROPEDIT_LOG}); they will be replaced by global tags"
  fi
  echo "<?xml version=1.0?>
  <Tags>
    <Tag>" > "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"

  if [[ ${OMDB_API_TYPE} == "episode" ]]
  then
    echo "      <Simple><Name>IMDbID (series IMDbID)</Name><String>${OMDB_API_IMDB_ID} (${OMDB_API_IMDBSERIESID_API})</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>TheMovieDbID</Name><String>${THEMOVIEDB_ID_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>titles</Name><String>${OMDB_EPISODE_TITLE_API} (${OMDB_SERIES_TITLE_API})</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>seasons/episodes</Name><String>S${OMDB_SEASON_API}, E${OMDB_EPISODE_API} (seasons: ${OMDB_SERIES_TOTALSEASONS_API})</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>_series_plot</Name><String>${OMDB_SERIES_PLOT_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>_episode_plot (OMDb)</Name><String>${OMDB_API_PLOT}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>_episode_plot (TheMovieDb)</Name><String>${THEMOVIEDB_PLOT_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  elif [[ ${OMDB_API_TYPE} == "movie" ]]
  then
    echo "      <Simple><Name>IMDbID</Name><String>${OMDB_API_IMDB_ID}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>TheMovieDbID</Name><String>${THEMOVIEDB_ID_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>title</Name><String>${OMDB_API_TITLE}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>_OMDb_plot</Name><String>${OMDB_API_PLOT}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>_TheMovieDb_plot</Name><String>${THEMOVIEDB_PLOT_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>boxoffice</Name><String>${OMDB_BOXOFFICE_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
    echo "      <Simple><Name>production</Name><String>${OMDB_PRODUCTION_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  fi
  echo "      <Simple><Name>released</Name><String>${OMDB_RELEASED_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  echo "      <Simple><Name>runtime</Name><String>${OMDB_RUNTIME_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  echo "      <Simple><Name>genre</Name><String>${OMDB_GENRE_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  echo "      <Simple><Name>director</Name><String>${OMDB_DIRECTOR_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  echo "      <Simple><Name>actors</Name><String>${OMDB_ACTORS_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  echo "      <Simple><Name>language</Name><String>${OMDB_API_LANGUAGE}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml" # -> may be useful for setting default language in a movie
  echo "      <Simple><Name>country</Name><String>${OMDB_API_COUNTRY}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  if [[ ${OMDB_AWARDS_API} != "N/A" ]] && [[ ${OMDB_AWARDS_API} != "" ]]
  then
    echo "      <Simple><Name>awards</Name><String>${OMDB_AWARDS_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  fi

  #if [[ ${OMDB_API_METACRITIC} != "N/A%" ]] && [[ ${OMDB_API_METACRITIC} != "" ]]
  #then
  #  echo "      <Simple><Name>metacritic</Name><String>${OMDB_API_METACRITIC}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  #fi
  #if [[ ${OMDB_IMDBRATING_API} != "N/A%" ]] && [[ ${OMDB_IMDBRATING_API} != "" ]]
  #then
  #  echo "      <Simple><Name>IMDb rating</Name><String>${OMDB_IMDBRATING_API}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  #fi
  IFS=${NEWIFS}
  for OMDB_API_RATING in $(jq -r '.Ratings[] | .Source + "~" + .Value' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")
  do
    OMDB_API_RATING_SOURCE=$(echo ${OMDB_API_RATING} | awk -F\~ '{print $1}' | sed "s/[[:space:]]/_/g")
    OMDB_API_RATING_RATING=$(echo ${OMDB_API_RATING} | awk -F\~ '{print $2}')
    echo "      <Simple><Name>_${OMDB_API_RATING_SOURCE}_rating</Name><String>${OMDB_API_RATING_RATING}</String></Simple>" >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"
  done
  IFS=${ORIGIFS}

  echo "     </Tag>
  </Tags>"  >> "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml"

  if [[ $(mkvmerge -J "${MOVIE_NAME_ARRAY[*]}.mkv"  | jq -r '.tracks[].properties | select(.language == "pol")') != "" ]]
  then
    if ! sudo mkvpropedit --edit track:$(mkvmerge -J "${MOVIE_NAME_ARRAY[*]}.mkv"  | jq -r '.tracks[].properties | select(.language == "pol").number') --set flag-default=1 "${MOVIE_NAME_ARRAY[*]}.mkv" >> "${PROPEDIT_LOG}" 2>&1
    then
      warn "  could not mark the Polish track as default (see log: ${PROPEDIT_LOG})"
    fi
  fi
  sudo mkvpropedit "${MOVIE_NAME_ARRAY[*]}.mkv" --tags global:"${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.xml" >> "${PROPEDIT_LOG}" 2>&1
  mkvtoolnix_status "$?" "writing metadata tags" "${PROPEDIT_LOG}"
  sudo mkvpropedit "${MOVIE_NAME_ARRAY[*]}.mkv" -e info -s title="${OMDB_API_TITLE}" >> "${PROPEDIT_LOG}" 2>&1
  mkvtoolnix_status "$?" "writing title" "${PROPEDIT_LOG}"
  }

movie_processing_end()
{
  if [[ ${UPDATE} == yes ]]
  then
    mkv_cleaning
    if ! sudo chmod 664 "${MOVIE_NAME_ARRAY[*]}"*
    then
      warn "  could not set permissions (664) on ${MOVIE_NAME_ARRAY[*]}*"
    fi
    if ! sudo chown nobody:minidlna "${MOVIE_NAME_ARRAY[*]}"* > /dev/null 2>&1
    then
      warn "  could not set owner nobody:minidlna on ${MOVIE_NAME_ARRAY[*]}*"
    fi
  fi
  }

mkv_cleaning()
{
  if [[ ${UPDATE} == yes ]]
  then
    if [[ ${VERBOSE} == yes ]]
    then
      debug ""
      debug "    ${WINE}Removing internal attachement (cover, text file etc.) from a movie: ${YELLOW}${MOVIE_NAME_ARRAY[*]}"
    fi
    if ! mkvpropedit "${MOVIE_NAME_ARRAY[*]}.mkv" --delete-attachment mime-type:image/jpeg --delete-attachment mime-type:image/png --delete-attachment mime-type:text/plain >> "${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvpropedit.log" 2>&1
    then
      warn "  removing attachments reported a problem (often just: nothing to remove), see log: ${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvpropedit.log"
    fi
    if [[ ${VERBOSE} == yes ]]
    then
      debug ""
      debug "    ${WINE}Removing chapters from a movie: ${YELLOW}${MOVIE_NAME_ARRAY[*]}"
    fi
    if ! mkvpropedit "${MOVIE_NAME_ARRAY[*]}.mkv" --chapters "" >> "${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvpropedit.log" 2>&1
    then
      warn "  removing chapters reported a problem, see log: ${LOG}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvpropedit.log"
    fi
  fi
  }

subtitles_management()
{
  if [ -f "${MOVIE_NAME_ARRAY[*]}.txt" ]
  then
    MOVIE_SUBTITLE="${MOVIE_NAME_ARRAY[*]}.txt"
    if [[ ${VERBOSE} == yes ]]
    then
      debug "  There is a subtitle: ${BROWN}${MOVIE_SUBTITLE}"
    fi
  elif [ -f "${MOVIE_NAME_ARRAY[*]}.srt" ]
  then
    MOVIE_SUBTITLE="${MOVIE_NAME_ARRAY[*]}.srt"
    if [[ ${VERBOSE} == yes ]]
    then
      debug "  There is a subtitle: ${BROWN}${MOVIE_SUBTITLE}"
    fi
  elif [ -f "${MOVIE_NAME_ARRAY[*]}.sub" ] && [ -f "${MOVIE_NAME_ARRAY[*]}.idx" ]
  then
    MOVIE_SUBTITLE="${MOVIE_NAME_ARRAY[*]}.sub"
    if [[ ${VERBOSE} == yes ]]
    then
      debug "  There is a subtitle :${BROWN}${MOVIE_SUBTITLE}${CYAN} (with index)"
    fi
  else
    if [[ ${VERBOSE} == yes ]]
    then
      error "    There is no subtitle for a movie: ${YELLOW}${MOVIE_NAME_ARRAY[*]}${RED}, downloading..."
    fi
    if ! subliminal --opensubtitles kamoyl ${OPENSUBTITLE_TRACKS_PASSWORD} --provider opensubtitles --provider argenteam --provider shooter --provider thesubdb --provider tvsubtitles -l pl -e UTF8 -s "${MOVIE_NAME_ARRAY[*]}.mkv" > /dev/null 2>&1
    then
      warn "  subtitles download (subliminal) for ${MOVIE_NAME_ARRAY[*]} failed"
    fi
  fi
}

encoding_process_details()
{
  DESTINATION_DIR="/media/ready"
  if [[ ${ANIMATION} == yes ]]
  then
    # doc: https://keithwiley.com/astroPhotography/imageSharpening.shtml
    OPTIMIZATION="animation"
  elif [[ ${GRAIN} == yes ]]
  then
    OPTIMIZATION="grain"
  elif [[ ${HIGHMOTION} == yes ]]
  then
    OPTIMIZATION="highmotion"
  else
    OPTIMIZATION="film"
  fi

  # aq-mode=4 from aq-mode=1
  # VIDEO_ENCODER=(x265_10bit --quality 18 --nlmeans-tune ${OPTIMIZATION} --lapsharp-tune ${OPTIMIZATION} --encopts strong-intra-smoothing=0:rect=0:aq-mode=4)
  # --cqp 1-70 (ffmpeg) -> --quality 22 (HandBrake)
  # --input-depth {8, 10}, default is 10bit, and to do 10bit out of 8bit source, it needs conversion first, or svt_av1_10bit -> svt_av1
  # VIDEO_ENCODER=(svt_av1_10bit --quality 22 --encoder-preset 5 --nlmeans-tune ${OPTIMIZATION} --lapsharp-tune ${OPTIMIZATION} --encopts aq-mode=2)
  # VIDEO_ENCODER=(svt_av1 -quality 22 --encoder-preset 5 --nlmeans-tune ${OPTIMIZATION} --lapsharp-tune ${OPTIMIZATION} --encopts rc=1:tune=0:enable-overlays=1:scd=1)
  
  VIDEO_ENCODER=(svt_av1_10bit --quality 22 --encoder-preset 5 --nlmeans-tune ${OPTIMIZATION} --lapsharp-tune ${OPTIMIZATION} --encopts tune=0:enable-overlays=1:aq-mode=2)
  AUDIO_ENCODER="copy"
  DISPLAY_DIMENSIONS=$(jq -r '.tracks[] | select(.type == "video").properties.display_dimensions' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json")
  PIXEL_DIMENTIONS=$(jq -r '.tracks[] | select(.type == "video").properties.pixel_dimensions' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json")
  debug "      DISPLAY_DIMENSIONS=${DISPLAY_DIMENSIONS}"
  debug "      PIXEL_DIMENTIONS=${PIXEL_DIMENTIONS}"
  for TRACK_TYPE in $(jq -r '.tracks[].type' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json" | sort -u)
  do
    debug "  for TRACK_TYPE = ${TRACK_TYPE}"
    for TRACK_ID in $(jq -r --arg track_type ${TRACK_TYPE} '.tracks[] | select(.type == $track_type).id' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json")
    do
      TRACK_CODEC=$(jq -r --arg track_type ${TRACK_TYPE} --arg track_id ${TRACK_ID} '.tracks[] | select(.type == $track_type) | select((.id|tostring) == $track_id).codec' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json")
      TRACK_LANGUAGE=$(jq -r --arg track_type ${TRACK_TYPE} --arg track_id ${TRACK_ID} '.tracks[] | select(.type == $track_type) | select((.id|tostring) == $track_id).properties.language' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}_mkvmerge.json")
      debug "    TRACK_ID=${TRACK_ID}, TRACK_CODEC=${TRACK_CODEC}, TRACK_LANGUAGE=${TRACK_LANGUAGE}"
    done
  done
  # HandBrakeCLI -a counts audio tracks from 1 (not ffprobe stream indexes, which include video and subtitles)
  AUDIO_TRACKS=$(jq -r '[.streams[] | select(.codec_type == "audio")] | to_entries[] | select(.value.tags.language == "eng" or .value.tags.language == "pol" or .value.tags.language == "dut" or .value.tags.language == "nld").key + 1' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.json" | tr '\n' ',' | sed "s/,$//g")
  if [ -z "${AUDIO_TRACKS}" ]
  then
    AUDIO_TRACKS=$(jq -r '[.streams[] | select(.codec_type == "audio")] | to_entries[] | .key + 1' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.json" | tr '\n' ',' | sed "s/,$//g")
    if [ -n "${AUDIO_TRACKS}" ]
    then
      warn "  no eng/pol/dut audio track found, encoding all audio tracks (${AUDIO_TRACKS})"
    fi
  fi
  inf "    encoding AUDIO_TRACKS=${MAGENTA}${AUDIO_TRACKS}"
  SUBTITLE_TRACKS=$(jq -r '.streams[] | select(.codec_type == "subtitle") | select(.tags.language == "eng" or .tags.language == "pol" or .tags.language == "dut").index' "${TMP}/${MOVIE_METADATA_FILENAME_LOCAL}.json" | tr '\n' ',' | sed "s/,$//g")
  inf "    encoding SUBTITLE_TRACKS=${MAGENTA}${SUBTITLE_TRACKS}"
  # audio and subtitles are optional: without matching tracks HandBrakeCLI gets "none"
  if [ -n "${AUDIO_TRACKS}" ]
  then
    HANDBRAKE_STREAMS=(-E "${AUDIO_ENCODER}" -a "${AUDIO_TRACKS}")
  else
    warn "  no audio track found, encoding without audio"
    HANDBRAKE_STREAMS=(-a none)
  fi
  if [ -n "${SUBTITLE_TRACKS}" ]
  then
    # shellcheck disable=SC2054  # HandBrakeCLI expects a comma separated language list
    HANDBRAKE_STREAMS+=(--subtitle-lang-list eng,pol,dut --all-subtitles)
  else
    warn "  no eng/pol/dut subtitle track found, encoding without subtitles"
    HANDBRAKE_STREAMS+=(-s none)
  fi
  inf "    nohup HandBrakeCLI -i \"${MOVIE_NAME_ARRAY[*]}.mkv\" -o \"${DESTINATION_DIR}/${MOVIE_NAME_ARRAY[*]}.mkv\" --encoder ${VIDEO_ENCODER[*]} --no-markers ${HANDBRAKE_STREAMS[*]} > \"${DESTINATION_DIR}/${MOVIE_NAME_ARRAY[*]}.mkv.log\" 2>&1 &"
  }

encoding_process()
{
  encoding_process_details
  if [ ! -d "${DESTINATION_DIR}" ] || [ ! -w "${DESTINATION_DIR}" ]
  then
    error "  destination directory does not exist or is not writable: ${YELLOW}${DESTINATION_DIR}"
    ERROR_CODE="1"
    failed
  fi
  local ENCODING_LOG="${DESTINATION_DIR}/${MOVIE_NAME_ARRAY[*]}.mkv.log"
  nohup HandBrakeCLI -i "${MOVIE_NAME_ARRAY[*]}.mkv" -o "${DESTINATION_DIR}/${MOVIE_NAME_ARRAY[*]}.mkv" --encoder "${VIDEO_ENCODER[@]}" --no-markers "${HANDBRAKE_STREAMS[@]}" > "${ENCODING_LOG}" 2>&1 &
  ENCODING_PID=$!
  # catch the most common failures (bad option, unreadable input) which end HandBrakeCLI within seconds
  sleep 3
  if ! kill -0 "${ENCODING_PID}" 2>/dev/null
  then
    wait "${ENCODING_PID}"
    local ENCODING_STATUS=$?
    if [ "${ENCODING_STATUS}" -ne 0 ]
    then
      error "  HandBrakeCLI stopped right after start with exit code ${ENCODING_STATUS} (see log: ${ENCODING_LOG})"
      ERROR_CODE="1"
      failed
    fi
    inf "    encoding finished: ${YELLOW}${DESTINATION_DIR}/${MOVIE_NAME_ARRAY[*]}.mkv"
  else
    inf "    encoding STARTED in the background (pid ${MAGENTA}${ENCODING_PID}${CYAN}) - it is NOT finished yet"
    inf "    progress and result: ${YELLOW}${ENCODING_LOG}"
  fi
  }

encoding_quality_metric()
{
  if [ $# -ne 2 ]
  then
    error "Function ${LIME}${FUNCNAME[0]}${RED} needs two parameters: ${YELLOW}ENCODED_VIDEO_FILE, ${ORANGE1}REFERENCE_VIDEO_FILE"
    ERROR_CODE="1"
    failed
  else
    ENCODED_VIDEO_FILE="${1}"
    REFERENCE_VIDEO_FILE="${2}"
  fi
  SHOW_FUNCTION_NAME=${FUNCNAME[0]}
  start_time_collecting
  # interpolation (rife/dain/cain) puts TARGET_FRAME_COUNT output frames per original frame:
  # output 0 = original 0, output 1 = in-between, output 2 = original 1, ...
  # in-between frames have no reference, so only every VMAF_FRAME_STEP-th frame is compared;
  # setpts renumbers both inputs, so frame N is paired with frame N
  local VMAF_FRAME_STEP="${TARGET_FRAME_COUNT:-1}"
  local VMAF_THREADS
  VMAF_THREADS="$(nproc 2>/dev/null)"
  if [[ ! ${VMAF_THREADS} =~ ^[0-9]+$ ]]
  then
    VMAF_THREADS="1"
  fi
  local VMAF_FRAMES_COUNT=$((INTER_FRAMES_COUNT / VMAF_FRAME_STEP))
  # an HDR reference is tone-mapped the same way as the extracted frames were (converting_hdr2sdr)
  local REFERENCE_FILTER=""
  if [ -n "${TONE_MAPPING_FILTER}" ]
  then
    REFERENCE_FILTER="${TONE_MAPPING_FILTER},"
  fi
  # the model file of the Linux packages, otherwise the model built into libvmaf (e.g. Homebrew)
  local VMAF_MODEL="version=vmaf_v0.6.1"
  if [ -s /usr/share/model/vmaf_v0.6.1.json ]
  then
    VMAF_MODEL="path=/usr/share/model/vmaf_v0.6.1.json"
  fi
  local VMAF_GRAPH="[0:v]select='not(mod(n\,${VMAF_FRAME_STEP}))',setpts=N/(${INPUT_FPS}*TB)[distorted];[1:v]${REFERENCE_FILTER}setpts=N/(${INPUT_FPS}*TB)[reference];[distorted][reference]libvmaf=n_threads=${VMAF_THREADS}:model=${VMAF_MODEL}:log_path=${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_vmaf.json:log_fmt=json"
  ffmpeg -y -hide_banner -loglevel error -progress pipe:1 -threads 0 -i "${ENCODED_VIDEO_FILE}" -i "${REFERENCE_VIDEO_FILE}" -lavfi "${VMAF_GRAPH}" -f null - > "${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_quality_metric.log" 2>&1 & echo "$!" > "${TMP}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_quality_metric.pid"
  QUALITY_METRIC_CHECK_PID=$(cat ${TMP}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_quality_metric.pid)
  while ps -p ${QUALITY_METRIC_CHECK_PID} > /dev/null 2>&1
  do
    if [ -s "${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_quality_metric.log" ]
    then
      CURRENT_ANALYSED_FRAME=$(tail -n$((TARGET_FRAME_COUNT*6)) "${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_quality_metric.log" | grep "frame=" | tail -n1 | sed "s/frame=//g")
      CURRENT_ANALYSED_FRAME_PERCENT="$(echo "(${CURRENT_ANALYSED_FRAME}/${VMAF_FRAMES_COUNT}) * 100" | bc -l)"
      CURRENT_ANALYSED_FRAME_PERCENT="$(printf "%.0f\n" "${CURRENT_ANALYSED_FRAME_PERCENT}")"
      if [[ ${VERBOSE} == no ]]
      then
        printf "\033[%d;0H\033[2K ${WHITE}f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 14))" "        ${MAGENTA2}currently analysed frame ${BROWN}${CURRENT_ANALYSED_FRAME} ${LIGHT_MAGENTA}${CURRENT_ANALYSED_FRAME_PERCENT} [%]" 2>/dev/null
      fi
    fi
    # without a pause this loop polls as fast as the CPU allows (busy-wait), competing with ffmpeg
    sleep 2
  done
  wait "${QUALITY_METRIC_CHECK_PID}"
  local QUALITY_METRIC_STATUS=$?
  if [ "${QUALITY_METRIC_STATUS}" -ne 0 ] || [ ! -s "${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_vmaf.json" ]
  then
    # a failed measurement is reported loudly, but does not stop the (long) processing run
    error "  VMAF check failed with exit code ${QUALITY_METRIC_STATUS} (see log: ${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_quality_metric.log)"
    VMAF_MIN="error"
    VMAF_MAX="error"
    VMAF_MEAN="error"
  else
    VMAF_MIN="$(jq -r '.pooled_metrics.vmaf.min' "${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_vmaf.json")"
    VMAF_MAX="$(jq -r '.pooled_metrics.vmaf.max' "${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_vmaf.json")"
    VMAF_MEAN="$(jq -r '.pooled_metrics.vmaf.mean' "${LOG}/${ENCODED_VIDEO_FILE}-${REFERENCE_VIDEO_FILE}_vmaf.json")"
  fi
  end_time_collecting
  echo ${RUNTIME} > "${TMP}/QUALITY_METRIC_RUNTIME"
  printf "\033[%d;0H\033[2K ${WHITE}f:${CHARTREUSE3}${SHOW_FUNCTION_NAME} %s\n" "$((TERMINAL_HEIGHT - 13))" "          ${MAGENTA2}VAMF mean:${BROWN} ${VMAF_MEAN}" 2>/dev/null
  }

reading_cursor_position()
{
  # Source - https://stackoverflow.com/a/6003016
  # Posted by BSK, modified by community. See post 'Timeline' for change history
  # Retrieved 2026-08-06, License - CC BY-SA 4.0
  echo -en "\E[6n"
  read -sdR CURPOS
  CURPOS=${CURPOS#*[}
  echo "${CURPOS}"
  }
