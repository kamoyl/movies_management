#!/usr/bin/env bash

if [[ ${VERBOSE} == yes ]]
then
  debug "${YELLOW}[ ${LIME}$(caller | awk '{print $2}'| awk -F\/ '{print $NF}') ${YELLOW}calls (in line: ${LIME}: ${LIME}$(caller | awk '{print $1}')${YELLOW}) ${LIME}$(echo "${BASH_SOURCE}" | awk -F\/ '{print $NF}') ${YELLOW} ]"
fi

if [ -z "${o}" ]
then
  VAR="${HOME}/var"
  mkdir -p "${VAR}"
else
  VAR=$(readlink -f "${o}")
  if ! mkdir -p "${VAR}" > /dev/null 2>&1
  then
    error "I have no permissions to create OUTPUT directory here:"
    debug "  var=${WINE}${VAR}"
    exit 1
  fi
fi

# always a new directory per run: an inherited TMP (some systems export TMP=/tmp)
# would be shared between runs, so clones and leftovers from earlier runs would collide
TMP="${VAR}/tmp-${SCRIPT_NAME}_${CURRENT_TIMESTAMP}"
mkdir -p "${TMP}"

# the same for LOG: every run writes its own logs, an inherited LOG is ignored
LOG="${VAR}/log-${SCRIPT_NAME}_${CURRENT_TIMESTAMP}"
mkdir -p "${LOG}"

if [ -z "${O}" ]
then
  VAR_OUT="${VAR}"
else
  VAR_OUT=$(readlink -f "${O}")
  if ! mkdir -p "${VAR_OUT}" > /dev/null 2>&1
  then
    error "I have no permissions to create OUTPUT directory here:"
    debug "  var_out=${WINE}${VAR_OUT}"
    exit 1
  fi
fi

if [ -z "${TMP_OUT}" ]
then
  TMP_OUT="${VAR_OUT}/tmp-${SCRIPT_NAME}_${CURRENT_TIMESTAMP}"
  mkdir -p "${TMP_OUT}"
fi

if [ -z "${LOG_OUT}" ]
then
  LOG_OUT="${VAR_OUT}/log-${SCRIPT_NAME}_${CURRENT_TIMESTAMP}"
  mkdir -p "${LOG_OUT}"
fi

VAR_DEV_FREE_SPACE=$(df --block-size G ${VAR} | grep -v 'Filesystem' | awk '{print $1"~"$4}')
VAR_DEV=$(echo ${VAR_DEV_FREE_SPACE} | awk -F\~ '{print $1}')
VAR_FREE_SPACE=$(echo ${VAR_DEV_FREE_SPACE} | awk -F\~ '{print $2}' | sed "s/G//g")
VAR_OUT_DEV_FREE_SPACE=$(df --block-size G ${VAR_OUT} | grep -v 'Filesystem' | awk '{print $1"~"$4}')
VAR_OUT_DEV=$(echo ${VAR_OUT_DEV_FREE_SPACE} | awk -F\~ '{print $1}')
VAR_OUT_FREE_SPACE=$(echo ${VAR_OUT_DEV_FREE_SPACE} | awk -F\~ '{print $2}' | sed "s/G//g")

export VAR
export VAR_FREE_SPACE
export VAR_DEV
export TMP
export LOG
export VAR_OUT
export VAR_OUT_FREE_SPACE
export VAR_OUT_DEV
export TMP_OUT
export LOG_OUT

if [[ ${VERBOSE} == yes ]]
then
  debug "    VAR=${VAR}, space free ${VAR_FREE_SPACE} [GB] on ${VAR_DEV}"
  debug "     TMP=${TMP}"
  debug "     LOG=${LOG}"
  debug "    VAR_OUT=${VAR_OUT}, space free ${VAR_OUT_FREE_SPACE} [GB] on ${VAR_OUT_DEV}"
  debug "     TMP_OUT=${TMP_OUT}"
  debug "     LOG_OUT=${LOG_OUT}"
fi
