echo "video_id~extracting_streams_runtime~extracting_frames_runtime~interpolating_runtime~merging_frames_runtime~merging_streams_runtime~encoding_runtime~quality_check_runtime~max_space [GB]~max_space [%]~${VMAF_COLUMN}~runtime~gpus" > "${TMP}/statistics.txt"
