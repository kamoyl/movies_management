  ERROR_CODE="2"
  failed
fi
if [[ ${WHOLE_VIDEO_IN_ONE_CHUNK} == no ]]
then
  # chunk 001 starts while the later chunks are still being written (waiting_for_split_chunk)
  inf "  splitting video into ${YELLOW}${LAST_VIDEO_FRAGMENT_ID}${CYAN} chunks of about ${SPLIT_TIME_SEC}s in the background"
  starting_split "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log"
