  ERROR_CODE="1"
  failed
fi
VIDEO_LENGTH=$(printf "%.0f\n" "${VIDEO_DURATION_RAW}")

if [[ ${NCNN_METHOD} == none ]]
then
  # no NCNN runs, so HandBrake and VMAF may use the cores kept free for it (NCNN_FREE_CORES)
  ENCODE_PINNING=()
fi

# ffmpeg filters needed for this video and options (tone mapping, VMAF), checked before any work
ffmpeg_feature_checks "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv"

# one VMAF model for the whole run, by the movie's resolution (scores of the two models differ,
# so the report column names it)
VMAF_MODEL=""
VMAF_MODEL_NAME=""
VMAF_COLUMN="VMAF [mean]"
if [[ ${QUALITY_CHECK} == yes ]]
then
  choosing_vmaf_model "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv"
  VMAF_COLUMN="VMAF [mean, ${VMAF_MODEL_NAME}]"
  inf "  VMAF model: ${YELLOW}${VMAF_MODEL_NAME}${CYAN} (${VMAF_MODEL})"
  # with NCNN the reference is tone-mapped to SDR like the frames, without (-N none, -T) it stays HDR
  if [[ ${VMAF_VIDEO_HDR} == yes ]] && { [[ ${NCNN_METHOD} == none ]] || [[ ${TONE_MAPPING} == no ]]; }
  then
