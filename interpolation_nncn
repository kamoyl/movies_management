# -S: the same command again as a transient systemd service in the system slice, run as the
# calling user. Only with root or sudo, by the user's choice: then the service has what the
# interactive run has (the user's groups for the GPU, PATH, HOME) and no fallbacks are needed.
# A system service survives closing the terminal or a logout, and is not in the user slice that
# systemd-oomd watches. It does not protect against the kernel OOM killer (no OOMScoreAdjust, by
# the user's choice); -M (MemoryHigh) throttles the processes before memory runs out.
# KillSignal=SIGINT: systemctl stop sends SIGINT to every process of the service, as Ctrl+C does
# to the terminal's process group, so exit_function runs the Ctrl+C cleanup. Not to the script
# only (KillMode=mixed): bash runs the trap only after its foreground tool (NCNN, ffmpeg) ends,
# which may take longer than TimeoutStopSec; whatever is left after it is killed.
# SELinux: systemd (init_t) may execute only files of executable types; a script in a repository
# has its directory's label (e.g. httpd_sys_content_t) and was refused ("Permission denied" at
# step EXEC). /usr/bin/env is bin_t, so the service runs as unconfined_service_t, the domain of
# any locally installed service, which may read the script: no policy change, no setenforce.
# Everything is checked before (above), so the launcher reports input errors at once instead of
# into the log.
starting_as_service()
{
  local SUDO_COMMAND=()
  if ! type systemd-run > /dev/null 2>&1
  then
    error "  -S runs the script as a systemd service, but systemd-run was not found; run it interactively (without -S)"
    ERROR_CODE="127"
    failed
  fi
  if [ "$(id -u)" -ne 0 ]
  then
    if ! type sudo > /dev/null 2>&1
    then
      error "  -S needs root or sudo to start a system service, but sudo was not found; run it interactively (without -S)"
      ERROR_CODE="127"
      failed
    fi
    inf "  -S: starting a system service needs sudo (it may ask for your password)"
    if ! sudo -v
    then
      error "  -S needs root or sudo to start a system service; run it interactively (without -S)"
      ERROR_CODE="1"
      failed
    fi
    SUDO_COMMAND=(sudo)
  fi
  # a recognizable name: the movie and the run's timestamp (the same as in its log directory);
  # systemd allows only letters, digits and ":_.-\" in unit names
  local UNIT_MOVIE_NAME="${FILE_NAME%.*}"
  UNIT_MOVIE_NAME="$(printf '%s' "${UNIT_MOVIE_NAME}" | tr -c 'A-Za-z0-9_.-' '_' | tr -s '_')"
  local UNIT_NAME="interpolation-${UNIT_MOVIE_NAME:0:80}-${CURRENT_TIMESTAMP}"
  local SERVICE_PROPERTIES=(-p KillSignal=SIGINT -p TimeoutStopSec=120)
  if [ -n "${MEMORY_HIGH}" ]
  then
    SERVICE_PROPERTIES+=(-p "MemoryHigh=${MEMORY_HIGH}")
  fi
  # the service starts with a clean environment, so the settings read from it (set by the caller or
  # defaulted by .config_video) are passed on; without them they would silently fall back to defaults
  local SERVICE_ENVIRONMENT=(
    --setenv=INTERMEDIATE_CODEC="${INTERMEDIATE_CODEC}"
    --setenv=PNG_COMPRESSION_LEVEL="${PNG_COMPRESSION_LEVEL}"
    --setenv=NCNN_EXTRACTION_MARGIN="${NCNN_EXTRACTION_MARGIN}"
    --setenv=NCNN_GPUS="${NCNN_GPUS}"
    --setenv=NCNN_THREADS="${NCNN_THREADS}"
    --setenv=RUN_MEMORY_PEAK_DEFAULT_GB="${RUN_MEMORY_PEAK_DEFAULT_GB}"
    --setenv=METRICS_INTERVAL_SEC="${METRICS_INTERVAL_SEC}"
  )
  if [ -n "${DESTINATION_DIR}" ]
  then
    SERVICE_ENVIRONMENT+=(--setenv=DESTINATION_DIR="${DESTINATION_DIR}")
  fi
  if ! "${SUDO_COMMAND[@]}" systemd-run --quiet --collect --unit="${UNIT_NAME}" \
    --description="interpolation_nncn: ${FILE_NAME}" \
    --uid="$(id -u)" --gid="$(id -g)" --working-directory="${PWD}" \
    "${SERVICE_PROPERTIES[@]}" \
    --setenv=PATH="${PATH}" --setenv=HOME="${HOME}" --setenv=USER="${USER}" \
    --setenv=LANG="${LANG:-C.UTF-8}" --setenv=TERM="${TERM:-xterm-256color}" \
    "${SERVICE_ENVIRONMENT[@]}" \
    --setenv=INTERPOLATION_NNCN_SERVICE=yes --setenv=SERVICE_RUN_TIMESTAMP="${CURRENT_TIMESTAMP}" \
    /usr/bin/env bash "${SCRIPT}" "${ORIGINAL_ARGUMENTS[@]}"
  then
    error "  starting the service ${YELLOW}${UNIT_NAME}${RED} failed (see the message of systemd-run above)"
    ERROR_CODE="1"
    failed
  fi
  local SUDO_PREFIX=""
  if [ ${#SUDO_COMMAND[@]} -gt 0 ]
  then
    SUDO_PREFIX="sudo "
  fi
  inf "  started as service: ${YELLOW}${UNIT_NAME}.service"
  inf "    log (all output):   ${BLUE}${LOG}/interpolation_nncn_silent_${CURRENT_TIMESTAMP}.log"
  inf "    follow:  ${LIME}tail -f '${LOG}/interpolation_nncn_silent_${CURRENT_TIMESTAMP}.log'"
  inf "    status:  ${LIME}systemctl status '${UNIT_NAME}'"
  inf "    stop:    ${LIME}${SUDO_PREFIX}systemctl stop '${UNIT_NAME}'${CYAN} (runs the Ctrl+C cleanup, finished chunks are kept)"
  inf "    list:    ${LIME}systemctl list-units 'interpolation-*'"
  exit 0
  }

if [[ ${SILENT} == yes ]] && [[ ${INTERPOLATION_NNCN_SERVICE} != yes ]]
then
  starting_as_service
fi

