if [[ ${FRESH_START} == yes ]]
then
  removing_earlier_results
fi
# a resumed run continues only chunks split at the same points; the points are saved for the next run
checking_split_points_file

if [ -z "${SPLIT_TIMESTAMPS}" ]
then
  # mkvmerge without --split copies the whole video into chunk 001 and writes the same
  # log lines as a split, so the chunk loop below works unchanged; after the loop the
  # results are renamed from video_part_minute_001 to the input name
  WHOLE_VIDEO_IN_ONE_CHUNK="yes"
  if [ "${VIDEO_LENGTH}" -le "${NO_SPLIT_MAX_SEC}" ]
  then
