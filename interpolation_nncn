usage()
{
echo "
${CYAN}Usage:${BRIGHT}${WHITE}
$0 [-o VAR_DIRECTORY] [ -v ] [ -f ] [ -h ] [ -o var ] [ -O var_out ] [ -N ncnn ] [ -s XXX ] [ -S ] [ -Q ]

    ${NORMAL}${CYAN}Description: This script manages neural network enhanced image(s) (and video(s)) manipulation, it manages superresolution, restoration, 
          enhancement and interpolation, as following:
            1. converts mp4 (if needed) to mkv
            2. divides video into 60s chunks
              2a. makes HDR conversion to SDR (tone mapping)
            3. separates and saves streams (audio and subtitles) from each chunk
            4. decompose video (chunk) into single frames
            5. interpolates frames (or does any other manipulation)
            6. checks space in background and removes frames which are not needed anymore (storage space preservation)
            7. combines interpolated frames into video (checks space in background and removes frames which are not needed anymore)
            8. joins streams
              8a. checks quality (VMAF) of new video with source one
            9. continues loop
    ${LIME}-S${DODGERBLUE1}  silence - no output whatsever - it does everything silently in the background
    ${LIME}-s${DODGERBLUE1}  due to complexity of the process and it's resources hungyiness it divides video into 1 minute chunks, but it may be simply interrupeted 
          and started again from pointed chunk ([NR][NR][NR]), for example [-s 003]
    ${LIME}-N${DODGERBLUE1}  NCNN method by which image(s) will be managed (interpolation/scaling/'enhancing'), some details as following:
                     ${ORANGERED1}cain        ${DARKCYAN}- Channel Attention Frame Interpolation                                 ${DEEPPINK1}(https://github.com/nihui/cain-ncnn-vulkan)
                     ${ORANGERED1}dain        ${DARKCYAN}- Depth-Aware Video Frame Interpolation                                 ${DEEPPINK1}(https://github.com/nihui/dain-ncnn-vulkan)
                     ${ORANGERED1}rife        ${DARKCYAN}- Real-Time Intermediate Flow Estimation for Video Frame Interpolation  ${DEEPPINK1}(https://github.com/nihui/rife-ncnn-vulkan, https://github.com/hzwer/ECCV2022-RIFE
                     ${ORANGERED1}ifrnet      ${DARKCYAN}- Intermediate Feature Refine Network for Efficient Frame Interpolation ${DEEPPINK1}(https://github.com/nihui/ifrnet-ncnn-vulkan)
                     ${ORANGERED1}realsr      ${DARKCYAN}- superresolution                                                       ${DEEPPINK1}(https://github.com/nihui/realsr-ncnn-vulkan)
                     ${ORANGERED1}Real-ESRGAN ${DARKCYAN}- image and video restoration                                           ${DEEPPINK1}(https://github.com/xinntao/Real-ESRGAN-ncnn-vulkan)
                     ${ORANGERED1}srmd        ${DARKCYAN}- superresolution                                                       ${DEEPPINK1}(https://github.com/nihui/srmd-ncnn-vulkan)
                     ${ORANGERED1}waifu2x                                                                             ${DEEPPINK1}(https://github.com/nihui/waifu2x-ncnn-vulkan)
                     ${ORANGERED1}realcugan   ${DARKCYAN}- superresolution + converter                                           ${DEEPPINK1}(https://github.com/nihui/realcugan-ncnn-vulkan)
                     ${ORANGERED1}zimage      ${DARKCYAN}- image generator                                                       ${DEEPPINK1}(https://github.com/nihui/zimage-ncnn-vulkan)
    ${LIME}-Q${DODGERBLUE1}  quality check (VMAF) 
    ${LIME}-o${DODGERBLUE1}  video_in OUTPUT directory + where to store ALL LOGs and TEMP files
        (default directory is: ${CYAN}${HOME}/var${DODGERBLUE1} and TMP and LOG are subdirectories to var)
    ${LIME}-O${DODGERBLUE1}  video_out OUTPUT directory (performance of IOPs is crucial)
        (default directory is: ${CYAN}video_in${DODGERBLUE1})
    ${LIME}-v${DODGERBLUE1}  verbose
    ${LIME}-h${DODGERBLUE1}  help${RESET}"

    1>&2;
    exit 1
}

