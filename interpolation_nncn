exit_function()
{
  trap SIGINT
  for NCNN_LOG in "${LOG}/"*_ncnn_${NCNN_METHOD}.log
  do
    if [ -s "${NCNN_LOG}" ]
    then
      warn "  log: ${BLUE}${NCNN_LOG}${WINE}, errors=$(grep fail "${NCNN_LOG}" | wc -l)"
    fi
  done
  tput cnorm 
  error "  interrupted (Ctrl+C)"
  # 130 = 128 + SIGINT(2), the conventional exit code of an interrupted program
  exit 130
  }

# Stops every process still started directly by this script (NCNN, ffmpeg, progress monitors),
# so Ctrl+C or an error does not leave them running and writing frames.
stop_background_jobs()
{
  # subshells (progress monitors) must not run this: $$ is still the main script there
  if [ "${BASHPID}" != "$$" ]
  then
    return
  fi
  local CHILD_PID
  for CHILD_PID in $(pgrep -P $$ 2>/dev/null)
  do
    kill "${CHILD_PID}" 2>/dev/null
    # a process paused by throttling_ncnn (SIGSTOP) handles SIGTERM only after SIGCONT
    kill -CONT "${CHILD_PID}" 2>/dev/null
  done
  }

trap "exit_function" INT
trap "stop_background_jobs" EXIT

# Writes the statistics row of the last finished chunk and removes its source chunk. With -E
# and -Q it first waits for that chunk's final encode and VMAF, which ran in the background
# alongside the next chunk (VMAF needed the source chunk as its reference).
finishing_previous_chunk()
{
  if [ -z "${PENDING_CHUNK_ID}" ]
  then
    return
  fi
  ENCODING_RUNTIME="0"
  QUALITY_METRIC_RUNTIME="0"
  VMAF_MEAN=""
  if [[ ${FINAL_ENCODING} == "yes" ]]
  then
    # sets ENCODING_RUNTIME (and VMAF_MEAN to "error" when the encode failed with -Q)
    finishing_part_encoding
  fi
  if [[ ${QUALITY_CHECK} == "yes" ]]
  then
    # sets VMAF_MEAN ("error" when the check failed) and QUALITY_METRIC_RUNTIME; does nothing
    # when no VMAF was started (a failed encode, or a resumed chunk which is only encoded)
    finishing_quality_metric
  fi
  # a resumed chunk which is only encoded has no processing times, so it gets no row
  if [[ ${PENDING_STATISTICS_ROW} == "yes" ]]
  then
    echo "${PENDING_STATISTICS_BEFORE_VMAF}~${ENCODING_RUNTIME}~${QUALITY_METRIC_RUNTIME}~${PENDING_STATISTICS_SPACE}~${VMAF_MEAN}~${PENDING_PART_RUNTIME}" >> "${TMP}/statistics.txt"
  fi
  rm -f -- "video_part_minute_${PENDING_CHUNK_ID}.mkv"
  PENDING_CHUNK_ID=""
  }

# Joins the encoded parts of all chunks (-E) into DESTINATION_DIR/<input name>.mkv; every chunk
# must have its finished final encode, also chunks done by an earlier run (-s, -r).
joining_encoded_parts()
{
  local ENCODED_PARTS=()
  local ENCODED_MARKERS
  local CHUNK_ID
  for CHUNK_ID in $(seq -w 001 "${LAST_VIDEO_FRAGMENT_ID}")
  do
    # shellcheck disable=SC2206 # the unquoted * is intentional: the glob finds the marker whatever the fps
    ENCODED_MARKERS=(video_part_minute_${CHUNK_ID}_${NCNN_METHOD}_*_encoded.mkv.done)
    if [ -e "${ENCODED_MARKERS[0]}" ] && [ -s "${ENCODED_MARKERS[0]%.done}" ] && [[ "$(cat "${ENCODED_MARKERS[0]}")" == "${WHOLE_MOVIE_NAME_ARRAY[*]}" ]]
    then
      ENCODED_PARTS+=("${ENCODED_MARKERS[0]%.done}")
    else
      error "  chunk ${YELLOW}${CHUNK_ID}${RED} has no finished final encode, so the parts are not joined; run again with -r -E"
      ERROR_CODE="1"
      failed
    fi
  done
  local JOIN_ARGUMENTS=("${ENCODED_PARTS[0]}")
  local ENCODED_PART
  for ENCODED_PART in "${ENCODED_PARTS[@]:1}"
  do
    JOIN_ARGUMENTS+=(+ "${ENCODED_PART}")
  done
  inf "  joining ${YELLOW}${#ENCODED_PARTS[@]}${CYAN} encoded parts into ${YELLOW}${FINAL_VIDEO_FILE}"
  # track mode: a subtitle which outlasts its part would otherwise leave gaps (see appending_mkvs)
  mkvmerge --append-mode track -o "${FINAL_VIDEO_FILE}" "${JOIN_ARGUMENTS[@]}" > "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_joining_encoded_parts.log" 2>&1
  mkvtoolnix_status "$?" "joining the encoded parts" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_joining_encoded_parts.log"
  inf "  result: ${YELLOW}${FINAL_VIDEO_FILE}"
  # the joined video replaces the encoded parts (kept with -k); markers of merged parts which
  # were already removed are not needed anymore
  if [[ ${KEEP_INTERMEDIATES} == no ]]
  then
    for ENCODED_PART in "${ENCODED_PARTS[@]}"
    do
      rm -f -- "${ENCODED_PART}" "${ENCODED_PART}.done"
    done
    local MERGED_MARKER
    for MERGED_MARKER in video_part_minute_*_"${NCNN_METHOD}"_*_merged.mkv.done "${WHOLE_MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}"_*_merged.mkv.done
    do
      if [ -e "${MERGED_MARKER}" ] && [ ! -e "${MERGED_MARKER%.done}" ]
      then
        rm -f -- "${MERGED_MARKER}"
      fi
    done
  fi
  }
