exit_function()
{
  trap SIGINT
  for NCNN_LOG in "${LOG}/"*_ncnn_${NCNN_METHOD}.log
  do
    if [ -s "${NCNN_LOG}" ]
    then
      warn "  log: ${BLUE}${NCNN_LOG}${WINE}, errors=$(grep fail "${NCNN_LOG}" | wc -l)"
    fi
  done
  tput cnorm 
  error "  interrupted (Ctrl+C)"
  # 130 = 128 + SIGINT(2), the conventional exit code of an interrupted program
  exit 130
  }

# Stops every process still started directly by this script (NCNN, ffmpeg, progress monitors),
# so Ctrl+C or an error does not leave them running and writing frames.
stop_background_jobs()
{
  # subshells (progress monitors) must not run this: $$ is still the main script there
  if [ "${BASHPID}" != "$$" ]
  then
    return
  fi
  local CHILD_PID
  for CHILD_PID in $(pgrep -P $$ 2>/dev/null)
  do
    kill "${CHILD_PID}" 2>/dev/null
  done
  }

trap "exit_function" INT
trap "stop_background_jobs" EXIT

start_time_collecting
START_TIME_WHOLE=${START_TIME}
SPLIT_TIME_SEC="60"
# preparation, analysis, all calculations and information - START

if [[ ${FILE_NAME_EXTENSION} == mp4 ]]
then
  mp4_to_mkv ${FILE_NAME}
fi
WHOLE_MOVIE_NAME_ARRAY=("${FILE_NAME%.mkv}")
FILE_NAME_EXTENSION=${FILE_NAME: (-3)}

VIDEO_DURATION_RAW=$(ffprobe -v quiet -print_format json -show_format -show_streams "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv" | jq -r '.format.duration')
if [[ ! ${VIDEO_DURATION_RAW} =~ ^[0-9]+(\.[0-9]+)?$ ]]
then
  error "  could not read duration of ${YELLOW}${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv${RED} (got: '${VIDEO_DURATION_RAW}')"
  ERROR_CODE="1"
  failed
fi
VIDEO_LENGTH=$(printf "%.0f\n" "${VIDEO_DURATION_RAW}")

#if [ ${VIDEO_LENGTH} -le 90 ]
#then
#  cp "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv" "video_part_minute_000.mkv"
#  CURRENTLY_MANAGED_VIDEO_PART_FILENAME="video_part_minute_000.mkv"
#  interpolation_video_file "${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}"
#  ERROR_CODE="$?"
#  sleep 1
#  clear
#else
#    mkvmerge -o "video_part_minute_${SPLIT_PART_START}.mkv" --split parts:00:06:00-00:07:00 "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv" > "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" 2>&1
mkvmerge -o "video_part_minute_%03d.mkv" --split ${SPLIT_TIME_SEC}s "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv" > "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" 2>&1
mkvtoolnix_status "$?" "splitting video into ${SPLIT_TIME_SEC}s chunks" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log"
LAST_VIDEO_FRAGMENT_ID=$(grep "video_part_minute_" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" | tail -n1 | sed "s/\.mkv.*$//g;s/^.*_minute_//g")
if [[ ! ${LAST_VIDEO_FRAGMENT_ID} =~ ^[0-9]{3}$ ]]
then
  error "  could not find the last chunk number in ${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log (got: '${LAST_VIDEO_FRAGMENT_ID}')"
  ERROR_CODE="1"
  failed
fi
# 10# forces base 10, otherwise bash reads 008/009 as (invalid) octal numbers
if [ $((10#${SPLIT_PART_START})) -gt $((10#${LAST_VIDEO_FRAGMENT_ID})) ]
then
  error "  -s ${SPLIT_PART_START} is beyond the last chunk ${LAST_VIDEO_FRAGMENT_ID}"
  ERROR_CODE="2"
  failed
fi
if [[ ${SPLIT_PART_START} != 001 ]]
then
  BEFORE_SPLIT_PART_START=$(printf "%03d" "$((10#${SPLIT_PART_START} - 1))")
  for VIDEO_FRAGMENT_ID in $(seq -w 001 ${BEFORE_SPLIT_PART_START})
  do
    echo "VIDEO_FRAGMENT_ID=${VIDEO_FRAGMENT_ID}"
    echo "  SPLIT_PART_START=${SPLIT_PART_START}, LAST_VIDEO_FRAGMENT_ID=${LAST_VIDEO_FRAGMENT_ID}, BEFORE_LAST_VIDEO_FRAGMENT_ID=${BEFORE_LAST_VIDEO_FRAGMENT_ID}"
    rm -f -- "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
  done
fi

  echo "video_id~tone_mapping_runtime~extracting_streams_runtime~extracting_frames_runtime~interpolating_runtime~merging_streams_runtime~merging_frames_runtime~quality_check_runtime~max_space [GB]~max_space [%]~VMAF [mean]~runtime" > "${TMP}/statistics.txt"
  for VIDEO_FRAGMENT_ID in $(seq -w ${SPLIT_PART_START} ${LAST_VIDEO_FRAGMENT_ID})
  do
    start_time_collecting
    START_TIME_FRAGMENT_ID=${START_TIME}
    IN_DIR="in_${VIDEO_FRAGMENT_ID}"
    OUT_DIR="out_${VIDEO_FRAGMENT_ID}"
    export IN_DIR
    export OUT_DIR
    if [[ ${RESUME} == yes ]]
    then
      # the .done marker is written only after a chunk fully succeeded, so a half-written
      # _merged.mkv from an interrupted run is never mistaken for a finished one
      # shellcheck disable=SC2206 # the unquoted * is intentional: the glob finds the marker whatever the fps
      FINISHED_CHUNK_MARKERS=(video_part_minute_${VIDEO_FRAGMENT_ID}_${NCNN_METHOD}_*_merged.mkv.done)
      if [ -e "${FINISHED_CHUNK_MARKERS[0]}" ] && [ -s "${FINISHED_CHUNK_MARKERS[0]%.done}" ] && [[ "$(cat "${FINISHED_CHUNK_MARKERS[0]}")" == "${WHOLE_MOVIE_NAME_ARRAY[*]}" ]]
      then
        inf "  chunk ${YELLOW}${VIDEO_FRAGMENT_ID}${CYAN} already finished (${FINISHED_CHUNK_MARKERS[0]%.done}), skipping"
        rm -f -- "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
        continue
      fi
    fi
    CURRENTLY_MANAGED_VIDEO_PART_PATH=$(grep "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" | grep ${VIDEO_FRAGMENT_ID} | awk '{print $3}' | sed "s/'//g")
    CURRENTLY_MANAGED_VIDEO_PART_FILENAME=$(echo ${CURRENTLY_MANAGED_VIDEO_PART_PATH} | awk -F\/ '{print $NF}')
    if [ -z "${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}" ] || [ ! -s "${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}" ]
    then
      error "  chunk ${YELLOW}${VIDEO_FRAGMENT_ID}${RED} not found (expected: video_part_minute_${VIDEO_FRAGMENT_ID}.mkv)"
      ERROR_CODE="1"
      failed
    fi
    FILE_NAME="${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}"
    FILE_NAME_EXTENSION=${FILE_NAME: (-3)}
    MOVIE_NAME_ARRAY=("${CURRENTLY_MANAGED_VIDEO_PART_FILENAME%.mkv}")
    NEXT_MANAGED_VIDEO_PART_PATH=$(grep "has been opened for writing" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" | grep -A1 "${CURRENTLY_MANAGED_VIDEO_PART_PATH}" | tail -n1 | awk '{print $3}' | sed "s/'//g")
    NEXT_MANAGED_VIDEO_PART_FILENAME=$(echo ${NEXT_MANAGED_VIDEO_PART_PATH} | awk -F\/ '{print $NF}')
    if [[ ${VIDEO_FRAGMENT_ID} == "001" ]]
    then
      FIRST_VIDEO_PART="${CURRENTLY_MANAGED_VIDEO_PART_PATH}"
    elif [[ ${VIDEO_FRAGMENT_ID} == "${LAST_VIDEO_FRAGMENT_ID}" ]]
    then
      LAST_VIDEO_PART="${CURRENTLY_MANAGED_VIDEO_PART_PATH}"
      NEXT_MANAGED_VIDEO_PART_PATH=""
    fi 
    # checks every step itself (including NCNN failures) and stops the run on error
    interpolation_video_file "${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}"

    if [[ ${QUALITY_CHECK} == "yes" ]]
    then
      #encoding_quality_metric "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv" "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv"
      encoding_quality_metric "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv" "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
      # VMAF_MEAN is set by encoding_quality_metric ("error" when the check failed)
    fi

    printf "\033[%d;0H\033[2K ${WHITE}finishing: %s\n" "$((TERMINAL_HEIGHT - 12))" "                       DONE: ${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}" 2>/dev/null
    # reaching this line means interpolation_video_file already required the _merged.mkv
    rm -f -- "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
    # chunk names are the same for every movie, so the marker remembers which movie it belongs to
    printf '%s\n' "${WHOLE_MOVIE_NAME_ARRAY[*]}" > "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv.done"
    
    START_TIME=${START_TIME_FRAGMENT_ID}
    end_time_collecting
    PART_VIDEO_RUNTIME=${RUNTIME}
    inf "    following video management took: ${DARKCYAN}${PART_VIDEO_RUNTIME}"
    if [ -s "${TMP}/HDR_2_SDR" ]
    then
      HDR_2_SDR_RUNTIME=$(cat "${TMP}/HDR_2_SDR")
      inf "      tone-mapping process took: ${DARKCYAN}${HDR_2_SDR_RUNTIME}"
    fi
    inf "      extracting"
    if [ -s "${TMP}/EXTRACTING_STREAMS_RUNTIME" ]
    then
      EXTRACTING_STREAMS_RUNTIME=$(cat "${TMP}/EXTRACTING_STREAMS_RUNTIME")
      inf "        streams took: ${DARKCYAN}${EXTRACTING_STREAMS_RUNTIME}"
    fi
    if [ -s "${TMP}/EXTRACTING_FRAMES_RUNTIME" ]
    then
      EXTRACTING_FRAMES_RUNTIME=$(cat "${TMP}/EXTRACTING_FRAMES_RUNTIME")
      inf "        frames  took: ${DARKCYAN}${EXTRACTING_FRAMES_RUNTIME}"
    fi
    if [ -s "${TMP}/INTERPOLATING_FRAMES_RUNTIME" ]
    then
      INTERPOLATING_FRAMES_RUNTIME=$(cat "${TMP}/INTERPOLATING_FRAMES_RUNTIME")
      inf "    interpolation done after ${DARKCYAN}${INTERPOLATING_FRAMES_RUNTIME}"
    fi
    inf "      merging"
    if [ -s "${TMP}/MERGING_STREAMS_RUNTIME" ]
    then
      MERGING_STREAMS_RUNTIME=$(cat "${TMP}/MERGING_STREAMS_RUNTIME")
      inf "        streams took: ${DARKCYAN}${MERGING_STREAMS_RUNTIME}"
    fi
    if [ -s "${TMP}/MERGING_FRAMES_RUNTIME" ]
    then
      MERGING_FRAMES_RUNTIME=$(cat "${TMP}/MERGING_FRAMES_RUNTIME")
      inf "        frames  took: ${DARKCYAN}${MERGING_FRAMES_RUNTIME}"
    fi
    if [ -s "${TMP}/QUALITY_METRIC_RUNTIME" ]
    then
      QUALITY_METRIC_RUNTIME=$(cat "${TMP}/QUALITY_METRIC_RUNTIME")
      inf "    VMAF check took: ${DARKCYAN}${QUALITY_METRIC_RUNTIME}"
    else
      QUALITY_METRIC_RUNTIME="0"
    fi
    if [ -s "${TMP}/MAX_SPACE_TAKEN_OVERALL" ]
    then
      MAX_SPACE_TAKEN_OVERALL="$(cat "${TMP}/MAX_SPACE_TAKEN_OVERALL")"
      if [[ ${MAX_SPACE_TAKEN_OVERALL} == "" ]] || [ ${MAX_SPACE_TAKEN_OVERALL} -eq 0 ] || [ -z ${MAX_SPACE_TAKEN_OVERALL} ]
      then
        MAX_SPACE_TAKEN_OVERALL="1"
      fi
      MAX_SPACE_TAKEN_PERCENT=$(printf "%.0f\n" "$(echo "(${MAX_SPACE_TAKEN_OVERALL}/${MAX_TSPACE})*100" | bc -l)")
      inf "    space used all together: ${DARKCYAN}${MAX_SPACE_TAKEN_OVERALL} [GB] ${CYAN}(which is only ${MAROON1}${MAX_SPACE_TAKEN_PERCENT} [%]${CYAN} of space which should be taken if not removed on-the-fly)"
    fi
    echo "${VIDEO_FRAGMENT_ID}~${HDR_2_SDR_RUNTIME}~${EXTRACTING_STREAMS_RUNTIME}~${EXTRACTING_FRAMES_RUNTIME}~${INTERPOLATING_FRAMES_RUNTIME}~${MERGING_STREAMS_RUNTIME}~${MERGING_FRAMES_RUNTIME}~${QUALITY_METRIC_RUNTIME}~${MAX_SPACE_TAKEN_OVERALL}~${MAX_SPACE_TAKEN_PERCENT}~${VMAF_MEAN}~${PART_VIDEO_RUNTIME}" >> "${TMP}/statistics.txt"
    sleep 10
    clear
  done
