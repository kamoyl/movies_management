done
shift $((OPTIND-1))

if [ ${CALLING} -eq 0 ]
then
  # only the service itself writes to the silent log; the launcher (-S from a terminal) reports there
  if [[ ${SILENT} == yes ]] && [[ ${INTERPOLATION_NNCN_SERVICE} == yes ]]
  then
    SILENT_ROOT="${o:-${HOME}/var}"
    if ! mkdir -p "${SILENT_ROOT}"
    then
      printf 'Unable to create silent-mode workspace: %s\n' "${SILENT_ROOT}" >&2
      exit 1
    fi
    SILENT_BOOT_LOG="${SILENT_ROOT}/.interpolation_nncn_silent_${BASHPID}_$(date "+%Y.%m.%d-%H.%M.%S").log" # .config (CURRENT_TIMESTAMP) is not loaded yet
    if ! exec >> "${SILENT_BOOT_LOG}" 2>&1
    then
      printf 'Unable to open silent-mode log: %s\n' "${SILENT_BOOT_LOG}" >&2
      exit 1
    fi
  fi

  source "${SCRIPTS_HOME}/.config"
  source "${SCRIPTS_HOME}/.var_management"
  if [[ ${SILENT} == yes ]] && [[ ${INTERPOLATION_NNCN_SERVICE} == yes ]]
  then
    SILENT_LOG="${LOG}/interpolation_nncn_silent_${CURRENT_TIMESTAMP}.log"
    if ! mv "${SILENT_BOOT_LOG}" "${SILENT_LOG}"
    then
      printf 'Unable to move silent-mode log to: %s\n' "${SILENT_LOG}" >&2
      exit 1
    fi
  fi
  echo -e "${DODGERBLUE1}${datestring} EXECUTE: ${YELLOW}[ ${LIME}$0 ${PARAMETERS} ${YELLOW} pid=${LIGHT_MAGENTA}${OWN_PID}]${RESET}"
fi

if [[ ${FILE_NAME} == */* ]]
then
  error "  -i expects a file name in the current directory, not a path (got: ${YELLOW}${FILE_NAME}${RED})"
  error "  run the script from the video's directory, e.g.: cd \"$(dirname -- "${FILE_NAME}")\" && $(basename -- "$0") -i \"$(basename -- "${FILE_NAME}")\""
  ERROR_CODE="2"
  failed
fi

if [ ! -s "${FILE_NAME}" ]
then
  error "  Interpolation without input video file ? how shall I approach it ? ;)"
  ERROR_CODE="2"
  failed
fi

if [ -z ${SPLIT_PART_START} ] || [[ ${SPLIT_PART_START} == "" ]]
then
  SPLIT_PART_START="001"
elif [[ ${SPLIT_PART_START} != [0-9][0-9][0-9] ]]
then
  error "  -s expects a three-digit chunk number, for example 003 (got: ${YELLOW}${SPLIT_PART_START}${RED})"
  ERROR_CODE="2"
  failed
fi

if [[ ${FRESH_START} == yes ]] && [[ ${RESUME_OPTION} == yes ]]
then
  error "  -F (start from scratch) and -r (resume) exclude each other"
  ERROR_CODE="2"
  failed
fi

if [ -n "${MEMORY_HIGH}" ]
then
  if [[ ${SILENT} != yes ]]
  then
    error "  -M sets the memory of the -S service, so it needs -S"
    ERROR_CODE="2"
    failed
  fi
  if ! [[ ${MEMORY_HIGH} =~ ^[0-9]+[KMGT]?$|^[0-9]+%$ ]]
  then
    error "  -M expects a size like 20G, 512M or a percentage like 50% (got: ${YELLOW}${MEMORY_HIGH}${RED})"
    ERROR_CODE="2"
    failed
  fi
fi

if [ -z ${NCNN_METHOD} ]
then
  NCNN_METHOD="rife"
fi

case "${NCNN_METHOD}" in
  rife|dain|cain|realsr)
    ;;
  *)
