            FILE_NAME=${i}
            FILE_NAME_EXTENSION=${FILE_NAME: (-3)}
            ;;
        N)
            N=${OPTARG}
            NCNN_METHOD=${N}
            ;;
        o)
            o=${OPTARG}
            ;;
        O)
            O=${OPTARG}
            ;;
        s)  
            s=${OPTARG}
            SPLIT_PART_START="${s}"
            ;;
        Q)
            QUALITY_CHECK=yes
            ;;
        E)
            FINAL_ENCODING=yes
            ;;
        a)
            ANIMATION=yes
            ;;
        g)
            GRAIN=yes
            ;;
        H)
            HIGHMOTION=yes
            ;;
        r)
            # the default now; still accepted, so existing commands keep working
            RESUME=yes
            RESUME_OPTION=yes
            ;;
        F)
            FRESH_START=yes
            RESUME=no
            ;;
        T)
            TONE_MAPPING=no
            ;;
