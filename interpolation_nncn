exit_function()
{
  trap SIGINT
  # logs of finished chunks are already compressed (.log.gz), zgrep reads both
  for NCNN_LOG in "${LOG}/"*_ncnn_${NCNN_METHOD}.log "${LOG}/"*_ncnn_${NCNN_METHOD}.log.gz
  do
    if [ -s "${NCNN_LOG}" ]
    then
      warn "  log: ${BLUE}${NCNN_LOG}${WINE}, errors=$(zgrep fail "${NCNN_LOG}" | wc -l)"
    fi
  done
  tput cnorm 
  cleaning_after_interrupt
  compressing_run_logs
  # only when the Python environment is ready: preparing it may download, too long for a stop
  if [ -x "${SCRIPTS_HOME}/.venv/bin/python3" ]
  then
    exporting_run_report
  fi
  error "  interrupted (Ctrl+C)"
  warning_leftover_processes
  # 130 = 128 + SIGINT(2), the conventional exit code of an interrupted program
  exit 130
  }

# After a stop: lists this user's video processes still running (e.g. a hung HandBrake that
# ignored SIGTERM, or another run), so a new run is not started alongside them by mistake.
warning_leftover_processes()
{
  local LEFTOVER_PID LEFTOVER_LINE
  local LEFTOVER_FOUND="no"
  for LEFTOVER_PID in $(pgrep -u "$(id -u)" -f 'HandBrakeCLI|-ncnn-vulkan|interpolation_nncn' 2>/dev/null)
  do
    # this script and its command substitutions (same command line) are not leftovers
    if [ "${LEFTOVER_PID}" = "$$" ] || [ "$(ps -o ppid= -p "${LEFTOVER_PID}" 2>/dev/null | tr -d ' ')" = "$$" ]
    then
      continue
    fi
    LEFTOVER_LINE="$(ps -o pid=,etime=,args= -p "${LEFTOVER_PID}" 2>/dev/null | cut -c1-150)"
    if [ -z "${LEFTOVER_LINE}" ]
    then
      continue
    fi
    if [[ ${LEFTOVER_FOUND} == no ]]
    then
      warn "  still running (PID, time, command) - do not start a new run before they end; stop them with kill PID (kill -9 PID if they stay):"
      LEFTOVER_FOUND="yes"
    fi
    warn "    ${LEFTOVER_LINE}"
  done
  }

# Compresses the logs not compressed yet when their chunk finished: the movie's and those of the
# last or interrupted chunk. At the end of a run, or after Ctrl+C / systemctl stop once the
# cleanup has waited for the processes. The silent log (-S) is still being written, so it stays.
compressing_run_logs()
{
  local LOG_FILE
  for LOG_FILE in "${LOG}"/*
  do
    if [[ ${LOG_FILE} != "${SILENT_LOG}" ]]
    then
      compressing_logs "${LOG_FILE}"
    fi
  done
  inf "    logs are compressed (gzip), read them with zless or zgrep: ${YELLOW}${LOG}"
  }

# Writes the run's metrics, timeline and statistics with charts into ${TMP}/<movie>_report.xlsx
# (metrics_to_excel.py; plain report.xlsx if the run stopped before the movie name was known).
# The Python environment (.venv in the repository, with xlsxwriter) is
# prepared on first use; without it the report is skipped, the run is not affected.
exporting_run_report()
{
  local REPORT="${TMP}/report.xlsx"
  if [ -n "${WHOLE_MOVIE_NAME_ARRAY[*]}" ]
  then
    REPORT="${TMP}/${WHOLE_MOVIE_NAME_ARRAY[*]}_report.xlsx"
  fi
  if ! python_venv_preparing "${SCRIPTS_HOME}/.venv" xlsxwriter
  then
    warn "    no report: the Python environment could not be prepared, see ${BLUE}${LOG}/python_venv_preparing.log"
    return
  fi
  if "${SCRIPTS_HOME}/.venv/bin/python3" "${SCRIPTS_HOME}/metrics_to_excel.py" "${TMP}" "${REPORT}" > "${LOG}/metrics_to_excel.log" 2>&1
  then
    inf "    report with charts: ${YELLOW}${REPORT}"
  else
    warn "    no report: metrics_to_excel.py failed, see ${BLUE}${LOG}/metrics_to_excel.log"
  fi
  }

# Stops every process still started directly by this script (NCNN, ffmpeg, progress monitors),
# so Ctrl+C or an error does not leave them running and writing frames.
# EXIT trap: stops the background jobs (also the metrics sampling, so metrics.csv is complete);
# after an error exit (failed, exit 1) it also removes the unfinished work, as Ctrl+C does (the
# frames of a failed chunk were left before, e.g. after a lost GPU), and writes report.xlsx - the
# successful end and Ctrl+C (130) write it themselves. A plain kill (SIGTERM) also runs this trap,
# but with $? 0, so it cannot be told from the successful end: it gets no cleanup and no report,
# nor does kill -9; the next run removes their frames (cleaning_earlier_runs).
exiting_function()
{
  local EXIT_STATUS=$?
  # METRICS_SAMPLING_PID: the run got that far (usage errors, exit 2, come before it)
  if [ "${BASHPID}" == "$$" ] && [ "${EXIT_STATUS}" -ne 0 ] && [ "${EXIT_STATUS}" -ne 130 ] && [ -n "${METRICS_SAMPLING_PID}" ]
  then
    cleaning_after_interrupt
  else
    stop_background_jobs
  fi
  if [ "${BASHPID}" != "$$" ]
  then
    return
  fi
  if [ "${EXIT_STATUS}" -ne 0 ] && [ "${EXIT_STATUS}" -ne 130 ] && [ -n "${METRICS_SAMPLING_PID}" ] && [ -x "${SCRIPTS_HOME}/.venv/bin/python3" ]
  then
    exporting_run_report
  fi
  }

# PIDs of all processes started by the given PIDs (children, their children, ...); the command
# substitution which calls it is a child of the script too, so it is skipped (BASHPID)
descendant_pids()
{
  local PARENT_PID
  local CHILD_PID
  for PARENT_PID in "$@"
  do
    for CHILD_PID in $(pgrep -P "${PARENT_PID}" 2>/dev/null)
    do
      if [ "${CHILD_PID}" != "${BASHPID}" ]
      then
        echo "${CHILD_PID}"
        descendant_pids "${CHILD_PID}"
      fi
    done
  done
  }

# running_pids PID... - true while one of the PIDs still runs
running_pids()
{
  local PID
  for PID in "$@"
  do
    if kill -0 "${PID}" 2>/dev/null
    then
      return 0
    fi
  done
  return 1
  }

stop_background_jobs()
{
  # subshells (progress monitors) must not run this: $$ is still the main script there
  if [ "${BASHPID}" != "$$" ]
  then
    return
  fi
  local CHILD_PID
  # also grandchildren: HandBrake runs in the encoding subshell, and ended only after the
  # cleanup when it was not stopped itself (its 0-byte _video_only.mkv stayed, 8 Nov); the
  # PIDs are kept, because a grandchild whose parent ended is no descendant anymore
  STOPPED_PIDS=($(descendant_pids $$))
  for CHILD_PID in "${STOPPED_PIDS[@]}"
  do
    kill "${CHILD_PID}" 2>/dev/null
    # a process paused by throttling_ncnn (SIGSTOP) handles SIGTERM only after SIGCONT
    kill -CONT "${CHILD_PID}" 2>/dev/null
  done
  }

# removing_work_files DIR... - removes what a run's work left in its work directories (TMP,
# TMP_OUT): frame directories, frames-only videos (TMP_OUT), audio/subtitle extracts (TMP) and the
# sampled frames of a preparation; logs, CSVs and reports stay. Adds to REMOVED_COUNT.
# safe_remove_dir allows only TMP/TMP_OUT, so the caller sets those to the directories given.
removing_work_files()
{
  local WORK_DIR_ROOT
  local WORK_ITEM
  for WORK_DIR_ROOT in "$@"
  do
    # an interrupt during start-up may come before the work directories are set
    if [ -z "${WORK_DIR_ROOT}" ] || [ ! -d "${WORK_DIR_ROOT}" ]
    then
      continue
    fi
    for WORK_ITEM in "${WORK_DIR_ROOT}"/in_[0-9][0-9][0-9] "${WORK_DIR_ROOT}"/out_[0-9][0-9][0-9] "${WORK_DIR_ROOT}"/frame_analysis
    do
      if [ -d "${WORK_ITEM}" ]
      then
        safe_remove_dir "${WORK_ITEM}"
        REMOVED_COUNT=$((REMOVED_COUNT + 1))
      fi
    done
    # both directories belong to one run only, so every video there is an intermediate
    for WORK_ITEM in "${WORK_DIR_ROOT}"/*.mkv "${WORK_DIR_ROOT}"/*.mka
    do
      if [ -f "${WORK_ITEM}" ]
      then
        rm -f -- "${WORK_ITEM}"
        REMOVED_COUNT=$((REMOVED_COUNT + 1))
      fi
    done
  done
  }

# Start-up: removes the frames and intermediate videos which earlier runs left in their work
# directories, and compresses their logs, because they ended without any cleanup (kill -9, a lost
# machine) or before this cleanup existed for failed runs. Only directories with a run.pid of an
# ended run (a run writes run.pid unless -k) are touched, so a run still going, or one kept with -k,
# is never cleaned.
# A reused PID only makes the cleanup skip the directory.
cleaning_earlier_runs()
{
  local EARLIER_DIR
  local EARLIER_LOG_DIR
  local EARLIER_PID
  local REMOVED_COUNT=0
  for EARLIER_DIR in "${VAR}/tmp-${SCRIPT_NAME}_"* "${VAR_OUT}/tmp-${SCRIPT_NAME}_"*
  do
    if [ ! -f "${EARLIER_DIR}/run.pid" ] || [[ ${EARLIER_DIR} == "${TMP}" ]] || [[ ${EARLIER_DIR} == "${TMP_OUT}" ]]
    then
      continue
    fi
    EARLIER_PID="$(cat "${EARLIER_DIR}/run.pid")"
    if [[ ${EARLIER_PID} =~ ^[0-9]+$ ]] && kill -0 "${EARLIER_PID}" 2>/dev/null
    then
      continue
    fi
    # bash keeps these assignments for this one call only
    TMP="${EARLIER_DIR}" TMP_OUT="" removing_work_files "${EARLIER_DIR}"
    # its logs too (the run had no cleanup to compress them); only VAR has a log directory
    EARLIER_LOG_DIR="${EARLIER_DIR%/*}/log-${EARLIER_DIR##*/tmp-}"
    if [[ ${EARLIER_DIR} == "${VAR}/tmp-"* ]] && [ -d "${EARLIER_LOG_DIR}" ]
    then
      compressing_logs "${EARLIER_LOG_DIR}"/*
    fi
    rm -f -- "${EARLIER_DIR}/run.pid"
  done
  if [ "${REMOVED_COUNT}" -gt 0 ]
  then
    inf "  removed ${YELLOW}${REMOVED_COUNT}${CYAN} frame director(ies) or intermediate file(s) left by earlier runs"
  fi
  }

# Ctrl+C or a failed run (exit 1): stops the processes of this run, then removes what the
# unfinished work left behind: the frame directories, frames-only videos and stream extracts in
# TMP/TMP_OUT, the source chunks (every run splits the movie again) and the parts without a .done
# marker in the current directory. Finished parts and their markers stay, so the next run resumes.
# With -k nothing is removed. A second Ctrl+C stops the cleanup at once (exit_function restores
# the default first).
cleaning_after_interrupt()
{
  inf "  closing processes and cleaning; finished chunks are kept, the next run resumes them"
  stop_background_jobs
  # at most 10 s for NCNN, ffmpeg and HandBrake to end, so they do not write into removed files
  local WAITED_SEC=0
  while [ "${WAITED_SEC}" -lt 10 ] && running_pids "${STOPPED_PIDS[@]}"
  do
    sleep 1
    WAITED_SEC=$((WAITED_SEC + 1))
  done
  if [[ ${KEEP_INTERMEDIATES} == yes ]]
  then
    inf "  -k: intermediate files are kept"
    return
  fi
  local REMOVED_COUNT=0
  local WORK_ITEM
  removing_work_files "${TMP}" "${TMP_OUT}"
  # the current directory: source chunks, and parts which were not finished (no .done marker);
  # a movie too short to be split is processed under its own name
  for WORK_ITEM in video_part_minute_[0-9][0-9][0-9]*.mkv "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_"*.mkv
  do
    if [ -f "${WORK_ITEM}" ] && [ ! -e "${WORK_ITEM}.done" ]
    then
      rm -f -- "${WORK_ITEM}"
      REMOVED_COUNT=$((REMOVED_COUNT + 1))
    fi
  done
  inf "  removed ${YELLOW}${REMOVED_COUNT}${CYAN} unfinished or intermediate item(s)"
  }

trap "exit_function" INT
trap "exiting_function" EXIT

# Writes the statistics row of the last finished chunk and removes its source chunk. With -E
# and -Q it first waits for that chunk's final encode and VMAF, which ran in the background
# alongside the next chunk (VMAF needed the source chunk as its reference).
finishing_previous_chunk()
{
  if [ -z "${PENDING_CHUNK_ID}" ]
  then
    return
  fi
  ENCODING_RUNTIME="0"
  QUALITY_METRIC_RUNTIME="0"
  VMAF_MEAN=""
  if [[ ${FINAL_ENCODING} == "yes" ]]
  then
    # sets ENCODING_RUNTIME (and VMAF_MEAN to "error" when the encode failed with -Q)
    finishing_part_encoding
  fi
  if [[ ${QUALITY_CHECK} == "yes" ]]
  then
    # sets VMAF_MEAN ("error" when the check failed) and QUALITY_METRIC_RUNTIME; does nothing
    # when no VMAF was started (a failed encode, or a resumed chunk which is only encoded)
    finishing_quality_metric
  fi
  # a resumed chunk which is only encoded has no processing times, so it gets no row
  if [[ ${PENDING_STATISTICS_ROW} == "yes" ]]
  then
    echo "${PENDING_STATISTICS_BEFORE_VMAF}~${ENCODING_RUNTIME}~${QUALITY_METRIC_RUNTIME}~${PENDING_STATISTICS_SPACE}~${VMAF_MEAN}~${PENDING_PART_RUNTIME}" >> "${TMP}/statistics.txt"
  fi
  rm -f -- "video_part_minute_${PENDING_CHUNK_ID}.mkv"
  # all steps of this chunk (also its encode and VMAF) are done, so nothing writes its logs anymore
  compressing_logs "${LOG}/video_part_minute_${PENDING_CHUNK_ID}_"*
  PENDING_CHUNK_ID=""
  }

# Stops the run after a failed final encode (-E), once the chunk processed meanwhile is marked
# as done. Going on would leave one merged part after another (13 GB each at 4K) when the
# encodes keep failing, e.g. killed for lack of memory, until the disk is full; the next run with -E then
# encodes the kept merged parts and continues.
stopping_after_failed_encode()
{
  if [[ ${PART_ENCODING_FAILED} == yes ]]
  then
    error "  stopping, because a final encode failed; when the cause is solved, run again with ${YELLOW}-E${RED} (finished chunks are kept)"
    ERROR_CODE="1"
    failed
  fi
  }

# -F: removes the results of an earlier run of this movie and method in the current directory,
# from chunk -s on: the finished parts with their .done markers and, from chunk 001, the split
# points file. Chunk names are the same for every movie, so only parts whose marker names this
# movie are removed (other files are overwritten while the chunks are processed again).
removing_earlier_results()
{
  local MARKER
  local CHUNK_ID
  local REMOVED_COUNT=0
  local SPLIT_POINTS_FILE="${WHOLE_MOVIE_NAME_ARRAY[*]}_split_points.txt"
  for MARKER in video_part_minute_[0-9][0-9][0-9]_"${NCNN_METHOD}"_*.done "${WHOLE_MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}"_*_merged.mkv.done
  do
    if [ ! -e "${MARKER}" ] || [[ "$(head -n1 "${MARKER}")" != "${WHOLE_MOVIE_NAME_ARRAY[*]}" ]]
    then
      continue
    fi
    # the results of an unsplit video (one chunk) got the input name
    CHUNK_ID="001"
    if [[ ${MARKER} == video_part_minute_* ]]
    then
      CHUNK_ID="${MARKER:18:3}"
    fi
    if [ $((10#${CHUNK_ID})) -lt $((10#${SPLIT_PART_START})) ]
    then
      continue
    fi
    inf "  -F: removing ${YELLOW}${MARKER%.done}${CYAN} and its marker"
    rm -f -- "${MARKER%.done}" "${MARKER}"
    REMOVED_COUNT=$((REMOVED_COUNT + 1))
  done
  if [[ ${SPLIT_PART_START} == 001 ]] && [ -e "${SPLIT_POINTS_FILE}" ]
  then
    inf "  -F: removing ${YELLOW}${SPLIT_POINTS_FILE}"
    rm -f -- "${SPLIT_POINTS_FILE}"
  fi
  inf "  -F: ${YELLOW}${REMOVED_COUNT}${CYAN} earlier result(s) of ${YELLOW}${WHOLE_MOVIE_NAME_ARRAY[*]}${CYAN} removed, the movie is processed from chunk ${YELLOW}${SPLIT_PART_START}${CYAN} again"
  }

# Profile (OPTIMIZATION) of an encoded part: line 2 of its .done marker; markers of older runs
# have only the movie name
encoded_part_profile()
{
  local PROFILE
  PROFILE="$(sed -n 2p "${1}" 2>/dev/null)"
  echo "${PROFILE:-unknown}"
  }

# Joins the encoded parts of all chunks (-E) into DESTINATION_DIR/<input name>.mkv; every chunk
# must have its finished final encode, also chunks done by an earlier run (-s, -r).
joining_encoded_parts()
{
  local ENCODED_PARTS=()
  local ENCODED_MARKERS
  local CHUNK_ID
  local PART_PROFILE
  local OTHER_PROFILE_PARTS=()
  for CHUNK_ID in $(seq -w 001 "${LAST_VIDEO_FRAGMENT_ID}")
  do
    # shellcheck disable=SC2206 # the unquoted * is intentional: the glob finds the marker whatever the fps
    ENCODED_MARKERS=(video_part_minute_${CHUNK_ID}_${NCNN_METHOD}_*_encoded.mkv.done)
    if [ -e "${ENCODED_MARKERS[0]}" ] && [ -s "${ENCODED_MARKERS[0]%.done}" ] && [[ "$(head -n1 "${ENCODED_MARKERS[0]}")" == "${WHOLE_MOVIE_NAME_ARRAY[*]}" ]]
    then
      ENCODED_PARTS+=("${ENCODED_MARKERS[0]%.done}")
      PART_PROFILE="$(encoded_part_profile "${ENCODED_MARKERS[0]}")"
      if [[ ${PART_PROFILE} != "${OPTIMIZATION}" ]]
      then
        OTHER_PROFILE_PARTS+=("${CHUNK_ID} (${PART_PROFILE})")
      fi
    else
      error "  chunk ${YELLOW}${CHUNK_ID}${RED} has no finished final encode, so the parts are not joined; run again with -E"
      ERROR_CODE="1"
      failed
    fi
  done
  if [ "${#OTHER_PROFILE_PARTS[@]}" -gt 0 ]
  then
    warn "  ${#OTHER_PROFILE_PARTS[@]} part(s) were encoded with another profile than ${YELLOW}${OPTIMIZATION}${WINE}, the joined movie mixes them: ${OTHER_PROFILE_PARTS[*]}"
  fi
  local JOIN_LOG="${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_joining_encoded_parts.log"
  # Only the video is taken from the parts; the audio and subtitles come from the source movie.
  # A part's audio starts at the source's first audio frame after the split (e.g. 20 ms after
  # its video), and --append-mode track adds that start again at every join, so the parts'
  # audio fell behind (0.9 s after 45 joins). The joined video has the source's timeline, so
  # the source's audio, one continuous stream, is in sync with it. The tracks are chosen like
  # those of the chunks (extracting_mkv_streams).
  local SOURCE_FILE="${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv"
  local SOURCE_TRACKS_JSON="${TMP}/${WHOLE_MOVIE_NAME_ARRAY[*]}_joining_tracks.json"
  if ! mkvmerge -J "${SOURCE_FILE}" > "${SOURCE_TRACKS_JSON}" 2> "${JOIN_LOG}"
  then
    error "  reading tracks of ${YELLOW}${SOURCE_FILE}${RED} (mkvmerge -J) failed (see log: ${JOIN_LOG})"
    ERROR_CODE="1"
    failed
  fi
  local SOURCE_AUDIO_IDS
  local SOURCE_SUBTITLE_IDS
  SOURCE_AUDIO_IDS="$(tracks_by_language "${SOURCE_TRACKS_JSON}" audio)"
  if [ -z "${SOURCE_AUDIO_IDS}" ]
  then
    SOURCE_AUDIO_IDS="$(all_tracks "${SOURCE_TRACKS_JSON}" audio)"
  fi
  SOURCE_SUBTITLE_IDS="$(tracks_by_language "${SOURCE_TRACKS_JSON}" subtitles)"
  local SOURCE_TRACKS=(--no-video --no-chapters --no-attachments --no-global-tags --no-track-tags)
  if [ -n "${SOURCE_AUDIO_IDS}" ]
  then
    SOURCE_TRACKS+=(--audio-tracks "${SOURCE_AUDIO_IDS}")
  else
    SOURCE_TRACKS+=(--no-audio)
  fi
  if [ -n "${SOURCE_SUBTITLE_IDS}" ]
  then
    SOURCE_TRACKS+=(--subtitle-tracks "${SOURCE_SUBTITLE_IDS}")
  else
    SOURCE_TRACKS+=(--no-subtitles)
  fi
  local JOIN_ARGUMENTS=(--no-audio --no-subtitles "${ENCODED_PARTS[0]}")
  local ENCODED_PART
  for ENCODED_PART in "${ENCODED_PARTS[@]:1}"
  do
    JOIN_ARGUMENTS+=(+ --no-audio --no-subtitles "${ENCODED_PART}")
  done
  inf "  joining ${YELLOW}${#ENCODED_PARTS[@]}${CYAN} encoded parts into ${YELLOW}${FINAL_VIDEO_FILE}${CYAN}, with audio and subtitles of ${YELLOW}${SOURCE_FILE}"
  # track mode: each part's video continues where the previous part's video ends
  mkvmerge --append-mode track -o "${FINAL_VIDEO_FILE}" "${JOIN_ARGUMENTS[@]}" "${SOURCE_TRACKS[@]}" "${SOURCE_FILE}" >> "${JOIN_LOG}" 2>&1
  mkvtoolnix_status "$?" "joining the encoded parts" "${JOIN_LOG}"
  rm -f -- "${SOURCE_TRACKS_JSON}"
  inf "  result: ${YELLOW}${FINAL_VIDEO_FILE}"
  # the joined video replaces the encoded parts (kept with -k); markers of merged parts which
  # were already removed are not needed anymore
  if [[ ${KEEP_INTERMEDIATES} == no ]]
  then
    for ENCODED_PART in "${ENCODED_PARTS[@]}"
    do
      rm -f -- "${ENCODED_PART}" "${ENCODED_PART}.done"
    done
    local MERGED_MARKER
    for MERGED_MARKER in video_part_minute_*_"${NCNN_METHOD}"_*_merged.mkv.done "${WHOLE_MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}"_*_merged.mkv.done
    do
      if [ -e "${MERGED_MARKER}" ] && [ ! -e "${MERGED_MARKER%.done}" ]
      then
        rm -f -- "${MERGED_MARKER}"
      fi
    done
    rm -f -- "${WHOLE_MOVIE_NAME_ARRAY[*]}_split_points.txt"
  fi
  }
# no finished chunk is waiting for its statistics row yet
PENDING_CHUNK_ID=""
PENDING_STATISTICS_ROW="no"
PART_ENCODING_PID=""

cleaning_earlier_runs
# marks the work directories as this run's, for cleaning_earlier_runs of a later run; not with -k,
# whose intermediates are kept on purpose
if [[ ${KEEP_INTERMEDIATES} != yes ]]
then
  echo "$$" > "${TMP}/run.pid"
  echo "$$" > "${TMP_OUT}/run.pid"
fi

start_time_collecting
START_TIME_WHOLE=${START_TIME}
# system metrics of the run every METRICS_INTERVAL_SEC (5) seconds, for the report and the memory
# check before each final encode; stopped at the end, or by stop_background_jobs
metrics_sampling "${TMP}/metrics.csv" HandBrakeCLI ffmpeg "${NCNN_METHOD}-ncnn-vulkan" mkvmerge &
METRICS_SAMPLING_PID=$!
SPLIT_TIME_SEC="60"
# a video of up to this length is processed as one chunk (001) instead of being split
NO_SPLIT_MAX_SEC="90"
# preparation, analysis, all calculations and information - START

if [[ ${FILE_NAME_EXTENSION} == mp4 ]]
then
  mp4_to_mkv ${FILE_NAME}
fi
WHOLE_MOVIE_NAME_ARRAY=("${FILE_NAME%.mkv}")
FILE_NAME_EXTENSION=${FILE_NAME: (-3)}

VIDEO_DURATION_RAW=$(ffprobe -v quiet -print_format json -show_format -show_streams "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv" | jq -r '.format.duration')
if [[ ! ${VIDEO_DURATION_RAW} =~ ^[0-9]+(\.[0-9]+)?$ ]]
then
