#   - NOT_WORKING: when video file is equal or shorter then ${SPLIT_TIME_SEC} - just run, without splitting
#   - update ffmpeg to use FFMPEG_GLOBAL_OPTIONS
#   - make silent version (all in the background without any notifications whatsovever
#   - run concatenation WHEN ONLY ALL parts existed
#   - takes care for space, so if started from some fragment_id, then remove all before it already
#       - try to change split of all into split to pick up exactly one needed
#         Examples:
#           – split parts:00:01:20-00:02:45,00:05:50-00:10:30
#           – split parts:00:01:20-00:02:45,+00:05:50-00:10:30
#           - split parts:00:00:00-00:10:00 (proper)
#         from logs:
#           - Timestamp used in split decision: 00:01:00.000000000
#           - Timestamp used in split decision: 00:02:00.000000000
#   - performance (shorter processing time per chunk; measure one chunk before/after each change):
#       - overlap chunks: extract frames of chunk N+1 and encode chunk N-1 while NCNN works on chunk N (GPU waits now)
#       - faster intermediate encode in merging_frames_mkv (libsvtav1 -crf 0 -preset 5 is slow; HandBrake encodes again later):
#         e.g. libx264 -qp 0 -preset ultrafast, ffv1, or libsvtav1 -preset 8-10 (bigger temporary files)
#       - faster PNG I/O: -compression_level 0 (or 1) for frame extraction; TMP/TMP_OUT on tmpfs (RAM) or fast NVMe
#       - tune NCNN: benchmark -j values on the same chunk; check whether always using -u (RIFE UHD mode) fits the input resolution
#       - smaller overhead per chunk:
#           - remove fixed waits (sleep 5, sleep 3, sleep 1)
#           - NCNN progress monitor greps the whole, growing log every 2 s -> use tail -n
#           - drop NCNN -v (verbose) logging when not needed
#           - with -Q: give VMAF more threads (n_threads) or run it alongside the next chunk
#
# Documentation and helpers (links, GPU tuning, HDR/SDR, tone mapping, VMAF): see README.md, "Interpolation reference notes"

if [[ "${OSTYPE}" =~ "linux" ]]
then
  SCRIPT=$(readlink -f "$0")
elif [[ "${OSTYPE}" =~ "darwin" ]]
then
  SCRIPT=$(greadlink -f "$0")
else
  SCRIPT=$(readlink -f "$0")
fi

SCRIPTS_HOME=$(dirname "${SCRIPT}")
export SCRIPTS_HOME

PARAMETERS=$(echo "$@" | sed 's/\-l .//g')
OWN_PID=${BASHPID}

if [ "$(caller | awk '{print $1}')" -eq 0 ]
then
  CALLING=0
  reset
else
  CALLING=1
  if [[ ${VERBOSE} == yes ]]
  then
    debug "${YELLOW}[ ${LIME}$(echo "$(caller | awk '{print $2}')" | awk -F\/ '{print $NF}') ${YELLOW}calls (in line: ${LIME}$(caller | awk '{print $1}')${YELLOW}) ${LIME}$(echo "${BASH_SOURCE[*]}" | awk -F\/ '{print $NF}') ${PARAMETERS} ${YELLOW} ]"
  fi
fi

export EXECUTE_COMMAND="$0 ${PARAMETERS}"
export EXECUTE_COMMAND

usage()
{
  # colours only on a terminal, so help piped to a file or the silent log stays plain text
  if [ -t 1 ] && [ -s "${SCRIPTS_HOME}/.config_colours" ]
  then
    source "${SCRIPTS_HOME}/.config_colours"
    BRIGHT=$(tput bold 2>/dev/null)
    NORMAL=$(tput sgr0 2>/dev/null)
    RESET="${NORMAL}"
  elif [ ! -t 1 ]
  then
    # colours may also come exported from the calling shell
    local CYAN="" BRIGHT="" WHITE="" NORMAL="" LIME="" DODGERBLUE1="" ORANGERED1="" DARKCYAN="" DEEPPINK1="" RESET=""
  fi
echo "
${CYAN}Usage:${BRIGHT}${WHITE}
$0 -i FILE [ -N ncnn ] [ -o var ] [ -O var_out ] [ -s XXX ] [ -r ] [ -Q ] [ -S ] [ -v ] [ -h ]

    ${NORMAL}${CYAN}Description: processes a video with a neural network (NCNN/Vulkan) tool, in 60-second chunks:
            1. converts MP4 to MKV when needed, then splits it into chunks
            2. tone-maps HDR to SDR when needed
            3. extracts audio/subtitle streams and video frames
            4. processes frames with the selected NCNN method
            5. merges frames back into video and re-attaches the streams
            6. optionally calculates VMAF (-Q) and appends TMP/statistics.txt
            7. marks the chunk as finished:
                 video_part_minute_NNN_<method>_<fps>_merged.mkv.done
          It produces per-chunk merged files; it does not concatenate them into one final video.
          Ctrl+C or an error also stops the background tools (NCNN, ffmpeg) started by this run.

    ${LIME}-i${DODGERBLUE1}  input video (required; MP4 input is converted to MKV)
    ${LIME}-N${DODGERBLUE1}  NCNN/Vulkan method (default: ${CYAN}rife${DODGERBLUE1}); supported by this script:
                     ${ORANGERED1}rife        ${DARKCYAN}- Real-Time Intermediate Flow Estimation (frame interpolation)    ${DEEPPINK1}(https://github.com/nihui/rife-ncnn-vulkan)
                     ${ORANGERED1}dain        ${DARKCYAN}- Depth-Aware Video Frame Interpolation                           ${DEEPPINK1}(https://github.com/nihui/dain-ncnn-vulkan)
                     ${ORANGERED1}cain        ${DARKCYAN}- Channel Attention Frame Interpolation                           ${DEEPPINK1}(https://github.com/nihui/cain-ncnn-vulkan)
                     ${ORANGERED1}realsr      ${DARKCYAN}- superresolution (4x scale)                                      ${DEEPPINK1}(https://github.com/nihui/realsr-ncnn-vulkan)
          ${DODGERBLUE1}not supported yet (frame calculations are not configured for them, so they are rejected):
                     ${ORANGERED1}ifrnet      ${DARKCYAN}- Intermediate Feature Refine Network (frame interpolation)       ${DEEPPINK1}(https://github.com/nihui/ifrnet-ncnn-vulkan)
                     ${ORANGERED1}Real-ESRGAN ${DARKCYAN}- image and video restoration                                     ${DEEPPINK1}(https://github.com/xinntao/Real-ESRGAN-ncnn-vulkan)
                     ${ORANGERED1}srmd        ${DARKCYAN}- superresolution                                                 ${DEEPPINK1}(https://github.com/nihui/srmd-ncnn-vulkan)
                     ${ORANGERED1}waifu2x     ${DARKCYAN}- superresolution and denoising                                   ${DEEPPINK1}(https://github.com/nihui/waifu2x-ncnn-vulkan)
                     ${ORANGERED1}realcugan   ${DARKCYAN}- superresolution + converter                                     ${DEEPPINK1}(https://github.com/nihui/realcugan-ncnn-vulkan)
                     ${ORANGERED1}zimage      ${DARKCYAN}- image generator                                                 ${DEEPPINK1}(https://github.com/nihui/zimage-ncnn-vulkan)
    ${LIME}-o${DODGERBLUE1}  workspace root for temporary files and logs
          (default directory is: ${CYAN}${HOME}/var${DODGERBLUE1}; TMP and LOG are created inside it for every run)
    ${LIME}-O${DODGERBLUE1}  separate root for extracted and processed frame data (performance of IOPs is crucial)
          (default: same as ${CYAN}-o${DODGERBLUE1})
    ${LIME}-s${DODGERBLUE1}  first three-digit chunk number to process, for example [-s 003] (default: ${CYAN}001${DODGERBLUE1})
    ${LIME}-r${DODGERBLUE1}  resume: skip chunks already finished by an earlier run of the same movie and method
          in this directory; combinable with -s
    ${LIME}-Q${DODGERBLUE1}  calculate VMAF (quality check) for each processed chunk
    ${LIME}-S${DODGERBLUE1}  silent: no terminal output; everything is written to the run's silent log
    ${LIME}-v${DODGERBLUE1}  verbose diagnostics
    ${LIME}-h${DODGERBLUE1}  this help${RESET}
"
  exit 0
}

INTERPOLATION=no
SILENT=no
VERBOSE=no
QUALITY_CHECK=no
RESUME=no
while getopts ":o:O:i:N:s:rvShQ" ARG
do
  case "${ARG}" in
        i)
            i=${OPTARG}
            FILE_NAME=${i}
            FILE_NAME_EXTENSION=${FILE_NAME: (-3)}
            ;;
        N)
            N=${OPTARG}
            NCNN_METHOD=${N}
            ;;
        o)
            o=${OPTARG}
            ;;
        O)
            O=${OPTARG}
            ;;
        s)  
            s=${OPTARG}
            SPLIT_PART_START="${s}"
            ;;
        Q)
            QUALITY_CHECK=yes
            ;;
        r)
            RESUME=yes
            ;;
        S)
            SILENT=yes
            ;;
        v)
            VERBOSE=yes
            ;;
        h)
            usage
            ;;
        :)
            printf 'Option -%s requires an argument.\n' "${OPTARG}" >&2
            exit 2
            ;;
        \?)
            printf 'Unknown option: -%s\n' "${OPTARG}" >&2
            exit 2
            ;;
  esac
done
shift $((OPTIND-1))

if [ ${CALLING} -eq 0 ]
then
  if [[ ${SILENT} == yes ]]
  then
    SILENT_ROOT="${o:-${HOME}/var}"
    if ! mkdir -p "${SILENT_ROOT}"
    then
      printf 'Unable to create silent-mode workspace: %s\n' "${SILENT_ROOT}" >&2
      exit 1
    fi
    SILENT_BOOT_LOG="${SILENT_ROOT}/.interpolation_nncn_silent_${BASHPID}_$(date "+%Y.%m.%d-%H.%M.%S").log" # .config (CURRENT_TIMESTAMP) is not loaded yet
    if ! exec >> "${SILENT_BOOT_LOG}" 2>&1
    then
      printf 'Unable to open silent-mode log: %s\n' "${SILENT_BOOT_LOG}" >&2
      exit 1
    fi
  fi

  source "${SCRIPTS_HOME}/.config"
  source "${SCRIPTS_HOME}/.var_management"
  if [[ ${SILENT} == yes ]]
  then
    SILENT_LOG="${LOG}/interpolation_nncn_silent_${CURRENT_TIMESTAMP}.log"
    if ! mv "${SILENT_BOOT_LOG}" "${SILENT_LOG}"
    then
      printf 'Unable to move silent-mode log to: %s\n' "${SILENT_LOG}" >&2
      exit 1
    fi
  fi
  echo -e "${DODGERBLUE1}${datestring} EXECUTE: ${YELLOW}[ ${LIME}$0 ${PARAMETERS} ${YELLOW} pid=${LIGHT_MAGENTA}${OWN_PID}]${RESET}"
fi

if [[ ${FILE_NAME} == */* ]]
then
  error "  -i expects a file name in the current directory, not a path (got: ${YELLOW}${FILE_NAME}${RED})"
  error "  run the script from the video's directory, e.g.: cd \"$(dirname -- "${FILE_NAME}")\" && $(basename -- "$0") -i \"$(basename -- "${FILE_NAME}")\""
  ERROR_CODE="2"
  failed
fi

if [ ! -s "${FILE_NAME}" ]
then
  error "  Interpolation without input video file ? how shall I approach it ? ;)"
  ERROR_CODE="2"
  failed
fi

if [ -z ${SPLIT_PART_START} ] || [[ ${SPLIT_PART_START} == "" ]]
then
  SPLIT_PART_START="001"
elif [[ ${SPLIT_PART_START} != [0-9][0-9][0-9] ]]
then
  error "  -s expects a three-digit chunk number, for example 003 (got: ${YELLOW}${SPLIT_PART_START}${RED})"
  ERROR_CODE="2"
  failed
fi

if [ -z ${NCNN_METHOD} ]
then
  NCNN_METHOD="rife"
fi

case "${NCNN_METHOD}" in
  rife|dain|cain|realsr)
    ;;
  *)
    error "  NCNN method ${YELLOW}${NCNN_METHOD}${RED} is not supported by this script (supported: rife, dain, cain, realsr)"
    ERROR_CODE="2"
    failed
    ;;
esac

if ! type "${NCNN_METHOD}-ncnn-vulkan" > /dev/null 2>&1
then
  ncnn-release-build "nihui/${NCNN_METHOD}-ncnn-vulkan"
fi

# also checks that the NCNN build above really produced the tool
for REQUIRED_COMMAND in ffmpeg ffprobe mkvmerge jq bc mediainfo "${NCNN_METHOD}-ncnn-vulkan"
do
  if ! type "${REQUIRED_COMMAND}" > /dev/null 2>&1
  then
    error "  required command not found: ${YELLOW}${REQUIRED_COMMAND}"
    ERROR_CODE="127"
    failed
  fi
done

TERMINAL_WIDTH=$(tput cols)
TERMINAL_HEIGHT=$(tput lines)
 
