#!/usr/bin/env bash

# ToDo and history: README.md, "Planned (in agreed order)" and "Early ToDo list"
# Documentation and helpers (links, GPU tuning, HDR/SDR, tone mapping, VMAF): see README.md, "Interpolation reference notes"

# Bash reads a running script from the file piece by piece, so editing it during a run (even indentation)
# made bash continue mid-line ("syntax error near unexpected token"). Inside { ... exit; } the whole
# script is read before anything runs, so it can be edited safely. The body is deliberately not indented.
{
# standard header (identical in every script; tests/run_tests.sh compares it): $0, not BASH_SOURCE,
# so a script sourced by another one keeps the caller's SCRIPTS_HOME (where .config is)
SCRIPT=$(readlink -f "$0")
SCRIPTS_HOME=$(dirname "${SCRIPT}")
export SCRIPT
export SCRIPTS_HOME
PARAMETERS=$(echo "$@" | sed 's/\-l .//g')
export EXECUTE_COMMAND="$0 ${PARAMETERS}"
# end of the standard header
# -S starts the same command again as a systemd service
ORIGINAL_ARGUMENTS=("$@")
OWN_PID=${BASHPID}

if [ "$(caller | awk '{print $1}')" -eq 0 ]
then
  CALLING=0
  # a service has no terminal to reset
  if [[ ${INTERPOLATION_NNCN_SERVICE} != yes ]]
  then
    reset
  fi
else
  CALLING=1
  if [[ ${VERBOSE} == yes ]]
  then
    debug "${YELLOW}[ ${LIME}$(echo "$(caller | awk '{print $2}')" | awk -F\/ '{print $NF}') ${YELLOW}calls (in line: ${LIME}$(caller | awk '{print $1}')${YELLOW}) ${LIME}$(echo "${BASH_SOURCE[*]}" | awk -F\/ '{print $NF}') ${PARAMETERS} ${YELLOW} ]"
  fi
fi


usage()
{
  # colours only on a terminal, so help piped to a file or the silent log stays plain text
  if [ -t 1 ] && [ -s "${SCRIPTS_HOME}/.config_colours" ]
  then
    source "${SCRIPTS_HOME}/.config_colours"
    BRIGHT=$(tput bold 2>/dev/null)
    NORMAL=$(tput sgr0 2>/dev/null)
    RESET="${NORMAL}"
  elif [ ! -t 1 ]
  then
    # colours may also come exported from the calling shell
    local CYAN="" BRIGHT="" WHITE="" NORMAL="" LIME="" DODGERBLUE1="" ORANGERED1="" DARKCYAN="" DEEPPINK1="" RESET=""
  fi
echo "
${CYAN}Usage:${BRIGHT}${WHITE}
$0 -i FILE [ -N ncnn ] [ -o var ] [ -O var_out ] [ -s XXX ] [ -F ] [ -T ] [ -k ] [ -Q ] [ -E [ -c codec ] [ -a | -g | -H ] ] [ -S [ -M size ] ] [ -v ] [ -h ]
$0 -R -i FILE [ -o var ] [ -v ]

    ${NORMAL}${CYAN}Description: processes a video with a neural network (NCNN/Vulkan) tool, in chunks of about 60 seconds:
            1. converts MP4 or a Blu-ray folder to MKV when needed, then splits it into chunks at keyframes starting
               a closed GOP (50-70 s), so no frame is lost at a split
               (a video of up to 90 seconds is not split: it is processed as one chunk, 001)
            2. tone-maps HDR to SDR when needed (unless -T)
            3. extracts audio/subtitle streams and video frames
            4. processes frames with the selected NCNN method
            5. merges frames back into video and re-attaches the streams
            6. optionally encodes the chunk with HandBrake (-E) and calculates VMAF (-Q),
               both in the background, alongside the next chunk; appends TMP/statistics.txt
            7. marks the chunk as finished:
                 video_part_minute_NNN_<method>_<fps>_merged.mkv.done
                 video_part_minute_NNN_<method>_<fps>_encoded.mkv.done (with -E)
               until its statistics row is written, it is also saved in
                 video_part_minute_NNN_<method>.statistics (a stopped run's next run writes it)
          Without -E it produces per-chunk merged files and does not join them; with -E it joins
          the encoded parts into DESTINATION_DIR/<input name>.mkv (default: /media/ready).
          Ctrl+C or an error also stops the background tools (NCNN, ffmpeg) started by this run.
          Ctrl+C then removes the unfinished parts and intermediate files (not with -k);
          finished chunks are kept, and the next run resumes them.
          Each run writes TMP/<input name>_report.xlsx (metrics, timeline, statistics, charts); when
          earlier runs of the same video are in the workspace (-o), it also writes the report of
          all of them together: VAR/<input name>_report.xlsx.

    ${LIME}-i${DODGERBLUE1}  input video (required; MP4 input is converted to MKV), or a Blu-ray folder (with BDMV/):
          its longest playlist is converted to <folder>.mkv first (mkvmerge: chapters, languages)
    ${LIME}-P${DODGERBLUE1}  with a Blu-ray folder: the playlist to convert instead of the longest, e.g. [-P 00800]
          (BDMV/PLAYLIST/00800.mpls; the run lists the longest playlists)
    ${LIME}-N${DODGERBLUE1}  NCNN/Vulkan method (default: ${CYAN}rife${DODGERBLUE1}); supported by this script:
                     ${ORANGERED1}rife        ${DARKCYAN}- Real-Time Intermediate Flow Estimation (frame interpolation)    ${DEEPPINK1}(https://github.com/nihui/rife-ncnn-vulkan)
                     ${ORANGERED1}dain        ${DARKCYAN}- Depth-Aware Video Frame Interpolation                           ${DEEPPINK1}(https://github.com/nihui/dain-ncnn-vulkan)
                     ${ORANGERED1}cain        ${DARKCYAN}- Channel Attention Frame Interpolation                           ${DEEPPINK1}(https://github.com/nihui/cain-ncnn-vulkan)
                     ${ORANGERED1}realsr      ${DARKCYAN}- superresolution (4x scale)                                      ${DEEPPINK1}(https://github.com/nihui/realsr-ncnn-vulkan)
                     ${ORANGERED1}none        ${DARKCYAN}- no NCNN processing: each source chunk is only encoded (needs -E); steps 2-5 are
                                   skipped, no GPU is used, an HDR video stays HDR (-T is not needed)
          ${DODGERBLUE1}not supported yet (frame calculations are not configured for them, so they are rejected):
                     ${ORANGERED1}ifrnet      ${DARKCYAN}- Intermediate Feature Refine Network (frame interpolation)       ${DEEPPINK1}(https://github.com/nihui/ifrnet-ncnn-vulkan)
                     ${ORANGERED1}Real-ESRGAN ${DARKCYAN}- image and video restoration                                     ${DEEPPINK1}(https://github.com/xinntao/Real-ESRGAN-ncnn-vulkan)
                     ${ORANGERED1}srmd        ${DARKCYAN}- superresolution                                                 ${DEEPPINK1}(https://github.com/nihui/srmd-ncnn-vulkan)
                     ${ORANGERED1}waifu2x     ${DARKCYAN}- superresolution and denoising                                   ${DEEPPINK1}(https://github.com/nihui/waifu2x-ncnn-vulkan)
                     ${ORANGERED1}realcugan   ${DARKCYAN}- superresolution + converter                                     ${DEEPPINK1}(https://github.com/nihui/realcugan-ncnn-vulkan)
                     ${ORANGERED1}zimage      ${DARKCYAN}- image generator                                                 ${DEEPPINK1}(https://github.com/nihui/zimage-ncnn-vulkan)
    ${LIME}-o${DODGERBLUE1}  workspace root for temporary files and logs
          (default directory is: ${CYAN}${HOME}/var${DODGERBLUE1}; TMP and LOG are created inside it for every run)
    ${LIME}-O${DODGERBLUE1}  separate root for extracted and processed frame data (performance of IOPs is crucial)
          (default: same as ${CYAN}-o${DODGERBLUE1})
    ${LIME}-s${DODGERBLUE1}  first three-digit chunk number to process, for example [-s 003] (default: ${CYAN}001${DODGERBLUE1})
    ${LIME}-F${DODGERBLUE1}  fresh start: by default a run resumes, it skips chunks already finished by an earlier
          run of the same movie and method in this directory; -F removes those results (with -s:
          from that chunk on) and processes the movie again
    ${LIME}-r${DODGERBLUE1}  resume (the default; still accepted, cannot be combined with -F)
    ${LIME}-T${DODGERBLUE1}  no tone mapping: an HDR video is processed as HDR, without conversion to SDR
          (colours of the processed frames may differ; a warning is shown)
    ${LIME}-k${DODGERBLUE1}  keep intermediate files of finished chunks (the frames-only video in -O and the
          chunk's frame directories); by default they are removed once the chunk is done
    ${LIME}-Q${DODGERBLUE1}  calculate VMAF (quality check) for each processed chunk (in the background, alongside the next chunk);
          with -E it measures the final encode of the chunk against the source chunk
    ${LIME}-E${DODGERBLUE1}  final encode: encodes each processed chunk with HandBrake (the movies_encoding settings), in the
          background, removes its merged part (kept with -k), and at the end joins the encoded parts
          into DESTINATION_DIR/<input name>.mkv; the crop is detected once, on the whole input
          a failed encode stops the run after the current chunk (run again with -E to continue)
    ${LIME}-c${DODGERBLUE1}  with -E: video encoder of the final encode (default: ${CYAN}av1${DODGERBLUE1}):
                     ${ORANGERED1}av1         ${DARKCYAN}- SVT-AV1 10-bit (HandBrake svt_av1_10bit)
                     ${ORANGERED1}x265        ${DARKCYAN}- x265 10-bit / HEVC (HandBrake x265_10bit)
          ${DODGERBLUE1}every part of one movie must have the same encoder: a part encoded with another one
          is done again
    ${LIME}-a${DODGERBLUE1}  with -E: animation encoding profile
    ${LIME}-g${DODGERBLUE1}  with -E: grain encoding profile
    ${LIME}-H${DODGERBLUE1}  with -E: high-motion encoding profile
    ${LIME}-S${DODGERBLUE1}  silent: runs in the background as a systemd service (system slice, as your user;
          needs root or sudo), so it survives closing the terminal or a logout; prints the unit
          name, its log (all output) and how to follow or stop it. systemctl stop runs the
          Ctrl+C cleanup. Without root or sudo it exits; run the script interactively then
    ${LIME}-M${DODGERBLUE1}  with -S: MemoryHigh of the service (e.g. 20G or 50%): above it the processes are
          slowed down (memory reclaimed) instead of being killed; no limit by default
    ${LIME}-R${DODGERBLUE1}  report only: writes VAR/<input name>_report.xlsx from all runs of the video in the
          workspace (-o) and does nothing else; the video itself is not needed anymore. A chunk
          processed in several runs comes from the latest run in which it is complete
    ${LIME}-v${DODGERBLUE1}  verbose diagnostics
    ${LIME}-h${DODGERBLUE1}  this help${RESET}
"
  exit 0
}

# exporting_video_report MOVIE_NAME MINIMUM_RUNS: writes VAR/<movie>_report.xlsx from all runs of
# the movie in VAR (metrics_to_excel.py chooses, per chunk, the latest run where it is complete),
# when there are at least MINIMUM_RUNS of them. A run is recognised by TMP/movie_name, runs from
# before it (17 Nov) by the movie's _report.xlsx or _video_packets.csv in their TMP. The Python
# environment must be ready (exporting_run_report or reporting_only prepare it).
exporting_video_report()
{
  local MOVIE_NAME="${1}"
  local MINIMUM_RUNS="${2}"
  local REPORT="${VAR}/${MOVIE_NAME}_report.xlsx"
  local RUN_DIR
  local RUN_OF_MOVIE
  local RUN_DIRS=()
  for RUN_DIR in "${VAR}/tmp-${SCRIPT_NAME}_"*
  do
    RUN_OF_MOVIE="no"
    if [ -s "${RUN_DIR}/movie_name" ]
    then
      if [[ "$(cat "${RUN_DIR}/movie_name")" == "${MOVIE_NAME}" ]]
      then
        RUN_OF_MOVIE="yes"
      fi
    elif [ -e "${RUN_DIR}/${MOVIE_NAME}_report.xlsx" ] || [ -e "${RUN_DIR}/${MOVIE_NAME}_video_packets.csv" ]
    then
      RUN_OF_MOVIE="yes"
    fi
    if [[ ${RUN_OF_MOVIE} == yes ]]
    then
      RUN_DIRS+=("${RUN_DIR}")
    fi
  done
  if [ "${#RUN_DIRS[@]}" -eq 0 ] || [ "${#RUN_DIRS[@]}" -lt "${MINIMUM_RUNS}" ]
  then
    return 1
  fi
  if "${SCRIPTS_HOME}/.venv/bin/python3" "${SCRIPTS_HOME}/metrics_to_excel.py" "${RUN_DIRS[@]}" "${REPORT}" > "${LOG}/metrics_to_excel_all_runs.log" 2>&1
  then
    inf "    report of all ${#RUN_DIRS[@]} runs of the video: ${YELLOW}${REPORT}"
  else
    warn "    no report of all runs: metrics_to_excel.py failed, see ${BLUE}${LOG}/metrics_to_excel_all_runs.log"
    return 1
  fi
  }

# the work directories created for a -R start (.var_management): removed again when they hold
# nothing but empty logs
removing_report_only_dirs()
{
  local REPORT_DIR
  find "${LOG}" -maxdepth 1 -type f -empty -delete 2>/dev/null
  for REPORT_DIR in "${TMP}" "${TMP_OUT}" "${LOG}" "${LOG_OUT}"
  do
    rmdir -- "${REPORT_DIR}" 2>/dev/null
  done
  }

# -R: only the report of all runs of the video (exporting_video_report), then exits
reporting_only()
{
  local MOVIE_NAME="${FILE_NAME}"
  local REPORT_STATUS="0"
  if [[ ${SILENT} == yes ]] || [[ ${QUALITY_CHECK} == yes ]] || [[ ${FINAL_ENCODING} == yes ]] || [[ ${FRESH_START} == yes ]] || [[ ${RESUME_OPTION} == yes ]] || [[ ${TONE_MAPPING} == no ]] || [[ ${KEEP_INTERMEDIATES} == yes ]] || [[ ${ANIMATION} == yes ]] || [[ ${GRAIN} == yes ]] || [[ ${HIGHMOTION} == yes ]] || [ -n "${N}" ] || [ -n "${O}" ] || [ -n "${s}" ] || [ -n "${MEMORY_HIGH}" ] || [ -n "${BLURAY_PLAYLIST}" ] || [ -n "${VIDEO_CODEC}" ]
  then
    error "  -R (report only) takes only -i, -o and -v"
    removing_report_only_dirs
    ERROR_CODE="2"
    failed
  fi
  if [ -z "${FILE_NAME}" ]
  then
    error "  -R needs -i: the video whose runs are reported"
    removing_report_only_dirs
    ERROR_CODE="2"
    failed
  fi
  case "${FILE_NAME}" in
    *.mkv|*.mp4)
      MOVIE_NAME="${FILE_NAME%.*}"
      ;;
  esac
  if ! python_venv_preparing "${SCRIPTS_HOME}/.venv" xlsxwriter
  then
    error "  the Python environment could not be prepared, see ${BLUE}${LOG}/python_venv_preparing.log"
    ERROR_CODE="1"
    failed
  fi
  if ! exporting_video_report "${MOVIE_NAME}" 1
  then
    if [ ! -s "${LOG}/metrics_to_excel_all_runs.log" ]
    then
      warn "  no run of ${YELLOW}${MOVIE_NAME}${WINE} in ${BLUE}${VAR}"
    fi
    REPORT_STATUS="1"
  fi
  removing_report_only_dirs
  exit "${REPORT_STATUS}"
  }

INTERPOLATION=no
SILENT=no
VERBOSE=no
QUALITY_CHECK=no
# finished chunks are skipped by default; -F starts the movie again from scratch
RESUME=yes
RESUME_OPTION=no
FRESH_START=no
TONE_MAPPING=yes
KEEP_INTERMEDIATES=no
FINAL_ENCODING=no
ANIMATION=no
GRAIN=no
HIGHMOTION=no
MEMORY_HIGH=""
REPORT_ONLY=no
BLURAY_PLAYLIST=""
VIDEO_CODEC=""
while getopts ":o:O:i:N:s:M:P:c:rFTkvShQEagHR" ARG
do
  case "${ARG}" in
        i)
            i=${OPTARG}
            # a Blu-ray folder may be given with a trailing slash (tab completion)
            FILE_NAME=${i%/}
            FILE_NAME_EXTENSION=${FILE_NAME: (-3)}
            ;;
        P)
            # the playlist of a Blu-ray folder: 00800 or 00800.mpls
            BLURAY_PLAYLIST=${OPTARG%.mpls}.mpls
            ;;
        N)
            N=${OPTARG}
            NCNN_METHOD=${N}
            ;;
        c)
            VIDEO_CODEC=${OPTARG}
            ;;
        o)
            o=${OPTARG}
            ;;
        O)
            O=${OPTARG}
            ;;
        s)  
            s=${OPTARG}
            SPLIT_PART_START="${s}"
            ;;
        Q)
            QUALITY_CHECK=yes
            ;;
        E)
            FINAL_ENCODING=yes
            ;;
        a)
            ANIMATION=yes
            ;;
        g)
            GRAIN=yes
            ;;
        H)
            HIGHMOTION=yes
            ;;
        r)
            # the default now; still accepted, so existing commands keep working
            RESUME=yes
            RESUME_OPTION=yes
            ;;
        F)
            FRESH_START=yes
            RESUME=no
            ;;
        T)
            TONE_MAPPING=no
            ;;
        k)
            KEEP_INTERMEDIATES=yes
            ;;
        S)
            SILENT=yes
            ;;
        M)
            MEMORY_HIGH=${OPTARG}
            ;;
        v)
            VERBOSE=yes
            ;;
        R)
            REPORT_ONLY=yes
            ;;
        h)
            usage
            ;;
        :)
            printf 'Option -%s requires an argument.\n' "${OPTARG}" >&2
            exit 2
            ;;
        \?)
            printf 'Unknown option: -%s\n' "${OPTARG}" >&2
            exit 2
            ;;
  esac
done
shift $((OPTIND-1))

if [ ${CALLING} -eq 0 ]
then
  # only the service itself writes to the silent log; the launcher (-S from a terminal) reports there
  if [[ ${SILENT} == yes ]] && [[ ${INTERPOLATION_NNCN_SERVICE} == yes ]]
  then
    SILENT_ROOT="${o:-${HOME}/var}"
    if ! mkdir -p "${SILENT_ROOT}"
    then
      printf 'Unable to create silent-mode workspace: %s\n' "${SILENT_ROOT}" >&2
      exit 1
    fi
    SILENT_BOOT_LOG="${SILENT_ROOT}/.interpolation_nncn_silent_${BASHPID}_$(date "+%Y.%m.%d-%H.%M.%S").log" # .config (CURRENT_TIMESTAMP) is not loaded yet
    if ! exec >> "${SILENT_BOOT_LOG}" 2>&1
    then
      printf 'Unable to open silent-mode log: %s\n' "${SILENT_BOOT_LOG}" >&2
      exit 1
    fi
  fi

  source "${SCRIPTS_HOME}/.config"
  source "${SCRIPTS_HOME}/.var_management"
  if [[ ${SILENT} == yes ]] && [[ ${INTERPOLATION_NNCN_SERVICE} == yes ]]
  then
    SILENT_LOG="${LOG}/interpolation_nncn_silent_${CURRENT_TIMESTAMP}.log"
    if ! mv "${SILENT_BOOT_LOG}" "${SILENT_LOG}"
    then
      printf 'Unable to move silent-mode log to: %s\n' "${SILENT_LOG}" >&2
      exit 1
    fi
  fi
  echo -e "${DODGERBLUE1}${datestring} EXECUTE: ${YELLOW}[ ${LIME}$0 ${PARAMETERS} ${YELLOW} pid=${LIGHT_MAGENTA}${OWN_PID}]${RESET}"
fi

if [[ ${FILE_NAME} == */* ]]
then
  error "  -i expects a file name in the current directory, not a path (got: ${YELLOW}${FILE_NAME}${RED})"
  error "  run the script from the video's directory, e.g.: cd \"$(dirname -- "${FILE_NAME}")\" && $(basename -- "$0") -i \"$(basename -- "${FILE_NAME}")\""
  ERROR_CODE="2"
  failed
fi

if [[ ${REPORT_ONLY} == yes ]]
then
  reporting_only
fi

if [ ! -s "${FILE_NAME}" ]
then
  error "  Interpolation without input video file ? how shall I approach it ? ;)"
  ERROR_CODE="2"
  failed
fi
if [ -d "${FILE_NAME}" ] && ! compgen -G "${FILE_NAME}/BDMV/PLAYLIST/*.mpls" > /dev/null
then
  error "  -i: ${YELLOW}${FILE_NAME}${RED} is a directory, but not a Blu-ray folder (no BDMV/PLAYLIST/*.mpls in it)"
  ERROR_CODE="2"
  failed
fi
if [ -n "${BLURAY_PLAYLIST}" ]
then
  if [ ! -d "${FILE_NAME}" ]
  then
    error "  -P (playlist) needs a Blu-ray folder as -i"
    ERROR_CODE="2"
    failed
  fi
  if [[ ! ${BLURAY_PLAYLIST} =~ ^[0-9]{5}\.mpls$ ]] || [ ! -f "${FILE_NAME}/BDMV/PLAYLIST/${BLURAY_PLAYLIST}" ]
  then
    error "  -P expects a playlist of ${YELLOW}${FILE_NAME}/BDMV/PLAYLIST${RED}, for example 00800 (got: ${YELLOW}${BLURAY_PLAYLIST%.mpls}${RED})"
    ERROR_CODE="2"
    failed
  fi
fi

if [ -z ${SPLIT_PART_START} ] || [[ ${SPLIT_PART_START} == "" ]]
then
  SPLIT_PART_START="001"
elif [[ ${SPLIT_PART_START} != [0-9][0-9][0-9] ]]
then
  error "  -s expects a three-digit chunk number, for example 003 (got: ${YELLOW}${SPLIT_PART_START}${RED})"
  ERROR_CODE="2"
  failed
fi

if [[ ${FRESH_START} == yes ]] && [[ ${RESUME_OPTION} == yes ]]
then
  error "  -F (start from scratch) and -r (resume) exclude each other"
  ERROR_CODE="2"
  failed
fi

if [ -n "${MEMORY_HIGH}" ]
then
  if [[ ${SILENT} != yes ]]
  then
    error "  -M sets the memory of the -S service, so it needs -S"
    ERROR_CODE="2"
    failed
  fi
  if ! [[ ${MEMORY_HIGH} =~ ^[0-9]+[KMGT]?$|^[0-9]+%$ ]]
  then
    error "  -M expects a size like 20G, 512M or a percentage like 50% (got: ${YELLOW}${MEMORY_HIGH}${RED})"
    ERROR_CODE="2"
    failed
  fi
fi

if [ -z ${NCNN_METHOD} ]
then
  NCNN_METHOD="rife"
fi

case "${NCNN_METHOD}" in
  rife|dain|cain|realsr|none)
    ;;
  *)
    error "  NCNN method ${YELLOW}${NCNN_METHOD}${RED} is not supported by this script (supported: rife, dain, cain, realsr, none)"
    ERROR_CODE="2"
    failed
    ;;
esac

if [[ ${NCNN_METHOD} == none ]]
then
  if [[ ${FINAL_ENCODING} != yes ]]
  then
    error "  -N none only encodes the chunks, so it needs -E"
    ERROR_CODE="2"
    failed
  fi
  if [[ ${TONE_MAPPING} == no ]]
  then
    error "  -T is for the NCNN processing; -N none does not tone-map, an HDR video stays HDR"
    ERROR_CODE="2"
    failed
  fi
  # nothing is tone-mapped: the source chunk goes to HandBrake as it is (also no libplacebo check)
  TONE_MAPPING=no
fi

if [ -n "${VIDEO_CODEC}" ] && [[ ${FINAL_ENCODING} != yes ]]
then
  error "  -c chooses the encoder of the final encode, so it needs -E"
  ERROR_CODE="2"
  failed
fi
VIDEO_CODEC="${VIDEO_CODEC:-av1}"
case "${VIDEO_CODEC}" in
  av1|x265)
    ;;
  *)
    error "  -c expects av1 or x265 (got: ${YELLOW}${VIDEO_CODEC}${RED})"
    ERROR_CODE="2"
    failed
    ;;
esac

if [[ ${FINAL_ENCODING} == no ]]
then
  if [[ ${ANIMATION} == yes ]] || [[ ${GRAIN} == yes ]] || [[ ${HIGHMOTION} == yes ]]
  then
    error "  -a, -g and -H choose the profile of the final encode, so they need -E"
    ERROR_CODE="2"
    failed
  fi
fi

REQUIRED_COMMANDS=(ffmpeg ffprobe mkvmerge jq bc mediainfo)
if [[ ${NCNN_METHOD} != none ]]
then
  if ! type "${NCNN_METHOD}-ncnn-vulkan" > /dev/null 2>&1
  then
    ncnn-release-build "nihui/${NCNN_METHOD}-ncnn-vulkan"
  fi
  # also checks that the NCNN build above really produced the tool
  REQUIRED_COMMANDS+=("${NCNN_METHOD}-ncnn-vulkan")
fi
if [[ ${FINAL_ENCODING} == yes ]]
then
  REQUIRED_COMMANDS+=(HandBrakeCLI)
fi
for REQUIRED_COMMAND in "${REQUIRED_COMMANDS[@]}"
do
  if ! type "${REQUIRED_COMMAND}" > /dev/null 2>&1
  then
    error "  required command not found: ${YELLOW}${REQUIRED_COMMAND}"
    ERROR_CODE="127"
    failed
  fi
done

# codec of the intermediate video (INTERMEDIATE_CODEC in .config_video), checked before any work
intermediate_codec_options
if [[ ! ${CHUNK_SUMMARY_PAUSE_SEC} =~ ^[0-9]+$ ]]
then
  error "  CHUNK_SUMMARY_PAUSE_SEC must be a whole number of seconds, not '${YELLOW}${CHUNK_SUMMARY_PAUSE_SEC}${RED}'"
  ERROR_CODE="2"
  failed
fi

# -S: the same command again as a transient systemd service in the system slice, run as the
# calling user. Only with root or sudo, by the user's choice: then the service has what the
# interactive run has (the user's groups for the GPU, PATH, HOME) and no fallbacks are needed.
# A system service survives closing the terminal or a logout, and is not in the user slice that
# systemd-oomd watches. It does not protect against the kernel OOM killer (no OOMScoreAdjust, by
# the user's choice); -M (MemoryHigh) throttles the processes before memory runs out.
# KillSignal=SIGINT: systemctl stop sends SIGINT to every process of the service, as Ctrl+C does
# to the terminal's process group, so exit_function runs the Ctrl+C cleanup. Not to the script
# only (KillMode=mixed): bash runs the trap only after its foreground tool (NCNN, ffmpeg) ends,
# which may take longer than TimeoutStopSec; whatever is left after it is killed.
# IgnoreSIGPIPE=no: systemd starts a service with SIGPIPE ignored, and bash cannot restore it, so
# every process of the run inherited it: "ffprobe -show_entries frame=... | head -n1" (the first
# frame's time) then got only write errors after head ended and decoded the whole chunk, ~85 s of
# each chunk's preparation alongside the encode (4K, 60 s; 0.3 s with SIGPIPE, as interactively).
# SELinux: systemd (init_t) may execute only files of executable types; a script in a repository
# has its directory's label (e.g. httpd_sys_content_t) and was refused ("Permission denied" at
# step EXEC). /usr/bin/env is bin_t, so the service runs as unconfined_service_t, the domain of
# any locally installed service, which may read the script: no policy change, no setenforce.
# Hardening (systemd-analyze security: 9.2 UNSAFE -> 0.6 SAFE, tested on a real run, 17 Nov): no
# network, no privileges, a read-only system except the run's directories, only the GPUs as
# devices. Left open on purpose: @resources (taskset, nice), the GPUs, /proc/stat and /proc/meminfo
# (metrics), AF_UNIX (user lookups through SSSD) and umask 022 (the movies are shared, as before).
# MemoryMax (SERVICE_MEMORY_MAX) is always set.
# Everything is checked before (above), so the launcher reports input errors at once instead of
# into the log.
starting_as_service()
{
  local SUDO_COMMAND=()
  if ! [[ ${SERVICE_MEMORY_MAX} =~ ^[0-9]+[KMGT]?$|^[0-9]+%$ ]]
  then
    error "  SERVICE_MEMORY_MAX expects a size like 40G or a percentage like 75% (got: ${YELLOW}${SERVICE_MEMORY_MAX}${RED})"
    ERROR_CODE="2"
    failed
  fi
  if ! type systemd-run > /dev/null 2>&1
  then
    error "  -S runs the script as a systemd service, but systemd-run was not found; run it interactively (without -S)"
    ERROR_CODE="127"
    failed
  fi
  if [ "$(id -u)" -ne 0 ]
  then
    if ! type sudo > /dev/null 2>&1
    then
      error "  -S needs root or sudo to start a system service, but sudo was not found; run it interactively (without -S)"
      ERROR_CODE="127"
      failed
    fi
    inf "  -S: starting a system service needs sudo (it may ask for your password)"
    if ! sudo -v
    then
      error "  -S needs root or sudo to start a system service; run it interactively (without -S)"
      ERROR_CODE="1"
      failed
    fi
    SUDO_COMMAND=(sudo)
  fi
  # a recognizable name: the movie and the run's timestamp (the same as in its log directory);
  # systemd allows only letters, digits and ":_.-\" in unit names
  local UNIT_MOVIE_NAME="${FILE_NAME%.*}"
  if [ -d "${FILE_NAME}" ]
  then
    UNIT_MOVIE_NAME="${FILE_NAME}"
  fi
  UNIT_MOVIE_NAME="$(printf '%s' "${UNIT_MOVIE_NAME}" | tr -c 'A-Za-z0-9_.-' '_' | tr -s '_')"
  local UNIT_NAME="interpolation-${UNIT_MOVIE_NAME:0:80}-${CURRENT_TIMESTAMP}"
  # the report's Python environment needs the network the first time (pip), which the service has not
  if ! python_venv_preparing "${SCRIPTS_HOME}/.venv" xlsxwriter
  then
    warn "  the Python environment for the run's report could not be prepared, the service will skip the report"
  fi
  local SERVICE_PROPERTIES=(-p KillSignal=SIGINT -p TimeoutStopSec=120 -p IgnoreSIGPIPE=no -p "MemoryMax=${SERVICE_MEMORY_MAX}")
  if [ -n "${MEMORY_HIGH}" ]
  then
    SERVICE_PROPERTIES+=(-p "MemoryHigh=${MEMORY_HIGH}")
  fi
  SERVICE_PROPERTIES+=(
    -p NoNewPrivileges=yes -p RestrictSUIDSGID=yes -p RemoveIPC=yes
    -p ProtectSystem=strict -p ProtectHome=read-only -p PrivateTmp=yes
    -p DevicePolicy=closed -p "DeviceAllow=char-drm rw"
    -p ProtectClock=yes -p ProtectKernelTunables=yes -p ProtectKernelModules=yes -p ProtectKernelLogs=yes
    -p ProtectControlGroups=yes -p ProtectHostname=yes -p ProtectProc=invisible
    -p RestrictNamespaces=yes -p LockPersonality=yes -p RestrictRealtime=yes -p MemoryDenyWriteExecute=yes
    -p SystemCallArchitectures=native -p SystemCallFilter=@system-service -p "SystemCallFilter=~@privileged"
    -p SystemCallErrorNumber=EPERM
    -p PrivateNetwork=yes -p IPAddressDeny=any -p RestrictAddressFamilies=AF_UNIX -p UMask=0022
  )
  # root without capabilities, or in its own user namespace, could not write into other users'
  # directories (e.g. the movie's), as a root run did before
  if [ "$(id -u)" -ne 0 ]
  then
    SERVICE_PROPERTIES+=(-p CapabilityBoundingSet= -p PrivateUsers=yes)
  fi
  # the only writable places: the working directory (chunks, parts), -o, -O, the destination of
  # -E and Mesa's shader cache; "-": a missing one is skipped. Quoted for spaces in names. Resolved:
  # systemd cannot set up a symlinked one (the default ~/var is a symlink on rig2: the unit failed
  # with "Failed to set up mount namespacing: Permission denied", exit 226).
  local WRITABLE_PATHS=("${PWD}" "${VAR}" "${VAR_OUT}" "${HOME}/.cache")
  if [[ ${FINAL_ENCODING} == yes ]]
  then
    # the same default as in handbrake_encode_settings (.config_video)
    WRITABLE_PATHS+=("${DESTINATION_DIR:-/media/ready}")
  fi
  local WRITABLE_PATH
  for WRITABLE_PATH in "${WRITABLE_PATHS[@]}"
  do
    WRITABLE_PATH="$(readlink -f -- "${WRITABLE_PATH}")"
    if [ -z "${WRITABLE_PATH}" ]
    then
      continue
    fi
    WRITABLE_PATH="${WRITABLE_PATH//\\/\\\\}"
    SERVICE_PROPERTIES+=(-p "ReadWritePaths=\"-${WRITABLE_PATH//\"/\\\"}\"")
  done
  # the service starts with a clean environment, so the settings read from it (set by the caller or
  # defaulted by .config_video) are passed on; without them they would silently fall back to defaults
  local SERVICE_ENVIRONMENT=(
    --setenv=INTERMEDIATE_CODEC="${INTERMEDIATE_CODEC}"
    --setenv=PNG_COMPRESSION_LEVEL="${PNG_COMPRESSION_LEVEL}"
    --setenv=NCNN_EXTRACTION_MARGIN="${NCNN_EXTRACTION_MARGIN}"
    --setenv=NCNN_GPUS="${NCNN_GPUS}"
    --setenv=NCNN_THREADS="${NCNN_THREADS}"
    --setenv=NCNN_FREE_CORES="${NCNN_FREE_CORES}"
    --setenv=GPU_PROBE_TIMEOUT_SEC="${GPU_PROBE_TIMEOUT_SEC}"
    --setenv=GPU_RETRY_AFTER_CHUNKS="${GPU_RETRY_AFTER_CHUNKS}"
    --setenv=GPU_RETRY_MAX_CHUNKS="${GPU_RETRY_MAX_CHUNKS}"
    --setenv=GPU_MAX_LOSSES="${GPU_MAX_LOSSES}"
    --setenv=RUN_MEMORY_PEAK_DEFAULT_GB="${RUN_MEMORY_PEAK_DEFAULT_GB}"
    --setenv=METRICS_INTERVAL_SEC="${METRICS_INTERVAL_SEC}"
  )
  if [ -n "${DESTINATION_DIR}" ]
  then
    SERVICE_ENVIRONMENT+=(--setenv=DESTINATION_DIR="${DESTINATION_DIR}")
  fi
  if ! "${SUDO_COMMAND[@]}" systemd-run --quiet --collect --unit="${UNIT_NAME}" \
    --description="interpolation_nncn: ${FILE_NAME}" \
    --uid="$(id -u)" --gid="$(id -g)" --working-directory="${PWD}" \
    "${SERVICE_PROPERTIES[@]}" \
    --setenv=PATH="${PATH}" --setenv=HOME="${HOME}" --setenv=USER="${USER}" \
    --setenv=LANG="${LANG:-C.UTF-8}" --setenv=TERM="${TERM:-xterm-256color}" \
    "${SERVICE_ENVIRONMENT[@]}" \
    --setenv=INTERPOLATION_NNCN_SERVICE=yes --setenv=SERVICE_RUN_TIMESTAMP="${CURRENT_TIMESTAMP}" \
    /usr/bin/env bash "${SCRIPT}" "${ORIGINAL_ARGUMENTS[@]}"
  then
    error "  starting the service ${YELLOW}${UNIT_NAME}${RED} failed (see the message of systemd-run above)"
    ERROR_CODE="1"
    failed
  fi
  local SUDO_PREFIX=""
  if [ ${#SUDO_COMMAND[@]} -gt 0 ]
  then
    SUDO_PREFIX="sudo "
  fi
  inf "  started as service: ${YELLOW}${UNIT_NAME}.service"
  inf "    log (all output):   ${BLUE}${LOG}/interpolation_nncn_silent_${CURRENT_TIMESTAMP}.log"
  inf "    follow:  ${LIME}tail -f '${LOG}/interpolation_nncn_silent_${CURRENT_TIMESTAMP}.log'"
  inf "    status:  ${LIME}systemctl status '${UNIT_NAME}'"
  inf "    stop:    ${LIME}${SUDO_PREFIX}systemctl stop '${UNIT_NAME}'${CYAN} (runs the Ctrl+C cleanup, finished chunks are kept)"
  inf "    list:    ${LIME}systemctl list-units 'interpolation-*'"
  exit 0
  }

if [[ ${SILENT} == yes ]] && [[ ${INTERPOLATION_NNCN_SERVICE} != yes ]]
then
  starting_as_service
fi

