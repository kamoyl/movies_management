  fi
  mkvmerge -o "video_part_minute_001.mkv" "${WHOLE_MOVIE_NAME_ARRAY[*]}.mkv" > "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" 2>&1
  mkvtoolnix_status "$?" "copying the video into one chunk" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log"
  LAST_VIDEO_FRAGMENT_ID="001"
  SPLITTING_DONE="yes"
else
  WHOLE_VIDEO_IN_ONE_CHUNK="no"
