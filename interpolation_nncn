fi

  echo "video_id~extracting_streams_runtime~extracting_frames_runtime~interpolating_runtime~merging_streams_runtime~merging_frames_runtime~encoding_runtime~quality_check_runtime~max_space [GB]~max_space [%]~VMAF [mean]~runtime" > "${TMP}/statistics.txt"
  for VIDEO_FRAGMENT_ID in $(seq -w ${SPLIT_PART_START} ${LAST_VIDEO_FRAGMENT_ID})
  do
    start_time_collecting
    START_TIME_FRAGMENT_ID=${START_TIME}
    IN_DIR="in_${VIDEO_FRAGMENT_ID}"
    OUT_DIR="out_${VIDEO_FRAGMENT_ID}"
    export IN_DIR
    export OUT_DIR
    if [[ ${RESUME} == yes ]]
    then
      # the .done marker is written only after a chunk fully succeeded, so a half-written
      # _merged.mkv from an interrupted run is never mistaken for a finished one
      # shellcheck disable=SC2206 # the unquoted * is intentional: the glob finds the marker whatever the fps
      if [[ ${WHOLE_VIDEO_IN_ONE_CHUNK} == yes ]]
      then
        # results of an unsplit video were already renamed to the input name
        # shellcheck disable=SC2206
        FINISHED_CHUNK_MARKERS=("${WHOLE_MOVIE_NAME_ARRAY[*]}"_${NCNN_METHOD}_*_merged.mkv.done)
      else
        # shellcheck disable=SC2206
        FINISHED_CHUNK_MARKERS=(video_part_minute_${VIDEO_FRAGMENT_ID}_${NCNN_METHOD}_*_merged.mkv.done)
      fi
      if [[ ${FINAL_ENCODING} == yes ]]
      then
        # with -E a chunk is fully finished when its final encode is; its merged part may be removed
        # shellcheck disable=SC2206
        FINISHED_ENCODED_MARKERS=(video_part_minute_${VIDEO_FRAGMENT_ID}_${NCNN_METHOD}_*_encoded.mkv.done)
        if [ -e "${FINISHED_ENCODED_MARKERS[0]}" ] && [ -s "${FINISHED_ENCODED_MARKERS[0]%.done}" ] && [[ "$(cat "${FINISHED_ENCODED_MARKERS[0]}")" == "${WHOLE_MOVIE_NAME_ARRAY[*]}" ]]
        then
          inf "  chunk ${YELLOW}${VIDEO_FRAGMENT_ID}${CYAN} already finished and encoded (${FINISHED_ENCODED_MARKERS[0]%.done}), skipping"
          rm -f -- "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
          continue
        fi
      fi
      if [ -e "${FINISHED_CHUNK_MARKERS[0]}" ] && [ -s "${FINISHED_CHUNK_MARKERS[0]%.done}" ] && [[ "$(cat "${FINISHED_CHUNK_MARKERS[0]}")" == "${WHOLE_MOVIE_NAME_ARRAY[*]}" ]]
      then
        if [[ ${FINAL_ENCODING} == yes ]]
        then
          # processed earlier, but not encoded yet (an earlier run without -E, or a failed encode):
          # only the final encode is started, without VMAF (the chunk's frame data is not analysed)
          inf "  chunk ${YELLOW}${VIDEO_FRAGMENT_ID}${CYAN} already finished (${FINISHED_CHUNK_MARKERS[0]%.done}), only its final encode is started"
          finishing_previous_chunk
          RESUMED_MERGED_FILE="${FINISHED_CHUNK_MARKERS[0]%.done}"
          # <fps>_merged.mkv, also for an unsplit video whose results got the input name
          RESUMED_MERGED_SUFFIX="${RESUMED_MERGED_FILE##*_${NCNN_METHOD}_}"
          starting_part_encoding "${RESUMED_MERGED_FILE}" "video_part_minute_${VIDEO_FRAGMENT_ID}_${NCNN_METHOD}_${RESUMED_MERGED_SUFFIX%_merged.mkv}_encoded.mkv" ""
          PENDING_CHUNK_ID="${VIDEO_FRAGMENT_ID}"
          PENDING_STATISTICS_ROW="no"
        else
          inf "  chunk ${YELLOW}${VIDEO_FRAGMENT_ID}${CYAN} already finished (${FINISHED_CHUNK_MARKERS[0]%.done}), skipping"
          rm -f -- "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
        fi
        continue
      fi
    fi
    CURRENTLY_MANAGED_VIDEO_PART_PATH=$(grep "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" | grep ${VIDEO_FRAGMENT_ID} | awk '{print $3}' | sed "s/'//g")
    CURRENTLY_MANAGED_VIDEO_PART_FILENAME=$(echo ${CURRENTLY_MANAGED_VIDEO_PART_PATH} | awk -F\/ '{print $NF}')
    if [ -z "${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}" ] || [ ! -s "${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}" ]
    then
      error "  chunk ${YELLOW}${VIDEO_FRAGMENT_ID}${RED} not found (expected: video_part_minute_${VIDEO_FRAGMENT_ID}.mkv)"
      ERROR_CODE="1"
      failed
    fi
    FILE_NAME="${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}"
    FILE_NAME_EXTENSION=${FILE_NAME: (-3)}
    MOVIE_NAME_ARRAY=("${CURRENTLY_MANAGED_VIDEO_PART_FILENAME%.mkv}")
    NEXT_MANAGED_VIDEO_PART_PATH=$(grep "has been opened for writing" "${LOG}/${WHOLE_MOVIE_NAME_ARRAY[*]}_splitting_video.log" | grep -A1 "${CURRENTLY_MANAGED_VIDEO_PART_PATH}" | tail -n1 | awk '{print $3}' | sed "s/'//g")
    NEXT_MANAGED_VIDEO_PART_FILENAME=$(echo ${NEXT_MANAGED_VIDEO_PART_PATH} | awk -F\/ '{print $NF}')
    if [[ ${VIDEO_FRAGMENT_ID} == "001" ]]
    then
      FIRST_VIDEO_PART="${CURRENTLY_MANAGED_VIDEO_PART_PATH}"
    elif [[ ${VIDEO_FRAGMENT_ID} == "${LAST_VIDEO_FRAGMENT_ID}" ]]
    then
      LAST_VIDEO_PART="${CURRENTLY_MANAGED_VIDEO_PART_PATH}"
      NEXT_MANAGED_VIDEO_PART_PATH=""
    fi 
    # checks every step itself (including NCNN failures) and stops the run on error
    interpolation_video_file "${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}"

    # the previous chunk's VMAF ran alongside this chunk; its row is written first, so the rows
    # stay in chunk order and only one VMAF runs at a time
    finishing_previous_chunk

    printf "\033[%d;0H\033[2K ${WHITE}finishing: %s\n" "$((TERMINAL_HEIGHT - 12))" "                       DONE: ${CURRENTLY_MANAGED_VIDEO_PART_FILENAME}" 2>/dev/null
    # reaching this line means interpolation_video_file already required the _merged.mkv, so the
    # chunk is finished; VMAF only measures it (an interrupted VMAF loses only its score)
    # chunk names are the same for every movie, so the marker remembers which movie it belongs to
    printf '%s\n' "${WHOLE_MOVIE_NAME_ARRAY[*]}" > "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv.done"
    # the chunk is done, so its intermediate files are not needed anymore (kept with -k); the
    # frames-only video in TMP_OUT is a full copy of the video track of _merged.mkv
    if [[ ${KEEP_INTERMEDIATES} == no ]]
    then
      rm -f -- "${TMP_OUT}/${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}.mkv"
      # frame directories: input frames are in TMP_OUT, processed frames in TMP
      rm -rf -- "${TMP_OUT:?}/${IN_DIR:?}" "${TMP_OUT:?}/${OUT_DIR:?}" "${TMP:?}/${IN_DIR:?}" "${TMP:?}/${OUT_DIR:?}"
    fi
    
    START_TIME=${START_TIME_FRAGMENT_ID}
    end_time_collecting
    PART_VIDEO_RUNTIME=${RUNTIME}
    inf "    following video management took: ${DARKCYAN}${PART_VIDEO_RUNTIME}"
    inf "      extracting"
    if [ -s "${TMP}/EXTRACTING_STREAMS_RUNTIME" ]
    then
      EXTRACTING_STREAMS_RUNTIME=$(cat "${TMP}/EXTRACTING_STREAMS_RUNTIME")
      inf "        streams took: ${DARKCYAN}${EXTRACTING_STREAMS_RUNTIME}"
    fi
    if [ -s "${TMP}/EXTRACTING_FRAMES_RUNTIME" ]
    then
      EXTRACTING_FRAMES_RUNTIME=$(cat "${TMP}/EXTRACTING_FRAMES_RUNTIME")
      inf "        frames  took: ${DARKCYAN}${EXTRACTING_FRAMES_RUNTIME}"
    fi
    if [ -s "${TMP}/INTERPOLATING_FRAMES_RUNTIME" ]
    then
      INTERPOLATING_FRAMES_RUNTIME=$(cat "${TMP}/INTERPOLATING_FRAMES_RUNTIME")
      inf "    interpolation done after ${DARKCYAN}${INTERPOLATING_FRAMES_RUNTIME}"
    fi
    inf "      merging"
    if [ -s "${TMP}/MERGING_STREAMS_RUNTIME" ]
    then
      MERGING_STREAMS_RUNTIME=$(cat "${TMP}/MERGING_STREAMS_RUNTIME")
      inf "        streams took: ${DARKCYAN}${MERGING_STREAMS_RUNTIME}"
    fi
    if [ -s "${TMP}/MERGING_FRAMES_RUNTIME" ]
    then
      MERGING_FRAMES_RUNTIME=$(cat "${TMP}/MERGING_FRAMES_RUNTIME")
      inf "        frames  took: ${DARKCYAN}${MERGING_FRAMES_RUNTIME}"
    fi
    if [ -s "${TMP}/MAX_SPACE_TAKEN_OVERALL" ]
    then
      MAX_SPACE_TAKEN_OVERALL="$(cat "${TMP}/MAX_SPACE_TAKEN_OVERALL")"
      if [[ ${MAX_SPACE_TAKEN_OVERALL} == "" ]] || [ ${MAX_SPACE_TAKEN_OVERALL} -eq 0 ] || [ -z ${MAX_SPACE_TAKEN_OVERALL} ]
      then
        MAX_SPACE_TAKEN_OVERALL="1"
      fi
      MAX_SPACE_TAKEN_PERCENT=$(printf "%.0f\n" "$(echo "(${MAX_SPACE_TAKEN_OVERALL}/${MAX_TSPACE})*100" | bc -l)")
      inf "    space used all together: ${DARKCYAN}${MAX_SPACE_TAKEN_OVERALL} [GB] ${CYAN}(which is only ${MAROON1}${MAX_SPACE_TAKEN_PERCENT} [%]${CYAN} of space which should be taken if not removed on-the-fly)"
    fi
    # the statistics row is written by finishing_previous_chunk, once VMAF of this chunk is known
    PENDING_CHUNK_ID="${VIDEO_FRAGMENT_ID}"
    PENDING_STATISTICS_BEFORE_VMAF="${VIDEO_FRAGMENT_ID}~${EXTRACTING_STREAMS_RUNTIME}~${EXTRACTING_FRAMES_RUNTIME}~${INTERPOLATING_FRAMES_RUNTIME}~${MERGING_STREAMS_RUNTIME}~${MERGING_FRAMES_RUNTIME}"
    PENDING_STATISTICS_SPACE="${MAX_SPACE_TAKEN_OVERALL}~${MAX_SPACE_TAKEN_PERCENT}"
    PENDING_PART_RUNTIME="${PART_VIDEO_RUNTIME}"
    PENDING_STATISTICS_ROW="yes"
    if [[ ${FINAL_ENCODING} == "yes" ]]
    then
      # with -Q the final encode is compared with the original chunk, right after the encode
      if [[ ${QUALITY_CHECK} == "yes" ]]
      then
        PART_VMAF_REFERENCE="video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
      else
        PART_VMAF_REFERENCE=""
      fi
      starting_part_encoding "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv" "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_encoded.mkv" "${PART_VMAF_REFERENCE}"
      inf "    final encoding started in the background, it runs alongside the next chunk"
    elif [[ ${QUALITY_CHECK} == "yes" ]]
    then
      # processed chunk = distorted (first), original chunk = reference (second)
      starting_quality_metric "${MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv" "video_part_minute_${VIDEO_FRAGMENT_ID}.mkv"
      inf "    VMAF check started in the background, it runs alongside the next chunk"
    else
      finishing_previous_chunk
    fi
    # after the last chunk the screen stays as it is, so the summary remains visible
    if [[ ${VIDEO_FRAGMENT_ID} != "${LAST_VIDEO_FRAGMENT_ID}" ]]
    then
      sleep 10
      # -x clears only the visible screen and keeps the scrollback
      clear -x
    fi
  done
#fi
# the final encode and VMAF of the last chunk have no next chunk to run alongside, so they are waited for here
finishing_previous_chunk

# an unsplit video was processed as chunk 001: its results get the input name
if [[ ${WHOLE_VIDEO_IN_ONE_CHUNK} == yes ]] && [ -e "video_part_minute_001_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv.done" ]
then
  RESULT_SUFFIXES=("_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv" "_${NCNN_METHOD}_${OUTPUT_FPS_ROUND}_merged.mkv.done")
  for RESULT_SUFFIX in "${RESULT_SUFFIXES[@]}"
  do
    if [ -e "video_part_minute_001${RESULT_SUFFIX}" ]
    then
      mv -f -- "video_part_minute_001${RESULT_SUFFIX}" "${WHOLE_MOVIE_NAME_ARRAY[*]}${RESULT_SUFFIX}"
      inf "  result: ${YELLOW}${WHOLE_MOVIE_NAME_ARRAY[*]}${RESULT_SUFFIX}"
    fi
  done
fi

if [[ ${FINAL_ENCODING} == yes ]]
then
  joining_encoded_parts
fi

# for VIDEO_FRAGMENT_ID in $(seq -w ${SPLIT_PART_START} ${LAST_VIDEO_FRAGMENT_ID})
# do
# mkvmerge --append-mode track -o "${WHOLE_MOVIE_NAME_ARRAY[*]}_${NCNN_METHOD}_merge_${SPLIT_PART_START}-${LAST_VIDEO_FRAGMENT_ID}.mkv" $(ls --color=never video_part_minute_*_merged.mkv | sed "s/^/+/g" | tr "\n" " " | sed "s/^+//g")
# ERROR_CODE
# ... rm -rf video_part_minute_[0-9][0-9][0-9].mkv

START_TIME=${START_TIME_WHOLE}
end_time_collecting
inf "    video mngt took : ${DARKCYAN}${RUNTIME}"

printf "\033[%d;0H\033[2K %s\n" "${TERMINAL_HEIGHT}" "${TEAL}DONE"
trap SIGINT
tput cnorm
