#!/usr/bin/env bash

ORIGIFS=${IFS}
NEWIFS=$'\n'
VERBOSE=no

LIME_YELLOW=$(tput setaf 190)
POWDER_BLUE=$(tput setaf 153)
BRIGHT=$(tput bold)
NORMAL=$(tput sgr0)
BLINK=$(tput blink)
REVERSE=$(tput smso)
UNDERLINE=$(tput smul)
RESET=$(tput sgr0)

WINE=$(echo -e "\x1b[38;2;191;000;000m")
DARK_GREEN=$(echo -e "\x1b[38;2;50;200;100m")
LIGHT_BLUE=$(echo -e "\x1b[38;2;50;250;240m")
LIGHT_YELLOW=$(echo -e "\x1b[38;2;250;250;0m")
LIGHT_MAGENTA=$(echo -e "\x1b[38;2;240;200;240m")
DARK_MAGENTA=$(echo -e "\x1b[38;2;75;66;144m")
DARK_CYAN=$(echo -e "\x1b[38;2;0;139;139m")

if [[ "${OSTYPE}" =~ "linux" ]]
then
  SCRIPT=$(readlink -f "$0")
elif [[ "${OSTYPE}" =~ "darwin" ]]
then
  SCRIPT=$(greadlink -f "$0")
else
  SCRIPT=$(readlink -f "$0")
fi

SCRIPTS_HOME=$(dirname "${SCRIPT}")
PARAMETERS=$(echo "$@" | sed 's/\-l .//g')

usage()
{
  # colours only on a terminal, so help piped to a file stays plain text
  if [ -t 1 ] && [ -s "${SCRIPTS_HOME}/.config_colours" ]
  then
    source "${SCRIPTS_HOME}/.config_colours"
    BRIGHT=$(tput bold 2>/dev/null)
    NORMAL=$(tput sgr0 2>/dev/null)
    RESET="${NORMAL}"
  elif [ ! -t 1 ]
  then
    # colours may also come exported from the calling shell
    local CYAN="" BRIGHT="" WHITE="" NORMAL="" LIME="" DODGERBLUE1="" ORANGERED1="" DARKCYAN="" DEEPPINK1="" RESET=""
  fi
echo "
${CYAN}Usage:${BRIGHT}${WHITE}
$0 -i FILE [ -I imdb_id ] [ -o var ] [ -a ] [ -g ] [ -H ] [ -u ] [ -e ] [ -v ] [ -h ]

    ${NORMAL}${CYAN}Description: collects movie metadata (local file, OMDb, TheMovieDB), optionally updates the MKV
          and its related files, and optionally starts a HandBrake encode.
          Quality analysis is not available in this version.

    ${LIME}-i${DODGERBLUE1}  input video file (normally MKV)
    ${LIME}-I${DODGERBLUE1}  IMDb ID (tt...) or TheMovieDB ID
    ${LIME}-o${DODGERBLUE1}  workspace root for temporary files and logs
          (default directory is: ${CYAN}${HOME}/var${DODGERBLUE1}; TMP and LOG are created inside it for every run)
    ${LIME}-a${DODGERBLUE1}  use the animation encoding profile
    ${LIME}-g${DODGERBLUE1}  use the grain encoding profile
    ${LIME}-H${DODGERBLUE1}  use the high-motion encoding profile
    ${LIME}-u${DODGERBLUE1}  update MKV metadata and related file attributes
    ${LIME}-e${DODGERBLUE1}  start the configured HandBrake encode in the background
    ${LIME}-v${DODGERBLUE1}  verbose diagnostics
    ${LIME}-h${DODGERBLUE1}  this help${RESET}
"
  exit 0
}

if [ "$(caller | awk '{print $1}')" -eq 0 ]
then
  CALLING=0
  echo -e "${BLUE}${datestring} EXECUTE: ${YELLOW}[ ${LIME}$0 ${PARAMETERS} ${YELLOW} ]${RESET}"
  source "${SCRIPTS_HOME}/.config"
else
  CALLING=1
  if [[ ${VERBOSE} == yes ]]
  then
    debug "${YELLOW}[ ${LIME}$(echo $(caller | awk '{print $2}') | awk -F\/ '{print $NF}') ${YELLOW}calls (in line: ${LIME}$(caller | awk '{print $1}')${YELLOW}) ${LIME}$(echo "${BASH_SOURCE[0]}" | awk -F\/ '{print $NF}') ${PARAMETERS} ${YELLOW} ]"
  fi
fi

ANIMATION=no
GRAIN=no
ENCODING=no
UPDATE=no
HIGHMOTION=no
while getopts ":I:i:o:Haguvhe" ARG
do
  case "${ARG}" in
        a)
            ANIMATION=yes
            ;;
        g)
            GRAIN=yes
            ;;
        H)
            HIGHMOTION=yes
            ;;
        e)  ENCODING=yes
            ;;
        u)
            UPDATE=yes
            ;;
        i)
            i=${OPTARG}
            FILE_NAME=${i}
            ;;
        I)
            I=${OPTARG}
            if [[ ${I} == tt* ]]
            then
              IMDB_ID_PROVIDED=${I}
            else
              THEMOVIEDB_ID_PROVIDED=${I}
            fi
            ;;
        o)
            o=${OPTARG}
            ;;
        v)
            VERBOSE=yes
            ;;
        h)
            usage
            ;;
        :)
            printf 'Option -%s requires an argument.\n' "${OPTARG}" >&2
            exit 2
            ;;
        \?)
            printf 'Unknown option: -%s\n' "${OPTARG}" >&2
            exit 2
            ;;
  esac
done
shift $((OPTIND-1))

if [[ ${CALLING} -eq 0 ]]
then
  source "${SCRIPTS_HOME}/.var_management"
fi

if [[ ${FILE_NAME} == */* ]]
then
  error "  -i expects a file name in the current directory, not a path (got: ${YELLOW}${FILE_NAME}${RED})"
  error "  run the script from the video's directory, e.g.: cd \"$(dirname -- "${FILE_NAME}")\" && $(basename -- "$0") -i \"$(basename -- "${FILE_NAME}")\""
  ERROR_CODE="2"
  failed
fi

if [[ ! -s ${FILE_NAME} ]]
then
  error " it looks like there is no such video file: ${ORANGE}${FILE_NAME}"
  ERROR_CODE="2"
  failed
else
  if [[ ${VERBOSE} == yes ]]
  then
    debug "  FILE_NAME          = ${FILE_NAME}"
  fi
  MOVIE_NAME_ARRAY=("${FILE_NAME%.mkv}")
  MOVIE_NAME="${MOVIE_NAME_ARRAY[*]}"
  MOVIE_NAME_URL_ENC=$(jq -rn --arg movie_name_array "${MOVIE_NAME}" '$movie_name_array|@uri')
  MOVIE_METADATA_FILENAME="${MOVIE_NAME}_metadata"
  MOVIE_METADATA_FILENAME_LOCAL="${MOVIE_METADATA_FILENAME}_local"
  MOVIE_METADATA_FILENAME_IMDB="${MOVIE_METADATA_FILENAME}_imdb_api"
  MOVIE_METADATA_FILENAME_THEMOVIEDB="${MOVIE_METADATA_FILENAME}_themoviedb_api"
fi

start_time_collecting

REQUIRED_COMMANDS=(curl mkvmerge ffprobe jq convert wget mediainfo mkvpropedit)
if [[ ${ENCODING} == yes ]]
then
  REQUIRED_COMMANDS+=(HandBrakeCLI)
fi
for REQUIRED_COMMAND in "${REQUIRED_COMMANDS[@]}"
do
  if ! type "${REQUIRED_COMMAND}" > /dev/null 2>&1
  then
    error "  required command not found: ${YELLOW}${REQUIRED_COMMAND}"
    ERROR_CODE="127"
    failed
  fi
done

