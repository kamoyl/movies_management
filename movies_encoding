#!/usr/bin/env bash

ORIGIFS=${IFS}
NEWIFS=$'\n'
VERBOSE=no

LIME_YELLOW=$(tput setaf 190)
POWDER_BLUE=$(tput setaf 153)
BRIGHT=$(tput bold)
NORMAL=$(tput sgr0)
BLINK=$(tput blink)
REVERSE=$(tput smso)
UNDERLINE=$(tput smul)
RESET=$(tput sgr0)

WINE=$(echo -e "\x1b[38;2;191;000;000m")
DARK_GREEN=$(echo -e "\x1b[38;2;50;200;100m")
LIGHT_BLUE=$(echo -e "\x1b[38;2;50;250;240m")
LIGHT_YELLOW=$(echo -e "\x1b[38;2;250;250;0m")
LIGHT_MAGENTA=$(echo -e "\x1b[38;2;240;200;240m")
DARK_MAGENTA=$(echo -e "\x1b[38;2;75;66;144m")
DARK_CYAN=$(echo -e "\x1b[38;2;0;139;139m")

if [[ "${OSTYPE}" =~ "linux" ]]
then
  SCRIPT=$(readlink -f "$0")
elif [[ "${OSTYPE}" =~ "darwin" ]]
then
  SCRIPT=$(greadlink -f "$0")
else
  SCRIPT=$(readlink -f "$0")
fi

SCRIPTS_HOME=$(dirname "${SCRIPT}")
PARAMETERS=$(echo "$@" | sed 's/\-l .//g')

if [ $(caller | awk '{print $1}') -eq 0 ]
then
  CALLING=0
  echo -e "${BLUE}${datestring} EXECUTE: ${YELLOW}[ ${LIME}$0 ${PARAMETERS} ${YELLOW} ]${RESET}"
  source "${SCRIPTS_HOME}/.config"
  source "${SCRIPTS_HOME}/.var_management"
else
  CALLING=1
  if [[ ${VERBOSE} == yes ]]
  then
    debug "${YELLOW}[ ${LIME}$(echo $(caller | awk '{print $2}') | awk -F\/ '{print $NF}') ${YELLOW}calls (in line: ${LIME}$(caller | awk '{print $1}')${YELLOW}) ${LIME}$(echo ${BASH_SOURCE} | awk -F\/ '{print $NF}') ${PARAMETERS} ${YELLOW} ]"
  fi
fi

ANIMATION=no
GRAIN=no
ENCODING=no
UPDATE=no
QUALITY=no
HIGHMOTION=no
while getopts ":I:i:o:qHaguvhe" ARG
do
  case "${ARG}" in
        a)
            ANIMATION=yes
            ;;
        g)
            GRAIN=yes
            ;;
        H)
            HIGHMOTION=yes
            ;;
        e)  ENCODING=yes
            ;;
        u)
            UPDATE=yes
            ;;
        q)
            QUALITY=yes
            ;;
        i)
            i=${OPTARG}
            FILE_NAME=${i}
            ;;
        I)
            I=${OPTARG}
            if [[ ${I} == tt* ]]
            then
              IMDB_ID_PROVIDED=${I}
            else
              THEMOVIEDB_ID_PROVIDED=${I}
            fi
            ;;
        o)
            o=${OPTARG}
            ;;
        v)
            VERBOSE=yes
            ;;
        h)
            usage
            ;;
  esac
done
shift $((OPTIND-1))

if [[ ! -s ${FILE_NAME} ]]
then
  error " it looks like there is no such video file: ${ORANGE}${FILE_NAME}"
  failed
else
  if [[ ${VERBOSE} == yes ]]
  then
    debug "  FILE_NAME          = ${FILE_NAME}"
  fi
  MOVIE_NAME_ARRAY=(${FILE_NAME/\.mkv})
  MOVIE_NAME=$(echo ${MOVIE_NAME_ARRAY[*]} | awk -F\/ '{print $NF}')
  MOVIE_NAME_URL_ENC=$(jq -rn --arg movie_name_array "${MOVIE_NAME}" '$movie_name_array|@uri')
  MOVIE_METADATA_FILENAME="${MOVIE_NAME}_metadata"
  MOVIE_METADATA_FILENAME_LOCAL="${MOVIE_METADATA_FILENAME}_local"
  MOVIE_METADATA_FILENAME_IMDB="${MOVIE_METADATA_FILENAME}_imdb_api"
  MOVIE_METADATA_FILENAME_THEMOVIEDB="${MOVIE_METADATA_FILENAME}_themoviedb_api"
fi

start_time_collecting

if ! type curl > /dev/null 2>&1
then
  warn "curl is needed to this script work properly, exiting"
  failed
fi

if ! type mkvmerge > /dev/null 2>&1
then
  warn "mkvmerge is needed to this script work properly, exiting"
  failed
fi

if ! type ffprobe > /dev/null 2>&1
then
  warn "ffprobe is needed to this script work properly, exiting"
  failed
fi

if ! type jq > /dev/null 2>&1
then
  warn "jq is needed to this script work properly, exiting"
  failed
fi
if ! type convert > /dev/null 2>&1
then
  warn "convert is needed to this script work properly, exiting"
  failed
fi
if ! type wget > /dev/null 2>&1
then
  warn "wget is needed to this script work properly, exiting"
  failed
fi

