  IFS=${NEWIFS}
  for OMDB_API_RATING in $(jq -r '.Ratings[] | .Source + "~" + .Value' "${TMP}/${MOVIE_METADATA_FILENAME_OMDB}.json")
  do
    OMDB_API_RATING_SOURCE=$(echo ${OMDB_API_RATING} | awk -F\~ '{print $1}')
    OMDB_API_RATING_RATING=$(echo ${OMDB_API_RATING} | awk -F\~ '{print $2}')
    debug "      ${OMDB_API_RATING_SOURCE}: ${OMDB_API_RATING_RATING}"
  done # -> it may be a lot here
  IFS=${ORIGIFS}



